---
import cntl from "cntl";

interface SectionHead {
  text: string;
  // Heading level; sections nested under a page subtitle use 3.
  level?: 2 | 3;
}

const sectionHeadClasses = cntl`
  text-xl
  font-semibold
  text-moss-800
  dark:text-moss-200
  mt-8
  mb-2
`;

const { text, level = 2 } = Astro.props as SectionHead;
const Heading = `h${level}`;
---

<div class={sectionHeadClasses}>
  <Heading>
    {text}
  </Heading>
</div>
