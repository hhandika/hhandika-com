---
import cntl from "cntl";

// Cards at the top of a project tab that list its research questions and
// link down to each section. Questions and topics may contain <i> (rendered with set:html).
export interface Question {
  id: string;
  question: string;
  topic: string;
}

interface Props {
  questions: Question[];
}

const { questions } = Astro.props;

// Full class strings so Tailwind can find them.
const columns: Record<number, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
  5: "sm:grid-cols-2 lg:grid-cols-3",
};

const cardClasses = cntl`
  group
  flex
  h-full
  flex-col
  rounded-2xl
  border
  border-forest-200
  bg-white
  p-4
  shadow-sm
  transition-colors
  duration-300
  hover:border-forest-400
  hover:bg-forest-50
  focus-visible:outline
  focus-visible:outline-2
  focus-visible:outline-forest-600
  dark:border-forest-700
  dark:bg-[#141810]
  dark:hover:border-forest-500
  dark:hover:bg-forest-900
  dark:focus-visible:outline-forest-300
`;
---

<nav aria-label="Research questions">
  <ol class={`mt-6 grid gap-4 ${columns[questions.length] ?? "sm:grid-cols-2 lg:grid-cols-3"}`}>
    {
      questions.map((q, i) => (
        <li>
          <a href={`#${q.id}`} class={cardClasses}>
            <span class="text-xs font-semibold uppercase tracking-wider text-moss-700 dark:text-moss-300">
              Question {i + 1}
            </span>
            <span class="mt-1 text-balance font-serif text-lg text-moss-900 dark:text-moss-100" set:html={q.question} />
            <span class="mt-auto pt-3 text-sm text-forest-700 group-hover:underline dark:text-forest-300">
              Read more <span aria-hidden="true">↓</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
