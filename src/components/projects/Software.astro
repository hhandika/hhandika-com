<script>
  // Copy SEGUL install commands. Where the Clipboard API is unavailable
  // (insecure origin or denied permission), select the command instead so
  // it can be copied by hand.
  const status = document.querySelector<HTMLElement>(".copy-status");
  document
    .querySelectorAll<HTMLButtonElement>(".copy-command")
    .forEach((button) => {
      let reset: number | undefined;
      button.addEventListener("click", async () => {
        const command = button.dataset.copy!;
        try {
          await navigator.clipboard.writeText(command);
        } catch {
          const code = button.parentElement!.querySelector("code")!;
          getSelection()?.selectAllChildren(code);
          if (status)
            status.textContent =
              "Command selected; press Ctrl+C or Command+C to copy.";
          return;
        }
        button.querySelector(".icon-copy")!.classList.add("hidden");
        button.querySelector(".icon-check")!.classList.remove("hidden");
        button.title = "Copied";
        if (status) status.textContent = `Copied: ${command}`;
        clearTimeout(reset);
        reset = window.setTimeout(() => {
          button.querySelector(".icon-copy")!.classList.remove("hidden");
          button.querySelector(".icon-check")!.classList.add("hidden");
          button.title = "Copy";
        }, 2000);
      });
    });
</script>
