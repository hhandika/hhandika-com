---
import Content from "../Content.astro";
import SectionHead from "../SectionHead.astro";
import QuestionIndex from "./QuestionIndex.astro";
import QuestionHead from "./QuestionHead.astro";
import cntl from "cntl";
import ProjectPubs from "../../layouts/ProjectPubs.astro";
import Link from "../Link.astro";
import LiveStat from "../github/LiveStat.astro";
import PageSubtitle from "../PageSubtitle.astro";
import NahpuArchitecture from "./software/NahpuArchitecture.astro";
import NahpuGallery from "./software/NahpuGallery.astro";
import BioCosmosArchitecture from "./software/BioCosmosArchitecture.astro";
import { Image } from "astro:assets";
import SegulBenchPlot from "./software/SegulBenchPlot.tsx";
import bench from "../../data/segul/bench.json";
import seguiPhoneGenomics from "../../assets/img/segul/segui-phone-genomics.webp";
import seguiPhoneViewer from "../../assets/img/segul/segui-phone-alignment-viewer.webp";
import segulCliReadTable from "../../assets/img/segul/segul-cli-read-table.webp";
import segulCliAlignment from "../../assets/img/segul/segul-cli-alignment.webp";
import lepiverseSearch from "../../assets/img/biocosmos/lepiverse-search-owl-brazil.jpg";
import mddHome from "../../assets/img/mdd/mdd-home.jpg";
import mddTaxon from "../../assets/img/mdd/mdd-taxon.jpg";
import mddAppTree from "../../assets/img/mdd/app-taxonomy-tree.webp";
import mddAppGallery from "../../assets/img/mdd/app-image-gallery.webp";
import mddAppTaxon from "../../assets/img/mdd/app-taxon-info.webp";
import mddAppMap from "../../assets/img/mdd/app-occurrence-map.webp";
import mddAppStats from "../../assets/img/mdd/app-statistics.webp";

const mddAppShots = [
  {
    src: mddAppTree,
    alt: "MDD app taxonomy tree showing monotremes from order to species with thumbnails",
    caption: "Taxonomy tree",
  },
  {
    src: mddAppGallery,
    alt: "MDD app gallery of 8,084 ASM Mammal Images Library photos",
    caption: "Image gallery",
  },
  {
    src: mddAppTaxon,
    alt: "MDD app taxon page for the short-beaked echidna, Tachyglossus aculeatus, with photo and distribution",
    caption: "Taxon page",
  },
  {
    src: mddAppMap,
    alt: "MDD app GBIF occurrence hexbin map for the short-beaked echidna with MDD country outlines",
    caption: "Occurrence map",
  },
  {
    src: mddAppStats,
    alt: "MDD app statistics showing species descriptions by decade",
    caption: "Statistics",
  },
];

// SEGUL CLI vs AMAS on every task, format, and dataset both were run on.
const benchKey = (r: (typeof bench.rows)[number]) =>
  `${r.task}|${r.format}|${r.dataset}`;
const segulRuns = new Map(
  bench.rows.filter((r) => r.app === "SEGUL CLI").map((r) => [benchKey(r), r]),
);
const vsAmas = bench.rows.flatMap((r) => {
  const s = r.app === "AMAS" ? segulRuns.get(benchKey(r)) : undefined;
  return s
    ? [{ ...r, speedup: r.time! / s.time!, memory: r.ram! / s.ram! }]
    : [];
});
const median = (xs: number[]) =>
  [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)];
const benchRun = (app: string, task: string, dataset: string) =>
  bench.rows.find(
    (r) =>
      r.app === app &&
      r.task === task &&
      r.format === "NEXUS" &&
      r.dataset === dataset,
  )!;
const largest = bench.datasets[0];
const androidSummary = benchRun(
  "SEGUL GUI (Android)",
  "Alignment Summary",
  largest.id,
);
const amasSummary = benchRun("AMAS", "Alignment Summary", largest.id);
// SEGUL GUI vs CLI on the same Linux desktop: the GUI calls the same Rust core.
const guiRuns = bench.rows.flatMap((r) => {
  const c =
    r.app === "SEGUL GUI (Linux)" ? segulRuns.get(benchKey(r)) : undefined;
  const a =
    r.app === "SEGUL GUI (Linux)"
      ? bench.rows.find((x) => x.app === "AMAS" && benchKey(x) === benchKey(r))
      : undefined;
  // Number() rather than a non-null `!` before `/`: the Astro checker misreads `! /` as a regex.
  return c && a
    ? [
        {
          vsCli: Number(r.time) / Number(c.time),
          beatsAmas: Number(a.time) > Number(r.time),
        },
      ]
    : [];
});
const segulStats = [
  {
    value: `${median(guiRuns.map((r) => r.vsCli)).toFixed(1)}×`,
    label: "median GUI runtime relative to the command line",
  },
  {
    value: `${guiRuns.filter((r) => r.beatsAmas).length} of ${guiRuns.length}`,
    label: "tasks where the GUI beat the AMAS command line",
  },
  {
    value: `${median(vsAmas.map((r) => r.speedup)).toFixed(1)}×`,
    label: "median speedup over AMAS",
  },
  {
    value: `${androidSummary.time!.toFixed(1)} s`,
    label: `to summarize ${largest.mbases} Mb of alignments on an Android phone (AMAS on a desktop: ${Math.round(amasSummary.time!)} s)`,
  },
];
// The viewer shot: all Esselstyn 2021 loci concatenated in SEGUI on Android.
const viewerShot = { taxa: 102, loci: 4040, sites: 5_398_947, at: 3_265_689 };
const segulShots = [
  {
    src: seguiPhoneGenomics,
    alt: "SEGUL iPhone app, read summary tool with eight FASTQ files selected",
    caption: "Read summary",
    device: "iPhone",
  },
  {
    src: seguiPhoneViewer,
    alt: `SEGUL Android app, alignment viewer showing the ${viewerShot.loci.toLocaleString("en")} concatenated Esselstyn 2021 loci, ${viewerShot.taxa} taxa by ${viewerShot.sites.toLocaleString("en")} sites, at site ${viewerShot.at.toLocaleString("en")}`,
    caption: `Viewer, ${(viewerShot.sites / 1e6).toFixed(1)}M sites`,
    device: "Android",
  },
];
// The terminal shot: `segul read summary --mode complete` on six Bunomys
// read files, opened in `segul view summary`.
const shotFrameClasses =
  "overflow-hidden rounded-[1.4rem] border border-forest-900/10 bg-forest-50 p-1.5 transition duration-500 hover:-translate-y-0.5 hover:shadow-lg dark:border-forest-100/10 dark:bg-forest-900/40";
const segulViewerShot = {
  src: segulCliAlignment,
  alt: "segul view align in a terminal showing an Esselstyn 2021 UCE locus, 49 taxa by 813 sites, with colored bases",
  caption: "Alignment viewer",
  device: "segul view align",
};
// On wide screens each screenshot grows by its aspect ratio from a base of its
// frame (border and padding), so every image in the row shares one height.
const rowShots = [...segulShots, segulViewerShot];
const shotGrow = (shot: (typeof rowShots)[number]) =>
  (shot.src.width / shot.src.height).toFixed(3);
// `segul read summary --mode complete` on six Bunomys read files, opened in
// `segul view summary`.
const segulTableShot = {
  src: segulCliReadTable,
  alt: "segul view summary in a terminal showing the Samples table of a complete read summary of six Bunomys read files, with reads, bases, quality, low-quality reads, duplication, adapter, and poly-G columns per sample",
  caption: "Complete read summary",
  device: "segul view summary",
};
// One Rust core, exposed four ways.
const segulInterfaces = [
  {
    name: "Command line",
    text: "A single file with no dependencies, for desktops and clusters.",
    install: "conda install -c bioconda segul",
  },
  {
    name: "Desktop & mobile app",
    text: "Point and click on Windows, macOS, Linux, iOS, iPadOS, and Android.",
    install: "segul.app",
    url: "https://segul.app",
  },
  {
    name: "Python",
    text: "Call SEGUL from scripts and notebooks.",
    install: "pip install pysegul",
  },
  {
    name: "Rust",
    text: "The core library behind every interface.",
    install: "cargo add segul",
  },
];

const figureClasses =
  "rounded-2xl border border-forest-900/10 bg-white/70 p-3 shadow-sm dark:border-forest-100/10 dark:bg-forest-950/40 sm:p-5";

const firstParagraphClasses = cntl`
  first-letter:text-7xl
  first-letter:font-semibold
  first-letter:mr-2
  first-letter:float-left
`;

const tools = [
  {
    name: "NAHPU",
    role: "Digital field catalog",
    stack: "Flutter · Rust",
    url: "https://nahpu.app",
  },
  {
    name: "SEGUL",
    role: "Phylogenomic data toolkit",
    stack: "Rust · Flutter",
    url: "https://segul.app",
  },
  {
    name: "ULLAR",
    role: "Phylogenomic pipeline",
    stack: "Rust",
    url: "https://github.com/hhandika/ullar",
  },
  {
    name: "BioCosmos",
    role: "AI collection explorer",
    stack: "Python · Next.js",
    url: "https://lepiverse.com",
  },
  {
    name: "MDD",
    role: "Mammal Diversity Database",
    stack: "Flutter · Rust · Astro",
    url: "https://www.mammaldiversity.org",
  },
];

const stats = [
  { value: null, label: "lines added / removed" },
  { value: "5", label: "open-source tools" },
  { value: "5", label: "platforms from one codebase" },
  { value: "Ernst Mayr", label: "Award, SSB (SEGUL)" },
];

// Condensed from the nahpu-docs architecture "Design principles".
const principles = [
  {
    title: "Offline first",
    text: "Field stations rarely have internet. Everything runs and stores locally, and the data is easy to share with others without an internet connection.",
  },
  {
    title: "Thin screens",
    text: "Screens only display data. Workflows live elsewhere, so they are easy to test and reuse.",
  },
  {
    title: "One source of truth",
    text: "One local database holds the records, kept separate from settings for easier sharing and reproduction.",
  },
  {
    title: "Rust for performance",
    text: "Heavy tasks, such as data export and mapping, run in fast, reusable Rust code.",
  },
];
// Condensed from the BioCosmos backend design (AGENTS.md, services/agent.py,
// and database/lance.py).
const biocosmosPrinciples = [
  {
    title: "Embedded databases",
    text: "Both databases run inside the app, so no separate database server is needed.",
  },
  {
    title: "Language model as planner",
    text: "The language model only picks from predefined search tools and never writes queries, avoiding made-up results and keeping data private.",
  },
  {
    title: "Constraints before ranking",
    text: "Filters narrow the candidates before similarity ranking, so every match meets the filters.",
  },
];

// The research questions drive both the index cards at the top and the
// heading of each section, so the two stay in sync.
const questions = [
  {
    id: "software-portable",
    label: "Design approach",
    question:
      "Efficient tools that run on any device, from smartphones to HPC clusters",
    topic: "Shared principles behind all my tools",
  },
  {
    id: "software-nahpu",
    question:
      "How do we design an app that handles the complexity of modern field expeditions in harsh environments?",
    topic: "Cross-platform software design approaches: NAHPU as an example",
  },
  {
    id: "biocosmos-architecture",
    question:
      "How can a lightweight system make 600,000 specimen images explorable?",
    topic:
      "BioCosmos: a lightweight web architecture for AI-enabled search and trait exploration",
  },
  {
    id: "software-segul",
    question:
      "How can anyone rigorously explore and reshape phylogenomic data with ease?",
    topic: "SEGUL: fast phylogenomic data exploration across platforms",
  },
  {
    id: "software-mdd",
    question:
      "How do we keep a living checklist of the world's mammals accessible?",
    topic: "Mammal Diversity Database: website, app, and tooling",
  },
];
---

<div>
  <PageSubtitle subtitle="Open, Cross-platform Software" />
  <dl class="mx-auto grid max-w-4xl grid-cols-2 gap-3 text-center sm:grid-cols-4">
    {stats.map((s) => (
      <div class="rounded-2xl border border-forest-900/10 px-3 py-4 dark:border-forest-100/10">
        <dt class="sr-only">{s.label}</dt>
        <dd class="font-serif text-2xl font-semibold text-moss-700 dark:text-moss-300">
          {s.value ?? (
            <>
              +
              <LiveStat
                path="code_changes.totals.additions"
                format="compact"
              />{" "}
              <span class="text-base font-normal text-forest-600 dark:text-forest-300">
                −
                <LiveStat
                  path="code_changes.totals.deletions"
                  format="compact"
                />
              </span>
            </>
          )}
        </dd>
        <dd class="mt-1 text-xs text-forest-700 dark:text-forest-300">
          {s.label}
        </dd>
      </div>
    ))}
  </dl>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <li>
        <a
          href={t.url}
          target="_blank"
          rel="noopener"
          class="group flex h-full items-center justify-between gap-3 rounded-xl border border-forest-900/15 px-4 py-3 transition hover:-translate-y-0.5 hover:border-moss-400 hover:bg-moss-50 dark:border-forest-100/15 dark:hover:bg-white/5"
        >
          <span>
            <span class="block font-mono font-semibold text-forest-800 dark:text-moss-200">
              {t.name}
            </span>
            <span class="block text-xs text-forest-700 dark:text-forest-300">
              {t.role}
            </span>
          </span>
          {t.stack && (
            <span class="whitespace-nowrap rounded-full bg-forest-100 px-2 py-0.5 font-mono text-[0.7rem] text-forest-800 dark:bg-forest-900 dark:text-forest-200">
              {t.stack}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>

  <QuestionIndex questions={questions} />

  <SectionHead text="Building Digital Infrastructure for Accessible and Data-Rich Biodiversity Research" />
  <Content>
    <p class={firstParagraphClasses}>
      My 13 years of experience working in the complex island systems of
      Southeast Asia exposed the limitations of conventional biodiversity
      research workflows. These include difficulties in preserving the breadth
      of information needed to understand complex biological systems,
      integrating genomic and other diverse data types, providing real-time
      statistics to aid field research, and enabling contributions from
      researchers with limited computational resources. These challenges
      motivate my software development efforts.
    </p>
    <p class="mt-2">
      I develop free, open-source software spanning field data collection
      (<Link text="NAHPU" url="https://nahpu.app" />), phylogenomics
      (<Link text="ULLAR" url="https://github.com/hhandika/ullar" />), genomic
      data processing (<Link text="SEGUL" url="https://segul.app" />), taxonomy
      (<Link
        text="Mammal Diversity Database"
        url="https://github.com/mammaldiversity/mdd_app"
      />), and AI-enabled specimen exploration and trait analyses
      (<Link text="BioCosmos" url="https://lepiverse.com" />).
      Across my public repositories, I have added{" "}
      <LiveStat path="code_changes.totals.additions" format="compact" /> lines
      of code and removed{" "}
      <LiveStat path="code_changes.totals.deletions" format="compact" />. These
      projects aim to make biodiversity research more efficient, reproducible,
      and accessible, particularly to underfunded laboratories, while enabling
      new research directions, such as using{" "}
      <Link
        text="vector embedding"
        url="https://www.ibm.com/think/topics/vector-embedding"
      />{" "}
      approaches to study multi-dimensional trait variation.
    </p>
  </Content>

  <QuestionHead questions={questions} id="software-portable" />
  <Content>
    <p>
      My tools install like everyday software, either with one click from the
      app stores or a single command in the terminal, without requiring
      additional applications, such as Docker or Singularity. Each tool makes
      biodiversity data easier to capture, explore, or share. For example, NAHPU
      links every specimen part, field observation, parasite collection, and
      derivative data (e.g., audio, video, and photographs) to its voucher from
      the moment of collection, and its live statistics guide tissue sampling
      and track collecting effort. SEGUL, on the other hand, summarizes and
      filters thousands of genomic files in a single workflow, even on a phone.
      I care deeply about how my tools, their supporting software, and
      documentation are designed, tested, and maintained, so they remain usable
      as software, hardware, and academic priorities change.
    </p>
  </Content>

  <QuestionHead questions={questions} id="software-nahpu" />
  <Content>
    <p>
      <Link text="NAHPU" url="https://nahpu.app" /> is a field cataloging app
      for collection-based research, from specimens to the parasites collected
      from them and their screening status (<Link
        text="Handika et al., submitted"
        url="https://doi.org/10.32942/X21M6D"
      />). It has to work on a phone or a tablet at a remote field camp and on a
      laptop back at the museum, with or without internet. I build it in clear
      layers, from the interface to the database and fast Rust code. Each layer
      has one job, which keeps the app fast, testable, and easy for new
      contributors to learn. The full design is documented in the{" "}
      <Link
        text="NAHPU developer docs"
        url="https://nahpu.app/en/contributing/code/architecture/"
      />.
    </p>
  </Content>
  <NahpuArchitecture />
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {principles.map((p, i) => (
      <li class="rounded-2xl border border-forest-900/10 bg-forest-50/60 p-4 dark:border-forest-100/10 dark:bg-forest-900/30">
        <span class="font-mono text-xs text-moss-700 dark:text-moss-300">
          0{i + 1}
        </span>
        <h3 class="mt-1 font-semibold text-forest-900 dark:text-forest-50">
          {p.title}
        </h3>
        <p class="mt-1 text-sm text-forest-800 dark:text-forest-200">
          {p.text}
        </p>
      </li>
    ))}
  </ul>
  <NahpuGallery />
  <Content>
    <p class="mt-6 mb-1 font-semibold text-moss-800 dark:text-moss-200">
      Publications:
    </p>
    <ProjectPubs ids={["nahpu"]} />
  </Content>

  <QuestionHead questions={questions} id="biocosmos-architecture" />
  <Content>
    <p>
      <Link text="BioCosmos" url="https://github.com/BioVisionLab/BioCosmos" />,
      the platform behind <Link text="LepiVerse" url="https://lepiverse.com" />,
      features comprehensive search across more than 600,000 butterfly specimen
      images by name, image, or plain-language questions (<Link
        text="Handika et al., submitted"
        url="https://doi.org/10.32942/X2C11R"
      />). Its design problem is that it must answer open-ended questions over
      hundreds of thousands of images and their embeddings on a single, modest
      server. I built it as a single process that holds
      everything needed for the search. An open-weight language model plans the
      search, and the <Link text="CLIP" url="https://github.com/openai/CLIP" /> and{" "}
      <Link text="UNICOM" url="https://github.com/deepglint/unicom" /> vision
      models encode it. Two embedded databases store the data:{" "}
      <Link text="DuckDB" url="https://duckdb.org" /> for specimen records and{" "}
      <Link text="LanceDB" url="https://lancedb.com" /> for image embeddings.
      Neither needs a dedicated database server.
    </p>
    <p class="mt-2">
      The language model never touches the data. It reads the question once and
      chooses which search tools to run. This design keeps the data private. Filters first narrow the candidate species, and image
      similarity then ranks only those that pass the filters. Explore the
      architecture in the interactive diagram below.
    </p>
    <p class="mt-2">
      Data preparation runs in separate, reusable command-line packages. They
      match taxonomic names against the{" "}
      <Link text="Catalogue of Life" url="https://www.catalogueoflife.org" />,
      validate coordinates against <Link text="GADM" url="https://gadm.org" />,
      and precompute the similarity tables. Each run records its outputs for
      reproducibility. The same packages benchmark candidate language models,
      and the best open-weight model is used in production (see{" "}
      <a
        href="#llm-benchmark"
        class="text-mist-700 underline hover:text-mist-900 dark:text-mist-200 dark:hover:text-mist-100"
      >the AI section</a>). Together, the single server, embedded databases, and minimal
      language-model use keep BioCosmos inexpensive to run and simple to
      maintain long after initial funding ends.
    </p>
  </Content>
  <figure class={`not-prose my-6 ${shotFrameClasses}`}>
    <Image
      src={lepiverseSearch}
      alt="LepiVerse results for the plain-language question owl-like butterfly from brazil, led by Caligo owl butterflies matched by color and location"
      width={1200}
      densities={[1, 2]}
      loading="lazy"
      class="rounded-[1.1rem]"
    />
    <figcaption class="flex flex-wrap items-baseline justify-between gap-x-2 px-1.5 pt-1.5 text-xs">
      <span class="font-semibold text-forest-900 dark:text-forest-100">
        Asking a plain-language question
      </span>
      <span class="font-mono text-[0.7rem] text-forest-600 dark:text-forest-400">
        lepiverse.com
      </span>
    </figcaption>
  </figure>
  <BioCosmosArchitecture />
  <ul class="grid gap-3 sm:grid-cols-3">
    {biocosmosPrinciples.map((p, i) => (
      <li class="rounded-2xl border border-forest-900/10 bg-forest-50/60 p-4 dark:border-forest-100/10 dark:bg-forest-900/30">
        <span class="font-mono text-xs text-moss-700 dark:text-moss-300">
          0{i + 1}
        </span>
        <h3 class="mt-1 font-semibold text-forest-900 dark:text-forest-50">
          {p.title}
        </h3>
        <p class="mt-1 text-sm text-forest-800 dark:text-forest-200">
          {p.text}
        </p>
      </li>
    ))}
  </ul>
  <Content>
    <p class="mt-6 mb-1 font-semibold text-moss-800 dark:text-moss-200">
      Publications:
    </p>
    <ProjectPubs ids={["biocosmos"]} />
  </Content>

  <QuestionHead questions={questions} id="software-segul" />
  <Content>
    <p>
      Between assembling loci and inferring trees lies an often overlooked step:
      exploring the data. <Link text="SEGUL" url="https://segul.app" />
      summarizes raw reads, contigs, and alignments, and filters, concatenates,
      converts, and renames thousands of files in a single workflow. Its
      alignment filtering options are unique among comparable tools. In an
      accompanying perspective,{" "}
      <Link
        text="Chan (2024)"
        url="https://doi.org/10.1111/1755-0998.13993"
      />{" "}
      described SEGUL as a proof of concept that efficient software can make
      genomic-scale analyses more tractable and phylogenomics accessible to a
      broader range of users. SEGUL received the 2024{" "}
      <Link
        text="Ernst Mayr Award"
        url="https://www.systbio.org/ernst-mayr-award.html"
      />{" "}
      from the Society of Systematic Biologists. The latest release adds
      alignment and summary viewers to the app and the terminal. For example, using
      the shrew dataset of{" "}
      <Link
        text="Esselstyn et al. (2021)"
        url="https://doi.org/10.1206/0003-0090.454.1.1"
      />, the Android app displays a single alignment of {viewerShot.taxa} taxa
      and {(viewerShot.sites / 1e6).toFixed(1)} million sites, built from
      {viewerShot.loci.toLocaleString("en")} concatenated loci.
    </p>
    <p class="mt-2">
      Every interface runs on the same fast Rust core. I compared it with popular alternatives (<Link text="AMAS" url="https://github.com/marekborowiec/AMAS" />,{" "}
      <Link text="goalign" url="https://github.com/evolbioinfo/goalign" />, and{" "}
      <Link text="Phyluce" url="https://phyluce.readthedocs.io/en/latest/" />)
      on published datasets, using a desktop computer, an iPad, and an Android
      device (<Link
        text="Handika & Esselstyn 2024"
        url="https://doi.org/10.1111/1755-0998.13964"
      />). The GUI is nearly as fast as the command line and outpaces most
      command-line alternatives. Mobile devices are slower only because of their
      hardware. Use the interactive plot below to compare the tools, datasets, and
      devices.
    </p>
  </Content>
  <ul class="my-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {segulInterfaces.map((i) => (
      <li class="flex flex-col rounded-2xl border border-forest-900/10 bg-forest-50/60 p-4 dark:border-forest-100/10 dark:bg-forest-900/30">
        <h3 class="font-semibold text-forest-900 dark:text-forest-50">
          {i.name}
        </h3>
        <p class="mt-1 flex-1 text-sm text-forest-800 dark:text-forest-200">
          {i.text}
        </p>
        {i.url ? (
          <a
