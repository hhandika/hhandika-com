---
import Content from "../Content.astro";
import SectionHead from "../SectionHead.astro";
import cntl from "cntl";
import ProjectPubs from "../../layouts/ProjectPubs.astro";
import PubButton from "../buttons/PubButton.astro";
import Link from "../Link.astro";
import PageSubtitle from "../PageSubtitle.astro";
import NahpuArchitecture from "./software/NahpuArchitecture.astro";
import NahpuGallery from "./software/NahpuGallery.astro";
import BioCosmosArchitecture from "./software/BioCosmosArchitecture.astro";
import { Image } from "astro:assets";
import SegulBenchPlot from "./software/SegulBenchPlot.tsx";
import bench from "../../data/segul/bench.json";
import seguiIosGenomics from "../../assets/img/segul/segui-ios-genomics.jpg";
import seguiIosAlignments from "../../assets/img/segul/segui-ios-alignments.jpg";
import mddHome from "../../assets/img/mdd/mdd-home.jpg";
import mddTaxon from "../../assets/img/mdd/mdd-taxon.jpg";
import mddAppTree from "../../assets/img/mdd/app-taxonomy-tree.webp";
import mddAppGallery from "../../assets/img/mdd/app-image-gallery.webp";
import mddAppTaxon from "../../assets/img/mdd/app-taxon-info.webp";
import mddAppMap from "../../assets/img/mdd/app-occurrence-map.webp";
import mddAppStats from "../../assets/img/mdd/app-statistics.webp";

const mddAppShots = [
  {
    src: mddAppTree,
    alt: "MDD app taxonomy tree showing monotremes from order to species with thumbnails",
    caption: "Taxonomy tree",
  },
  {
    src: mddAppGallery,
    alt: "MDD app gallery of 8,084 ASM Mammal Images Library photos",
    caption: "Image gallery",
  },
  {
    src: mddAppTaxon,
    alt: "MDD app taxon page for the short-beaked echidna, Tachyglossus aculeatus, with photo and distribution",
    caption: "Taxon page",
  },
  {
    src: mddAppMap,
    alt: "MDD app GBIF occurrence hexbin map for the short-beaked echidna with MDD country outlines",
    caption: "Occurrence map",
  },
  {
    src: mddAppStats,
    alt: "MDD app statistics showing species descriptions by decade",
    caption: "Statistics",
  },
];

// SEGUL CLI vs AMAS on every task, format, and dataset both were run on.
const benchKey = (r: (typeof bench.rows)[number]) =>
  `${r.task}|${r.format}|${r.dataset}`;
const segulRuns = new Map(
  bench.rows.filter((r) => r.app === "SEGUL CLI").map((r) => [benchKey(r), r]),
);
const vsAmas = bench.rows.flatMap((r) => {
  const s = r.app === "AMAS" ? segulRuns.get(benchKey(r)) : undefined;
  return s
    ? [{ ...r, speedup: r.time! / s.time!, memory: r.ram! / s.ram! }]
    : [];
});
const median = (xs: number[]) =>
  [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)];
const benchRun = (app: string, task: string, dataset: string) =>
  bench.rows.find(
    (r) =>
      r.app === app &&
      r.task === task &&
      r.format === "NEXUS" &&
      r.dataset === dataset,
  )!;
const largest = bench.datasets[0];
const androidSummary = benchRun(
  "SEGUL GUI (Android)",
  "Alignment Summary",
  largest.id,
);
const amasSummary = benchRun("AMAS", "Alignment Summary", largest.id);
// SEGUL GUI vs CLI on the same Linux desktop: the GUI calls the same Rust core.
const guiRuns = bench.rows.flatMap((r) => {
  const c =
    r.app === "SEGUL GUI (Linux)" ? segulRuns.get(benchKey(r)) : undefined;
  const a =
    r.app === "SEGUL GUI (Linux)"
      ? bench.rows.find((x) => x.app === "AMAS" && benchKey(x) === benchKey(r))
      : undefined;
  // Number() rather than a non-null `!` before `/`: the Astro checker misreads `! /` as a regex.
  return c && a
    ? [
        {
          vsCli: Number(r.time) / Number(c.time),
          beatsAmas: Number(a.time) > Number(r.time),
        },
      ]
    : [];
});
const guiMax = Math.max(...guiRuns.map((r) => r.vsCli));
const segulStats = [
  {
    value: `${median(guiRuns.map((r) => r.vsCli)).toFixed(1)}×`,
    label: `median GUI runtime relative to the command line on the same desktop (at most ${guiMax.toFixed(1)}×)`,
  },
  {
    value: `${guiRuns.filter((r) => r.beatsAmas).length} of ${guiRuns.length}`,
    label:
      "tasks where the desktop GUI finished faster than the AMAS command line",
  },
  {
    value: `${median(vsAmas.map((r) => r.speedup)).toFixed(1)}×`,
    label: `median speedup over AMAS across ${vsAmas.length} task, format, and dataset runs`,
  },
  {
    value: `${androidSummary.time!.toFixed(1)} s`,
    label: `to summarize ${largest.mbases} Mb of alignments on an Android device, vs ${Math.round(amasSummary.time!)} s for AMAS on a desktop`,
  },
];
const segulShots = [
  {
    src: seguiIosGenomics,
    alt: "SEGUL iPhone app, Genomic Sequence Tools screen set up to summarize raw genomic reads",
    caption: "Read summary",
  },
  {
    src: seguiIosAlignments,
    alt: "SEGUL iPhone app, Alignment Tools screen with input, output format, and partition options for concatenation",
    caption: "Alignment concatenation",
  },
];
// One Rust core, exposed four ways.
const segulInterfaces = [
  {
    name: "Command line",
    text: "Single executable with no dependencies, work well in desktop and HPC environments.",
    install: "conda install -c bioconda segul",
  },
  {
    name: "Desktop & mobile app",
    text: "Point and click on Windows, macOS, Linux, iOS, iPadOS, and Android.",
    install: "segul.app",
    url: "https://segul.app",
  },
  {
    name: "Python",
    text: "Call SEGUL from scripts and notebooks through native bindings. No Rust knowledge required.",
    install: "pip install pysegul",
  },
  {
    name: "Rust",
    text: "The core library behind every interface, and for building new tools.",
    install: "cargo add segul",
  },
];

const figureClasses =
  "rounded-2xl border border-forest-900/10 bg-white/70 p-3 shadow-sm dark:border-forest-100/10 dark:bg-forest-950/40 sm:p-5";

const firstParagraphClasses = cntl`
  first-letter:text-7xl
  first-letter:font-semibold
  first-letter:mr-2
  first-letter:float-left
`;

const tools = [
  {
    name: "NAHPU",
    role: "Digital field catalog",
    stack: "Flutter · Rust",
    url: "https://nahpu.app",
  },
  {
    name: "SEGUL",
    role: "Phylogenomic data toolkit",
    stack: "Rust · Flutter",
    url: "https://segul.app",
  },
  {
    name: "ULLAR",
    role: "Phylogenomic pipeline",
    stack: "Rust",
    url: "https://github.com/hhandika/ullar",
  },
  {
    name: "BioCosmos",
    role: "AI collection explorer",
    stack: "Python · Next.js",
    url: "https://lepiverse.com",
  },
  {
    name: "MDD",
    role: "Mammal Diversity Database",
    stack: "Flutter · Rust · Astro",
    url: "https://mammaldiversity.org",
  },
];

const stats = [
  { value: "740k+", label: "lines of code" },
  { value: "5", label: "open-source tools" },
  { value: "5", label: "platforms from one codebase" },
  { value: "Ernst Mayr", label: "Award, SSB (SEGUL)" },
];

// Condensed from the nahpu-docs architecture "Design principles".
const principles = [
  {
    title: "Offline first",
    text: "Field stations rarely have internet. Everything runs and stores locally, and the data is easy to share with others without an internet connection.",
  },
  {
    title: "Thin screens",
    text: "UI only renders state. Workflows live in providers and services, so they are testable and reusable.",
  },
  {
    title: "One source of truth",
    text: "A SQLite database stores the data, while versioned configs capture reproducible settings, keeping data and configuration separate for easier sharing, reproduction, and curation.",
  },
  {
    title: "Rust for performance",
    text: "Archives, Darwin Core export, PDFs, and GIS run in small reusable Rust crates behind a thin bridge.",
  },
];
// Condensed from the BioCosmos backend design (AGENTS.md, services/agent.py,
// and database/lance.py).
const biocosmosPrinciples = [
  {
    title: "Embedded databases",
    text: "DuckDB and LanceDB run in-process with the API, eliminating the need for a separate database server.",
  },
  {
    title: "LLM planner with typed tools",
    text: "The LLM only selects typed tools; arguments are validated, column names are defined in code, and values are bound rather than generated by the model, avoiding hallucinations and keeping data private.",
  },
  {
    title: "Constraints before ranking",
    text: "Exact SQL constraints narrow the candidate set before vector ranking, ensuring that similarity matches never violate a constraint.",
  },
];

const spaceClasses = cntl`
  mr-1
`;
---

<div>
  <PageSubtitle subtitle="Open, Cross-platform Software" />
  <dl
    class="mx-auto grid max-w-4xl grid-cols-2 gap-3 text-center sm:grid-cols-4"
  >
    {
      stats.map((s) => (
        <div class="rounded-2xl border border-forest-900/10 px-3 py-4 dark:border-forest-100/10">
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-serif text-2xl font-semibold text-moss-700 dark:text-moss-300">
            {s.value}
          </dd>
          <dd class="mt-1 text-xs text-forest-700 dark:text-forest-300">
            {s.label}
          </dd>
        </div>
      ))
    }
  </dl>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      tools.map((t) => (
        <li>
          <a
            href={t.url}
            class="group flex h-full items-center justify-between gap-3 rounded-xl border border-forest-900/15 px-4 py-3 transition hover:-translate-y-0.5 hover:border-moss-400 hover:bg-moss-50 dark:border-forest-100/15 dark:hover:bg-white/5"
          >
            <span>
              <span class="block font-mono font-semibold text-forest-800 dark:text-moss-200">
                {t.name}
              </span>
              <span class="block text-xs text-forest-700 dark:text-forest-300">
                {t.role}
              </span>
            </span>
            {t.stack && (
              <span class="whitespace-nowrap rounded-full bg-forest-100 px-2 py-0.5 font-mono text-[0.7rem] text-forest-800 dark:bg-forest-900 dark:text-forest-200">
                {t.stack}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <SectionHead
    text="Digital Infrastructure for Accessible and Data-Rich Biodiversity Research"
  />
  <Content>
    <p class={firstParagraphClasses}>
      Over 13 years of working in the complex island systems of Southeast Asia,
      I have repeatedly encountered the practical challenges of biodiversity
      research: collecting standardized data in harsh field conditions, managing
      growing genomic datasets, integrating taxonomic and phylogenetic
      information, and working with limited computational resources. Just as
      importantly, this work showed me the limitations of traditional workflows,
      particularly their difficulty in representing uncertainty and capturing
      the breadth of information needed to understand complex biological
      systems.
    </p>
    <p class="mt-2">
      I develop free, open-source software spanning field data collection (<Link
        text="NAHPU"
        url="https://nahpu.app"
      />), phylogenomics (<Link
        text="ULLAR"
        url="https://github.com/hhandika/ullar"
      />), genomic data processing (<Link
        text="SEGUL"
        url="https://segul.app"
      />), taxonomy (<Link
        text="Mammal Diversity Database"
        url="https://github.com/mammaldiversity/mdd_app"
      />), and AI-enabled specimen exploration (<Link
        text="BioCosmos"
        url="https://lepiverse.com"
      />). Together, these projects comprise more than 740,000 lines of code and
      aim to make biodiversity research more efficient, reproducible, and
      accessible, particularly to underfunded laboratories.
    </p>
    <p class="mt-2">
      My tools work on anything, from a phone to a high-performance computing
      cluster, and install in one click from the app stores or with a single
      command in the terminal. Beyond speed, they capture information that was
      difficult to record before. NAHPU, for example, links every specimen part,
      field observation, and derivative data (e.g., audio, video, and
      photographs) to its voucher from the moment of collection. It generates
      statistics that detects outlier measurements and aids decision-making in
      the field, such as which specimens to prioritize for complete tissue
      sampling when preservation resources are limited.
    </p>
  </Content>

  <SectionHead
    text="My cross-platform software design approach: NAHPU as an example"
  />
  <Content>
    <p>
      <Link text="NAHPU" url="https://nahpu.app" /> is a field cataloging app for
      collection-based research, from specimens to the parasites collected from them
      and their screening status. It has to work on a phone or a tablet at a remote
      field camp and on a laptop back at the museum, with or without internet. I build
      it in layers: a Flutter interface on top, application state and domain workflows
      in the middle, a SQLite database for records, and performance-critical, reusable
      code in Rust crates interfaced through a generated bridge. Each layer has one
      job, which keeps the app fast, testable, and easy for new contributors to learn.
      The full design is documented in the <Link
        text="NAHPU developer docs"
        url="https://nahpu.app/en/contributing/code/architecture/"
      />.
    </p>
  </Content>
  <NahpuArchitecture />
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      principles.map((p, i) => (
        <li class="rounded-2xl border border-forest-900/10 bg-forest-50/60 p-4 dark:border-forest-100/10 dark:bg-forest-900/30">
          <span class="font-mono text-xs text-moss-700 dark:text-moss-300">
            0{i + 1}
          </span>
          <h3 class="mt-1 font-semibold text-forest-900 dark:text-forest-50">
            {p.title}
          </h3>
          <p class="mt-1 text-sm text-forest-800 dark:text-forest-200">
            {p.text}
          </p>
        </li>
      ))
    }
  </ul>
  <NahpuGallery />

  <SectionHead
    id="biocosmos-architecture"
    text="BioCosmos: A Lightweight Architecture for AI Search and Trait Exploration for Natural History Collections"
  />
  <Content>
    <p>
      <Link text="BioCosmos" url="https://github.com/BioVisionLab/BioCosmos" />,
      the platform behind <Link text="LepiVerse" url="https://lepiverse.com" />,
      lets anyone search more than 600,000 butterfly specimen images by name,
      image, or a plain-language question. Its design problem is that it must
      answer open-ended questions over hundreds of thousands of images and their
      embeddings on a single, modest server. I built it as one <Link
        text="FastAPI"
        url="https://fastapi.tiangolo.com"
      /> process that holds everything needed for the search. An open-weight language
      model plans the search, the <Link
        text="CLIP"
        url="https://github.com/openai/CLIP"
      /> and <Link text="UNICOM" url="https://github.com/deepglint/unicom" /> vision
      models encode it, and two embedded databases execute it. <Link
        text="DuckDB"
        url="https://duckdb.org"
      />, an in-process analytical (OLAP) database is for metadata, taxonomy,
      localities, and traits, and <Link
        text="LanceDB"
        url="https://lancedb.com"
      />, an in-process vector database is for the image embeddings. Neither
      needs a database server, making the system lightweight and efficient. Both
      query columnar files in place and exchange results as Arrow tables through <Link
        text="Polars"
        url="https://pola.rs"
      />.
    </p>
    <p class="mt-2">
      The language model never touches the data. It reads a question once and
      returns typed tool calls for location, traits, common name, color, or
      visual similarity. This design keep token usage low and data stay private.
      Code then runs them in two stages: filters run concurrently as SQL in
      DuckDB and intersect into an allowlist of species, and ranking tools
      search the vector index only within that allowlist. Hard constraints stay
      exact, and vector search spends its time only on candidates that can
      match. Use the interactive diagram below to explore the architecture.
    </p>
  </Content>
  <BioCosmosArchitecture />
  <ul class="grid gap-3 sm:grid-cols-3">
    {
      biocosmosPrinciples.map((p, i) => (
        <li class="rounded-2xl border border-forest-900/10 bg-forest-50/60 p-4 dark:border-forest-100/10 dark:bg-forest-900/30">
          <span class="font-mono text-xs text-moss-700 dark:text-moss-300">
            0{i + 1}
          </span>
          <h3 class="mt-1 font-semibold text-forest-900 dark:text-forest-50">
            {p.title}
          </h3>
          <p class="mt-1 text-sm text-forest-800 dark:text-forest-200">
            {p.text}
          </p>
        </li>
      ))
    }
  </ul>
  <Content>
    <p class="mt-4">
      Data preparation is handled by command-line packages that are decoupled
      from the backend and can run independently. The packages share the same <Link
        text="uv"
        url="https://docs.astral.sh/uv/"
      /> workspace and match taxonomic names against the <Link
        text="Catalogue of Life"
        url="https://www.catalogueoflife.org"
      />, validate coordinates against <Link
        text="GADM"
        url="https://gadm.org"
      />, and precompute visual similarity and morphospace tables. Each run
      writes a manifest containing the SHA-256 hash of every generated output.
      The same workspace also benchmarks candidate planner models, which
      informed the selection of the open-weight model used in production (see <a
        href="#llm-benchmark"
        class="text-mist-700 underline hover:text-mist-900 dark:text-mist-200 dark:hover:text-mist-100"
        >the AI tab</a
      >).
    </p>
  </Content>

  <SectionHead
    text="SEGUL: Fast Phylogenomic Data Exploration Across Platforms"
  />
  <Content>
    <p>
      Between assembling loci and inferring trees lies an often overlooked step:
      exploring the data. <Link text="SEGUL" url="https://segul.app" />
      summarizes alignments, including taxon occupancy, missing data, and parsimony-informative
      sites, as well as raw read and contigs. It also filters, concatenates, splits,
      converts, and renames thousands of files in a single workflow. Its ability to
      filter alignments by length, completeness, and informative sites is unique among
      comparable tools. In an accompanying perspective, <Link
        text="Chan (2024)"
        url="https://doi.org/10.1111/1755-0998.13993"
      /> described SEGUL as a proof of concept that efficient software can make genomic-scale
      analyses more tractable and phylogenomics accessible to a broader range of users.
      SEGUL received the 2024 <Link
        text="Ernst Mayr Award"
        url="https://www.systbio.org/ernst-mayr-award.html"
      /> from the Society of Systematic Biologists. I am now extending SEGUL and
      <Link text="ULLAR" url="https://github.com/hhandika/ullar" /> with automated
      detection of outlier alignments and clearer diagnostics.
    </p>
  </Content>
  <ul class="my-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      segulInterfaces.map((i) => (
        <li class="flex flex-col rounded-2xl border border-forest-900/10 bg-forest-50/60 p-4 dark:border-forest-100/10 dark:bg-forest-900/30">
          <h3 class="font-semibold text-forest-900 dark:text-forest-50">
            {i.name}
          </h3>
          <p class="mt-1 flex-1 text-sm text-forest-800 dark:text-forest-200">
            {i.text}
          </p>
          {i.url ? (
            <a
              href={i.url}
              class="mt-3 block rounded-lg bg-forest-900/5 px-2 py-1 font-mono text-xs text-moss-800 underline hover:text-moss-950 dark:bg-white/5 dark:text-moss-200 dark:hover:text-moss-50"
            >
              {i.install}
            </a>
          ) : (
            <div class="mt-3 flex items-start gap-1 rounded-lg bg-forest-900/5 dark:bg-white/5">
              <code class="min-w-0 flex-1 break-words py-1 pl-2 font-mono text-xs text-moss-800 dark:text-moss-200">
                {i.install}
              </code>
              <button
                type="button"
                class="copy-command grid h-7 w-7 shrink-0 place-items-center rounded-lg text-forest-700 transition-colors hover:bg-forest-900/10 hover:text-forest-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-moss-600 dark:text-forest-300 dark:hover:bg-white/10 dark:hover:text-forest-50 dark:focus-visible:outline-moss-400"
                data-copy={i.install}
                aria-label={`Copy command: ${i.install}`}
                title="Copy"
              >
                <svg
                  viewBox="0 0 16 16"
                  class="icon-copy h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                  <path d="M10.5 5.5V3.5a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
                </svg>
                <svg
                  viewBox="0 0 16 16"
                  class="icon-check hidden h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    d="M3 8.5l3.2 3L13 4.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          )}
        </li>
      ))
    }
  </ul>
  <p class="copy-status sr-only" aria-live="polite"></p>
  <Content>
    <p>
      Every interface runs on the same high-performance Rust core, so users can
      choose whichever platform best fits their workflow without sacrificing
      performance. I benchmarked SEGUL against widely used alternatives (<Link
        text="AMAS"
        url="https://github.com/marekborowiec/AMAS"
      />, <Link text="goalign" url="https://github.com/evolbioinfo/goalign" />,
      and <Link
        text="Phyluce"
        url="https://phyluce.readthedocs.io/en/latest/"
      />) using six published datasets spanning {
        bench.datasets.at(-1)!.mbases
      }–{largest.mbases} million bases. Each benchmark was repeated {
        bench.replicates
      } times on a desktop ({bench.machine}), an iPad, and an Android device (<Link
        text="Handika & Esselstyn 2024"
        url="https://doi.org/10.1111/1755-0998.13964"
      />). The interactive plot below lets you explore the results across tools,
      datasets, and platforms.
    </p>
  </Content>
  <figure class={`not-prose my-6 ${figureClasses}`}>
    <SegulBenchPlot client:visible />
  </figure>
  <div
    class="grid items-start gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"
  >
    <div class="grid grid-cols-2 gap-3">
      {
        segulShots.map((shot) => (
          <figure class="overflow-hidden rounded-[1.4rem] border border-forest-900/10 bg-forest-50 p-1.5 transition duration-500 hover:-translate-y-0.5 hover:shadow-lg dark:border-forest-100/10 dark:bg-forest-900/40">
            <Image
              src={shot.src}
              alt={shot.alt}
              width={360}
              densities={[1, 2]}
              loading="lazy"
              class="rounded-[1.1rem]"
            />
            <figcaption class="flex flex-wrap items-baseline justify-between gap-x-2 px-1.5 pt-1.5 text-xs">
              <span class="font-semibold text-forest-900 dark:text-forest-100">
                {shot.caption}
              </span>
              <span class="font-mono text-[0.7rem] text-forest-600 dark:text-forest-400">
                iPhone
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div>
      <dl class="grid grid-cols-2 gap-3">
        {
          segulStats.map((s) => (
            <div class="rounded-2xl border border-forest-900/10 px-3 py-3 dark:border-forest-100/10">
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-serif text-xl font-semibold text-moss-700 dark:text-moss-300">
                {s.value}
              </dd>
              <dd class="mt-1 text-xs text-forest-700 dark:text-forest-300">
                {s.label}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-sm text-forest-800 dark:text-forest-200">
        On the same machine, the GUI finishes within about a second of the
        command line and still outpaces most command-line alternatives. The
        slower execution on mobile devices is due to slower hardware compared to
        a desktop.
