---
import type { Question } from "./QuestionIndex.astro";

// Section heading led by its research question. The question is the heading
// and reads larger than the section topic beneath it.
interface Props {
  questions: Question[];
  // Which question in the list this section answers.
  id: string;
}

const { questions, id } = Astro.props;
const index = questions.findIndex((q) => q.id === id);
const q = questions[index];
if (!q) throw new Error(`Unknown question id: ${id}`);
---

<div id={q.id} class="clear-both mt-12 mb-3 scroll-mt-24">
  <p class="text-xs font-semibold uppercase tracking-wider text-moss-700 dark:text-moss-300">
    Question {index + 1}
  </p>
  <h3
    class="mt-1 text-balance font-serif text-2xl font-semibold text-moss-900 dark:text-moss-100 sm:text-[1.75rem] sm:leading-snug"
    set:html={q.question}
  />
  <p class="mt-1 text-lg text-forest-700 dark:text-forest-300" set:html={q.topic} />
</div>
