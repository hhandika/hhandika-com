// Resolve text, badge width, and chip positions for each node in a layout.
function place(layout: Layout) {
  return nodes.map((n, i) => {
    const b = layout.boxes[n.id];
    const text: NodeText = {
      title: n.title,
      path: n.path,
      sub: n.sub,
      chips: n.chips,
      ...b.text,
    };
    const t = tones[n.tone];
    const badge =
      layout.badges && n.badge
        ? {
            label: n.badge.toUpperCase(),
            w: Math.round(n.badge.length * 6.6 + 14),
          }
        : null;
    const chipY = b.y + (text.sub ? 66 : 50);
    let chips = text.chips?.length
      ? wrapChips(text.chips, b.x + 14, chipY, b.w - 24, {
          charW: layout.chipCharW,
          rowH: 26,
        })
      : [];
    if (n.id === "app") {
      // Page chips: right-aligned on wide, below the title on narrow.
      if (layout.name === "wide") {
        const last = chips[chips.length - 1];
        const shift = b.x + b.w - 16 - (last.x + last.w);
        chips = chips.map((c) => ({
          ...c,
          x: c.x + shift,
          y: b.y + (b.h - 22) / 2,
        }));
      } else {
        chips = chips.map((c) => ({ ...c, y: b.y + 52 }));
      }
    }
    return { ...n, ...b, text, t, badge, chips, i };
  });
}

const layouts = [wide, narrow].map((layout) => ({
  ...layout,
  placed: place(layout),
}));

// Example questions from the BioCosmos planner benchmark
// (packages/plannerbench/resources/cases.toml), traced through
// services/agent.py.
