  tones,
  wrapChips,
  arrowHead,
  lineClass,
  labelClass,
  packetClass,
  type Tone,
} from "./diagram";
import MotionToggle from "../MotionToggle.astro";
import planner from "../../../data/biocosmos/planner.json";

