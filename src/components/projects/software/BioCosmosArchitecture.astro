interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
  text?: Partial<NodeText>;
}

interface Edge {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  label?: string;
  // Labels sit right of vertical edges; horizontal edges centre them above.
  lx?: number;
  ly?: number;
}

interface Layout {
  name: string;
  class: string;
  width: number;
  height: number;
  badges: boolean;
  chipCharW: number;
  boxes: Record<string, Box>;
  edges: Edge[];
  boundary: {
    x: number;
    y: number;
    w: number;
    h: number;
    label: string;
    ly: number;
  };
  packets: { tone: Tone; d: string; dur: number; begin: number }[];
  legend: { x: number; y: number; vertical: boolean };
}

