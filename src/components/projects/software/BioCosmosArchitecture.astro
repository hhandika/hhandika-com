const callClass: Record<string, string> = {
  filter:
    "bg-forest-100 text-forest-800 dark:bg-forest-900 dark:text-forest-200",
  ranking: "bg-moss-100 text-moss-800 dark:bg-moss-900 dark:text-moss-200",
