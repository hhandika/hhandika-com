---

<figure class="bc-arch motion not-prose my-6" data-bc-arch>
  <div
    class="rounded-2xl border border-forest-900/10 bg-white/70 p-3 shadow-sm dark:border-forest-100/10 dark:bg-forest-950/40 sm:p-5"
  >
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div
        class="flex flex-wrap items-center gap-1.5"
        role="group"
        aria-label="Trace an example question"
      >
        <span
          class="mr-1 text-xs font-semibold text-forest-800 dark:text-forest-200"
          >Trace a question:</span
        >
        {
          traces.map((t) => (
            <button
              type="button"
              class="trace-button rounded-full border border-forest-900/15 px-2.5 py-1 text-xs text-forest-800 transition-colors hover:bg-forest-100 aria-pressed:border-forest-600 aria-pressed:bg-forest-600 aria-pressed:text-white dark:border-forest-100/20 dark:text-forest-100 dark:hover:bg-forest-900 dark:aria-pressed:border-forest-300 dark:aria-pressed:bg-forest-300 dark:aria-pressed:text-forest-950"
              data-trace={t.id}
              aria-pressed="false"
            >
              “{t.query}”
            </button>
          ))
        }
      </div>
      <MotionToggle />
    </div>
    {
      layouts.map((layout) => (
        <svg
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          class={`diagram w-full h-auto font-sans ${layout.class}`}
          role="group"
          aria-label="BioCosmos architecture: a Next.js site calls one FastAPI process in which an open-weight language model plans typed tool calls, filters run as SQL in the embedded DuckDB OLAP database, and ranking runs as vector search in the embedded LanceDB database, fed by offline harmonization pipelines"
        >
          {/* Connectors and packets sit under the boxes so data appears to pass through each layer. */}
          <g>
            <rect
              x={layout.boundary.x}
              y={layout.boundary.y}
              width={layout.boundary.w}
              height={layout.boundary.h}
              rx="20"
              fill="none"
              class="stroke-moss-400 dark:stroke-moss-600"
              stroke-width="1.25"
              stroke-dasharray="2 5"
              stroke-linecap="round"
            />
            <text
              x={layout.boundary.x + layout.boundary.w - 8}
              y={layout.boundary.ly}
              text-anchor="end"
              font-size={layout.name === "wide" ? 11 : 9.5}
              letter-spacing="0.08em"
              class="fill-moss-700 dark:fill-moss-300 font-semibold"
            >
              {layout.boundary.label}
            </text>
            {layout.edges.map((e) => (
              <g>
                <line
                  x1={e.x1}
                  y1={e.y1}
                  x2={e.x2}
                  y2={e.y2}
                  class={`flow ${lineClass}`}
                  stroke-width="1.75"
                />
                <polygon
                  points={arrowHead(e.x1, e.y1, e.x2, e.y2)}
                  class="fill-forest-400 dark:fill-forest-500"
                />
                {e.label && (
                  <text
                    x={e.lx ?? e.x1 + 12}
                    y={e.ly ?? (e.y1 + e.y2) / 2 + 4}
                    text-anchor={e.lx === undefined ? "start" : "middle"}
                    font-size={e.lx === undefined ? 11.5 : 10.5}
                    class={`${labelClass} italic`}
                  >
                    {e.label}
                  </text>
                )}
              </g>
            ))}
            {layout.packets.map((p) => (
              <g class={`packet ${packetClass[p.tone]}`}>
                <circle r="10" opacity="0.22" />
                <circle r="4.5" />
                <animateMotion
                  path={p.d}
                  dur={`${p.dur}s`}
                  begin={`-${p.begin}s`}
                  repeatCount="indefinite"
                />
              </g>
            ))}
          </g>

          {layout.placed.map((n) => (
            <g
              class="node"
              style={`--i:${n.i}`}
              data-node={n.id}
              data-title={n.title}
              data-desc={n.desc}
              tabindex="0"
              role="button"
              aria-label={`${n.title}. ${n.desc}`}
            >
              <rect
                x={n.x}
                y={n.y}
                width={n.w}
                height={n.h}
                rx="14"
                class={`box ${n.t.box}`}
                stroke-width="1.5"
              />
              <text
                x={n.x + (n.id === "app" ? 18 : 14)}
                y={n.y + (n.id === "app" ? 26 : 24)}
                font-size={
                  n.id === "app" ? 18 : layout.name === "wide" ? 15 : 14
                }
                class={`font-semibold ${n.t.title}`}
              >
                {n.text.title}
              </text>
              {n.text.path && (
                <text
                  x={n.x + 14}
                  y={n.y + 41}
                  font-size={layout.name === "wide" ? 11.5 : 10}
                  class={`font-mono ${n.t.muted}`}
                >
                  {n.text.path}
                </text>
              )}
              {n.text.sub && (
                <text
                  x={n.x + (n.id === "app" ? 18 : 14)}
                  y={n.y + (n.id === "app" ? 45 : 57)}
                  font-size={layout.name === "wide" ? 12 : 11}
                  class={n.t.muted}
                  opacity="0.9"
                >
                  {n.text.sub}
                </text>
              )}
              {n.badge && (
                <g>
                  <rect
                    x={n.x + n.w - n.badge.w - 12}
                    y={n.y + 11}
                    width={n.badge.w}
                    height="18"
                    rx="9"
                    class={n.t.badge}
                  />
                  <text
                    x={n.x + n.w - n.badge.w / 2 - 12}
                    y={n.y + 23.5}
                    text-anchor="middle"
                    font-size="9.5"
                    letter-spacing="0.06em"
                    class={`font-bold ${n.t.badgeText}`}
                  >
                    {n.badge.label}
                  </text>
                </g>
              )}
              {n.chips.map((c) => (
                <g>
                  <rect
                    x={c.x}
                    y={c.y}
                    width={c.w}
                    height="20"
                    rx="10"
                    class={n.t.chip}
                    stroke-width="1"
                  />
                  <text
                    x={c.x + c.w / 2}
                    y={c.y + 14}
                    text-anchor="middle"
                    font-size={layout.name === "wide" ? 11 : 10}
                    class={`font-mono ${n.t.chipText}`}
                  >
                    {c.label}
                  </text>
                </g>
              ))}
            </g>
          ))}

          <g class="legend" font-size={layout.name === "wide" ? 12 : 11}>
            {legendItems.map((item, k) => {
              const x = layout.legend.vertical
                ? layout.legend.x
                : layout.legend.x + [0, 120, 212][k];
              const y = layout.legend.vertical
                ? layout.legend.y + k * 24
                : layout.legend.y;
              return (
                <g>
                  <rect
                    x={x}
                    y={y - 10}
                    width="12"
                    height="12"
                    rx="3.5"
                    class={tones[item.tone].badge}
                  />
                  <text
                    x={x + 20}
                    y={y}
                    class="fill-forest-800 dark:fill-forest-200"
                  >
                    {layout.name === "wide"
                      ? item.label
                      : item.label.replace(" & tooling", "")}
                  </text>
                </g>
              );
            })}
            {layout.legend.vertical && (
              <text
                x={layout.legend.x}
                y={layout.legend.y + 3 * 24 + 4}
                class="fill-forest-600 dark:fill-forest-400 italic"
              >
                Moving dots trace a query.
              </text>
            )}
          </g>
        </svg>
      ))
    }

    {
      traces.map((t) => (
        <div
          class="trace-panel mt-4 hidden"
          data-trace-panel={t.id}
          data-nodes={t.nodes.join(" ")}
        >
          <ul
            class="flex flex-wrap gap-1.5"
            aria-label="Tool calls returned by the planner"
          >
            {t.calls.map((c) => (
              <li
                class={`max-w-full rounded-lg px-2 py-1 font-mono text-[0.7rem] [overflow-wrap:anywhere] ${callClass[c.kind]}`}
              >
                <span class="mr-1 font-sans font-semibold uppercase tracking-wider opacity-70">
                  {c.kind}
                </span>
                {c.call}
              </li>
            ))}
          </ul>
          <ol class="mt-3 gap-x-4 text-sm text-forest-800 dark:text-forest-200 sm:columns-2">
            {t.steps.map((s, k) => (
              <li
                class="trace-step mb-1.5 flex break-inside-avoid gap-2 rounded-lg px-2 py-1 outline-none transition-colors hover:bg-forest-100 focus-visible:bg-forest-100 dark:hover:bg-forest-900 dark:focus-visible:bg-forest-900"
                data-step-node={s.node}
                tabindex="0"
              >
                <span class="font-mono text-xs leading-5 text-moss-700 dark:text-moss-300">
                  {k + 1}
                </span>
                <span>{s.text}</span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
  <figcaption
    class="mx-auto mt-3 min-h-[3.5rem] max-w-3xl rounded-xl px-4 py-2 text-center text-sm text-forest-800 dark:text-forest-200"
    aria-live="polite"
  >
    <span class="caption-title font-semibold text-moss-700 dark:text-moss-300"
      >Hover, tap, or tab to a component</span
    >
    <span class="caption-desc">
      to see what it does. The language model only plans; SQL filters and vector
      search do the work, inside one process.</span
    >
  </figcaption>
</figure>

<style>
  .flow {
    stroke-dasharray: 4 5;
    animation: flow 3s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -9;
    }
  }
  .node {
    cursor: pointer;
    outline: none;
    transition: opacity 0.25s ease;
    animation: rise 0.6s ease-out backwards;
    animation-delay: calc(var(--i) * 80ms);
  }
  .node .box {
    transition:
      stroke-width 0.2s ease,
      filter 0.2s ease;
  }
  .node:hover .box,
  .node:focus-visible .box,
  .node.is-active .box,
  .node.in-trace .box {
    stroke-width: 3;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.12));
  }
  .diagram.has-trace .node:not(.in-trace) {
    opacity: 0.3;
  }
  .diagram.has-active .node:not(.is-active) {
    opacity: 0.45;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow,
    .node {
      animation: none;
    }
    .packet {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-bc-arch]").forEach((root) => {
    const title = root.querySelector(".caption-title")!;
    const desc = root.querySelector(".caption-desc")!;
    const nodes = root.querySelectorAll<SVGGElement>(".node");
    const diagrams = root.querySelectorAll(".diagram");
    const buttons = root.querySelectorAll<HTMLButtonElement>(".trace-button");
    const panels = root.querySelectorAll<HTMLElement>(".trace-panel");

    const activate = (id: string | null) => {
      nodes.forEach((n) =>
        n.classList.toggle("is-active", n.dataset.node === id),
      );
      diagrams.forEach((svg) =>
        svg.classList.toggle("has-active", id !== null),
      );
      const node = [...nodes].find((n) => n.dataset.node === id);
      if (node) {
        title.textContent = node.dataset.title ?? "";
        desc.textContent = ` — ${node.dataset.desc}`;
      }
    };

    // Highlight the components one example question passes through.
    const trace = (id: string | null) => {
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.trace === id)),
      );
      let path: string[] = [];
      panels.forEach((p) => {
        const on = p.dataset.tracePanel === id;
        p.classList.toggle("hidden", !on);
        if (on) path = (p.dataset.nodes ?? "").split(" ");
      });
      nodes.forEach((n) =>
        n.classList.toggle("in-trace", path.includes(n.dataset.node!)),
      );
      diagrams.forEach((svg) => svg.classList.toggle("has-trace", id !== null));
      activate(null);
    };

    nodes.forEach((n) => {
      n.addEventListener("mouseenter", () => activate(n.dataset.node!));
      n.addEventListener("focus", () => activate(n.dataset.node!));
      n.addEventListener("click", () => activate(n.dataset.node!));
      n.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activate(n.dataset.node!);
        } else if (e.key === "Escape") activate(null);
      });
    });
    diagrams.forEach((svg) =>
      svg.addEventListener("mouseleave", () => activate(null)),
    );

    buttons.forEach((b) =>
      b.addEventListener("click", () =>
        trace(
          b.getAttribute("aria-pressed") === "true" ? null : b.dataset.trace!,
        ),
      ),
    );
    root.querySelectorAll<HTMLElement>(".trace-step").forEach((s) => {
      s.addEventListener("mouseenter", () => activate(s.dataset.stepNode!));
      s.addEventListener("focus", () => activate(s.dataset.stepNode!));
      s.addEventListener("mouseleave", () => activate(null));
      s.addEventListener("blur", () => activate(null));
    });
  });
</script>
