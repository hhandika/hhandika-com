---
// Animated NAHPU architecture, adapted from the nahpu-docs
// "Architecture" page (contributing/code/architecture).
// Two layouts share one node list: a wide one for md+ and a stacked one for
// phones. Hover, focus, or tap a layer to read what it does.
import { tones, wrapChips, arrowHead, lineClass, labelClass, packetClass, type Tone } from "./diagram";
import MotionToggle from "../MotionToggle.astro";

interface NodeText {
  title: string;
  path?: string;
  sub?: string;
  chips?: string[];
}

interface NodeDef extends NodeText {
  id: string;
  tone: Tone;
  badge?: string;
  desc: string;
}

const nodes: NodeDef[] = [
  {
    id: "app",
    tone: "app",
    title: "NAHPU app",
    sub: "Flutter + Dart UI · offline-first · one codebase",
    chips: ["iOS", "Android", "macOS", "Windows", "Linux"],
    desc: "One offline-first Flutter codebase ships to iOS, Android, macOS, Windows, and Linux through the official app stores.",
  },
  {
    id: "screens",
    tone: "dart",
    badge: "Dart",
    title: "Screens",
    path: "lib/screens/",
    sub: "Page-level UI",
    desc: "Screens render state, handle navigation, and connect controls to providers. They never own persistence or business workflows.",
  },
  {
    id: "shared",
    tone: "dart",
    badge: "Dart",
    title: "Shared widgets",
    path: "lib/screens/shared/",
    sub: "Reusable controls",
    desc: "Reusable widgets and controls shared across screens, so every form behaves the same way.",
  },
  {
    id: "providers",
    tone: "dart",
    badge: "Riverpod",
    title: "Providers",
    path: "lib/services/providers/",
    sub: "Riverpod providers and AsyncNotifiers",
    desc: "Riverpod providers expose application state with asynchronous loading and mutation, keeping screens thin.",
  },
  {
    id: "services",
    tone: "dart",
    badge: "Dart",
    title: "Services",
    path: "lib/services/",
    chips: ["database queries", "validation", "media", "maps", "transfers", "imports", "exports", "templates", "platform IO"],
    desc: "Domain workflows live here: database queries, validation, media, maps, project transfers, imports, exports, templates, and platform file IO.",
  },
  {
    id: "drift",
    tone: "data",
    badge: "SQLite",
    title: "Drift + SQLite",
    path: "lib/services/database/",
    sub: "Canonical project database",
    desc: "Drift over SQLite is the single source of truth for projects, specimens, sites, collecting events, personnel, taxonomy, media metadata, and narratives.",
  },
  {
    id: "bindings",
    tone: "dart",
    badge: "FRB",
    title: "Bridge bindings",
    path: "lib/src/rust/",
    sub: "Generated by flutter_rust_bridge",
    desc: "Dart bindings generated from the Rust wrapper crate by flutter_rust_bridge. They are never hand-edited.",
  },
  {
    id: "storage",
    tone: "data",
    badge: "Device",
    title: "Local storage",
    path: "nahpu.db · media · backups",
    sub: "Works without a network",
    desc: "Records, media, and backups stay on the device, so the app behaves deterministically in the field without reliable internet.",
  },
  {
    id: "wrappers",
    tone: "rust",
    badge: "Rust",
    title: "Rust wrappers",
    path: "rust/src/api/",
    sub: "Thin, bridge-facing layer",
    desc: "A deliberately thin Rust layer that adapts Dart-friendly values and errors to the reusable crates.",
  },
  {
    id: "crates",
    tone: "rust",
    badge: "Rust",
    title: "NAHPU API workspace",
    path: "nahpu_api · reusable crates",
    chips: ["archive", "configs", "db", "dp", "dwc", "export", "gis"],
    desc: "Reusable Rust crates: ZIP/tar archives, reproducible configs, Darwin Core and Data Package export, Typst-to-PDF documents, and GIS conversion.",
  },
];

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
  text?: Partial<NodeText>;
}

interface Layout {
  name: string;
  class: string;
  width: number;
  height: number;
  badges: boolean;
  chipCharW: number;
  boxes: Record<string, Box>;
  edges: { x1: number; y1: number; x2: number; y2: number; label?: string }[];
  boundary: { x1: number; x2: number; y: number };
  packets: { tone: Tone; d: string; dur: number; begin: number }[];
  legend: { x: number; y: number; vertical: boolean };
}

const L = 240; // left column centre (wide)
const R = 720; // right column centre (wide)
const wide: Layout = {
  name: "wide",
  class: "hidden md:block",
  width: 960,
  height: 716,
  badges: true,
  chipCharW: 6.4,
  boxes: {
    app: { x: 40, y: 16, w: 880, h: 60 },
    screens: { x: 40, y: 108, w: 400, h: 66 },
    shared: { x: 520, y: 108, w: 400, h: 66 },
    providers: { x: 40, y: 206, w: 880, h: 66 },
    services: { x: 40, y: 304, w: 880, h: 84 },
    drift: { x: 40, y: 420, w: 400, h: 66 },
    bindings: { x: 520, y: 420, w: 400, h: 66 },
    storage: { x: 40, y: 518, w: 400, h: 66 },
    wrappers: { x: 520, y: 518, w: 400, h: 66 },
    crates: { x: 520, y: 616, w: 400, h: 84 },
  },
  edges: [
    { x1: L, y1: 76, x2: L, y2: 108, label: "render & dispatch actions" },
    { x1: 440, y1: 141, x2: 520, y2: 141 },
    { x1: L, y1: 174, x2: L, y2: 206, label: "watch & update state" },
    { x1: L, y1: 272, x2: L, y2: 304, label: "call domain services" },
    { x1: L, y1: 388, x2: L, y2: 420, label: "Drift queries" },
    { x1: R, y1: 388, x2: R, y2: 420, label: "generated FRB calls" },
    { x1: L, y1: 486, x2: L, y2: 518, label: "canonical project data" },
    { x1: R, y1: 486, x2: R, y2: 518 },
    { x1: R, y1: 584, x2: R, y2: 616, label: "delegate reusable behavior" },
  ],
  boundary: { x1: 470, x2: 920, y: 502 },
  packets: [
    { tone: "dart", d: `M${L} 76 V518`, dur: 9, begin: 0 },
    { tone: "rust", d: `M${L} 76 V346 H${R} V616`, dur: 12, begin: 4 },
    { tone: "data", d: `M${L} 518 V174`, dur: 8, begin: 6 },
  ],
  legend: { x: 56, y: 624, vertical: true },
};

const l = 92; // left column centre (narrow)
const r = 268; // right column centre (narrow)
const narrow: Layout = {
  name: "narrow",
  class: "block md:hidden",
  width: 360,
  height: 800,
  badges: false,
  chipCharW: 6,
  boxes: {
    app: { x: 12, y: 12, w: 336, h: 84, text: { sub: "Flutter + Dart UI · offline-first" } },
    screens: { x: 12, y: 128, w: 160, h: 66 },
    shared: { x: 188, y: 128, w: 160, h: 66 },
    providers: { x: 12, y: 226, w: 336, h: 66 },
    services: {
      x: 12,
      y: 324,
      w: 336,
      h: 104,
      text: { chips: ["queries", "validation", "media", "maps", "transfers", "imports", "exports", "templates", "IO"] },
    },
    drift: { x: 12, y: 460, w: 160, h: 66, text: { sub: "Canonical store" } },
    bindings: { x: 188, y: 460, w: 160, h: 66, text: { title: "Bindings", sub: "Generated by FRB" } },
    storage: { x: 12, y: 558, w: 160, h: 66, text: { path: "nahpu.db · media", sub: "Works offline" } },
    wrappers: { x: 188, y: 558, w: 160, h: 66, text: { sub: "Thin bridge layer" } },
    crates: { x: 12, y: 656, w: 336, h: 104 },
  },
  edges: [
    { x1: l, y1: 96, x2: l, y2: 128 },
    { x1: 172, y1: 161, x2: 188, y2: 161 },
    { x1: l, y1: 194, x2: l, y2: 226 },
    { x1: l, y1: 292, x2: l, y2: 324 },
    { x1: l, y1: 428, x2: l, y2: 460 },
    { x1: r, y1: 428, x2: r, y2: 460 },
    { x1: l, y1: 526, x2: l, y2: 558 },
    { x1: r, y1: 526, x2: r, y2: 558 },
    { x1: r, y1: 624, x2: r, y2: 656 },
  ],
  boundary: { x1: 180, x2: 356, y: 542 },
  packets: [
    { tone: "dart", d: `M${l} 96 V558`, dur: 9, begin: 0 },
    { tone: "rust", d: `M${l} 96 V370 H${r} V656`, dur: 12, begin: 4 },
    { tone: "data", d: `M${l} 558 V194`, dur: 8, begin: 6 },
  ],
  legend: { x: 20, y: 782, vertical: false },
};

const legendItems: { tone: Tone; label: string }[] = [
  { tone: "dart", label: "Flutter / Dart" },
  { tone: "rust", label: "Rust" },
  { tone: "data", label: "On-device data" },
];

// Resolve text, badge width, and chip positions for each node in a layout.
function place(layout: Layout) {
  return nodes.map((n, i) => {
    const b = layout.boxes[n.id];
    const text: NodeText = { title: n.title, path: n.path, sub: n.sub, chips: n.chips, ...b.text };
    const t = tones[n.tone];
    const badge = layout.badges && n.badge ? { label: n.badge.toUpperCase(), w: Math.round(n.badge.length * 6.6 + 14) } : null;
    let chips = text.chips
      ? wrapChips(text.chips, b.x + 14, b.y + 50, b.w - 24, { charW: layout.chipCharW, rowH: 26 })
      : [];
    if (n.id === "app" && chips.length) {
      // Platform chips: right-aligned on wide, below the title on narrow.
      if (layout.name === "wide") {
        const last = chips[chips.length - 1];
        const shift = b.x + b.w - 16 - (last.x + last.w);
        chips = chips.map((c) => ({ ...c, x: c.x + shift, y: b.y + (b.h - 22) / 2 }));
      } else {
        chips = chips.map((c) => ({ ...c, y: b.y + 52 }));
      }
    }
    return { ...n, ...b, text, t, badge, chips, i };
  });
}

const layouts = [wide, narrow].map((layout) => ({ ...layout, placed: place(layout) }));
---

<figure class="arch motion not-prose my-6" data-arch>
  <div
    class="rounded-2xl border border-forest-900/10 bg-white/70 p-3 shadow-sm dark:border-forest-100/10 dark:bg-forest-950/40 sm:p-5"
  >
    <div class="mb-2 flex justify-end"><MotionToggle /></div>
    {
      layouts.map((layout) => (
        <svg
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          class={`diagram w-full h-auto font-sans ${layout.class}`}
          role="group"
          aria-label="NAHPU software architecture: Flutter screens, providers, and services over a Drift SQLite database and a Rust API bridged with flutter_rust_bridge"
        >
          {/* Connectors and packets sit under the boxes so data appears to pass through each layer. */}
          <g>
            {layout.edges.map((e) => (
              <g>
                <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class={`flow ${lineClass}`} stroke-width="1.75" />
                <polygon points={arrowHead(e.x1, e.y1, e.x2, e.y2)} class="fill-forest-400 dark:fill-forest-500" />
                {e.label && (
                  <text x={e.x1 + 12} y={(e.y1 + e.y2) / 2 + 4} font-size="11.5" class={`${labelClass} italic`}>
                    {e.label}
                  </text>
                )}
              </g>
            ))}
            <line
              x1={layout.boundary.x1}
              x2={layout.boundary.x2}
              y1={layout.boundary.y}
              y2={layout.boundary.y}
              class="stroke-moss-600 dark:stroke-moss-600"
              stroke-width="1.25"
              stroke-dasharray="2 5"
              stroke-linecap="round"
            />
            <text
              x={layout.boundary.x2 - 2}
              y={layout.boundary.y - 5}
              text-anchor="end"
              font-size={layout.name === "wide" ? 11 : 9.5}
              letter-spacing="0.08em"
              class="fill-moss-700 dark:fill-moss-300 font-semibold"
            >
              DART ⇄ RUST · FFI
            </text>
            {layout.packets.map((p) => (
              <g class={`packet ${packetClass[p.tone]}`}>
                <circle r="10" opacity="0.22" />
                <circle r="4.5" />
                <animateMotion path={p.d} dur={`${p.dur}s`} begin={`-${p.begin}s`} repeatCount="indefinite" />
              </g>
            ))}
          </g>

          {layout.placed.map((n) => (
            <g
              class="node"
              style={`--i:${n.i}`}
              data-node={n.id}
              data-title={n.title}
              data-desc={n.desc}
              tabindex="0"
              role="button"
              aria-label={`${n.title}. ${n.desc}`}
            >
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="14" class={`box ${n.t.box}`} stroke-width="1.5" />
              <text
                x={n.x + (n.id === "app" ? 18 : 14)}
                y={n.y + (n.id === "app" ? 26 : 24)}
                font-size={n.id === "app" ? 18 : layout.name === "wide" ? 15 : 14}
                class={`font-semibold ${n.t.title}`}
              >
                {n.text.title}
              </text>
              {n.text.path && (
                <text
                  x={n.x + 14}
                  y={n.y + 41}
                  font-size={layout.name === "wide" ? 11.5 : 10}
                  class={`font-mono ${n.t.muted}`}
                >
                  {n.text.path}
                </text>
              )}
              {n.text.sub && (
                <text
                  x={n.x + (n.id === "app" ? 18 : 14)}
                  y={n.y + (n.id === "app" ? 45 : 57)}
                  font-size={layout.name === "wide" ? 12 : 11}
                  class={n.t.muted}
                  opacity="0.9"
                >
                  {n.text.sub}
                </text>
              )}
              {n.badge && (
                <g>
                  <rect
                    x={n.x + n.w - n.badge.w - 12}
                    y={n.y + 11}
                    width={n.badge.w}
                    height="18"
                    rx="9"
                    class={n.t.badge}
                  />
                  <text
                    x={n.x + n.w - n.badge.w / 2 - 12}
                    y={n.y + 23.5}
                    text-anchor="middle"
                    font-size="9.5"
                    letter-spacing="0.06em"
                    class={`font-bold ${n.t.badgeText}`}
                  >
                    {n.badge.label}
                  </text>
                </g>
              )}
              {n.chips.map((c) => (
                <g>
                  <rect x={c.x} y={c.y} width={c.w} height="20" rx="10" class={n.t.chip} stroke-width="1" />
                  <text
                    x={c.x + c.w / 2}
                    y={c.y + 14}
                    text-anchor="middle"
                    font-size={layout.name === "wide" ? 11 : 10}
                    class={`font-mono ${n.t.chipText}`}
                  >
                    {c.label}
                  </text>
                </g>
              ))}
            </g>
          ))}

          <g class="legend" font-size={layout.name === "wide" ? 12 : 11}>
            {legendItems.map((item, k) => {
              const x = layout.legend.vertical ? layout.legend.x : layout.legend.x + [0, 124, 196][k];
              const y = layout.legend.vertical ? layout.legend.y + k * 24 : layout.legend.y;
              return (
                <g>
                  <rect x={x} y={y - 10} width="12" height="12" rx="3.5" class={tones[item.tone].swatch} />
                  <text x={x + 20} y={y} class="fill-forest-800 dark:fill-forest-200">
                    {item.label}
                  </text>
                </g>
              );
            })}
            {layout.legend.vertical && (
              <text x={layout.legend.x} y={layout.legend.y + 3 * 24 + 4} class="fill-forest-600 dark:fill-forest-400 italic">
                Moving dots trace data through the layers.
              </text>
            )}
          </g>
        </svg>
      ))
    }
  </div>
  <figcaption
    class="mx-auto mt-3 min-h-[3.5rem] max-w-3xl rounded-xl px-4 py-2 text-center text-sm text-forest-800 dark:text-forest-200"
    aria-live="polite"
  >
    <span class="caption-title font-semibold text-moss-700 dark:text-moss-300">Hover, tap, or tab to a layer</span>
    <span class="caption-desc"> to see what it does. Screens stay thin, workflows live in services, and heavy lifting goes to Rust.</span>
  </figcaption>
</figure>

<style>
  .flow {
    stroke-dasharray: 4 5;
    animation: flow 3s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -9;
    }
  }
  .node {
    cursor: pointer;
    outline: none;
    transition: opacity 0.25s ease;
    animation: rise 0.6s ease-out backwards;
    animation-delay: calc(var(--i) * 80ms);
  }
  .node .box {
    transition: stroke-width 0.2s ease, filter 0.2s ease;
  }
  .node:hover .box,
  .node:focus-visible .box,
  .node.is-active .box {
    stroke-width: 3;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.12));
  }
  .diagram.has-active .node:not(.is-active) {
    opacity: 0.45;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow,
    .node {
      animation: none;
    }
    .packet {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-arch]").forEach((root) => {
    const title = root.querySelector(".caption-title")!;
    const desc = root.querySelector(".caption-desc")!;
    const nodes = root.querySelectorAll<SVGGElement>(".node");

    const activate = (id: string | null) => {
      nodes.forEach((n) => n.classList.toggle("is-active", n.dataset.node === id));
      root.querySelectorAll(".diagram").forEach((svg) => svg.classList.toggle("has-active", id !== null));
      const node = [...nodes].find((n) => n.dataset.node === id);
      if (node) {
        title.textContent = node.dataset.title ?? "";
        desc.textContent = ` — ${node.dataset.desc}`;
      }
    };

    nodes.forEach((n) => {
      n.addEventListener("mouseenter", () => activate(n.dataset.node!));
      n.addEventListener("focus", () => activate(n.dataset.node!));
      n.addEventListener("click", () => activate(n.dataset.node!));
      n.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activate(n.dataset.node!);
        } else if (e.key === "Escape") activate(null);
      });
    });
    root.querySelectorAll(".diagram").forEach((svg) =>
      svg.addEventListener("mouseleave", () => activate(null)),
    );
  });
</script>
