---
// Proposed host–parasite study design: sampling and data generation, the four
// analyses, and the questions and outcomes they support. Hovering or focusing
// a question or outcome highlights the analyses it draws on.
import { seeded } from "./software/diagram";

// Host populations share one color across the PCA, phylogeny, and map.
const pops = [
  "fill-sky-500 dark:fill-sky-400",
  "fill-moss-500 dark:fill-moss-400",
  "fill-amber-500 dark:fill-amber-400",
];

const rand = seeded(11);
const jitter = (cx: number, cy: number, n: number, sx: number, sy: number) =>
  Array.from({ length: n }, () => ({
    x: cx + (rand() + rand() - 1) * sx,
    y: cy + (rand() + rand() - 1) * sy,
  }));

// A. PCA clusters, one per host population.
const pca = [
  [62, 34],
  [70, 78],
  [152, 56],
].flatMap(([cx, cy], g) =>
  jitter(cx, cy, 12, 22, 16).map((p) => ({ ...p, g })),
);

// B. Parasite tree; tips are colored by host population. Tip 4 sits in a
// clade otherwise found in population 3, a host switch.
const tipY = [12, 30, 48, 66, 84, 102];
const tipPop = [0, 0, 1, 2, 2, 2];
const tree = [
  // [node x, child y1, child y2, child x1, child x2]
  [112, tipY[0], tipY[1], 130, 130],
  [104, tipY[2], tipY[3], 130, 130],
  [100, tipY[4], tipY[5], 130, 130],
  [84, 21, 57, 112, 104],
  [44, 39, 93, 84, 100],
];
const treePath =
  tree.map(([x, y1, y2, c1, c2]) => `M${c1} ${y1}H${x}V${y2}H${c2}`).join("") +
  "M28 66H44";

// C. UMAP clusters of cell types.
const cellTypes = [
  {
    label: "Host immune",
    fill: "fill-sky-500 dark:fill-sky-400",
    dot: "bg-sky-500",
    at: [58, 30],
  },
  {
    label: "Host epithelial",
    fill: "fill-moss-500 dark:fill-moss-400",
    dot: "bg-moss-500",
    at: [122, 26],
  },
  {
    label: "Other host",
    fill: "fill-amber-500 dark:fill-amber-400",
    dot: "bg-amber-500",
    at: [52, 82],
  },
  {
    label: "Parasite",
    fill: "fill-rose-500 dark:fill-rose-400",
    dot: "bg-rose-500",
    at: [158, 64],
  },
  {
    label: "Infected host",
    fill: "fill-violet-500 dark:fill-violet-400",
    dot: "bg-violet-500",
    at: [112, 94],
  },
];
const umap = cellTypes.flatMap((c, k) =>
  jitter(c.at[0], c.at[1], 16, 18, 13).map((p) => ({ ...p, k })),
);

// D. Sampling sites on the terrain map.
const sites = [
  { x: 34, y: 34, g: 0 },
  { x: 46, y: 70, g: 1 },
  { x: 76, y: 52, g: 2 },
  { x: 82, y: 90, g: 2 },
];

// Small rodent glyph facing left, about 80 × 32 units.
const rodent = {
  body: "M14 20C14 10 26 5 38 6C50 7 58 14 57 22C56 29 46 31 34 31C22 31 14 28 14 20Z",
  head: "M21 12C13 10 5 15 1 21C6 24 14 25 21 23Z",
  tail: "M56 24C66 30 72 21 80 26",
};

const analyses = [
  {
    id: "host",
    letter: "A",
    title: "Host population genomics",
    text: "Host genetic structure and history",
  },
  {
    id: "parasite",
    letter: "B",
    title: "Parasite phylogenetics",
    text: "Parasite evolutionary relationships and host associations",
  },
  {
    id: "singlecell",
    letter: "C",
    title: "Single-cell transcriptomics",
    text: "Host and parasite cells, cell types, and infection states",
  },
  {
    id: "environment",
    letter: "D",
    title: "Environmental context",
    text: "Environmental drivers of host and parasite variation",
  },
];

const questions = [
  {
    text: "Do parasite lineages preferentially occupy particular host cell types?",
    uses: "parasite singlecell",
  },
  {
    text: "Do parasite lineages elicit different cellular responses in different host populations or species?",
    uses: "host parasite singlecell",
  },
  {
    text: "Do recently host-switched parasites show different cell-type tropism or transcriptional states from long-associated parasites?",
    uses: "host parasite singlecell",
  },
];

const outcomes = [
  {
    icon: "tree",
    text: "Test whether parasite diversification parallels host history or reflects host switching and local adaptation.",
    uses: "host parasite environment",
  },
  {
    icon: "cells",
    text: "Identify host cell types and immune pathways targeted by different parasite lineages.",
    uses: "parasite singlecell",
  },
  {
    icon: "landscape",
    text: "Link evolutionary patterns to environmental drivers and cellular mechanisms of infection.",
    uses: "singlecell environment",
  },
];

const dataTypes = [
  {
    icon: "dna",
    tone: "stroke-forest-600 dark:stroke-forest-300",
    title: "Host population genomics",
    text: "Whole genome or targeted sequencing",
  },
  {
    icon: "dna",
    tone: "stroke-amber-600 dark:stroke-amber-400",
    title: "Parasite genomics",
    text: "Phylogenies and population structure",
  },
  {
    icon: "cells",
    tone: "",
    title: "Single-cell or single-nucleus RNA-seq",
    text: "Host and parasite transcripts in infected tissues",
  },
  {
    icon: "globe",
    tone: "",
    title: "Environmental data",
    text: "Climate, land use, and altitude",
  },
];

const card = "rounded-2xl border p-3 sm:p-4";
const heading = "flex items-center gap-2 font-semibold";
const badge =
  "flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold";
const sectionLabel =
  "mb-2 mt-5 text-sm font-semibold uppercase tracking-widest text-forest-700 dark:text-forest-300";
const axis = "stroke-forest-400 dark:stroke-forest-500";
const axisText = "fill-forest-700 font-mono dark:fill-forest-300";
const line = "stroke-forest-400 dark:stroke-forest-500";
const callout =
  "fill-white stroke-forest-300 dark:fill-forest-900 dark:stroke-forest-600";
const rodentFill = "fill-mist-500 dark:fill-mist-400";
---

<figure class="study-design not-prose my-6">
  <div
    class="rounded-2xl border border-forest-900/10 bg-white/70 p-3 shadow-sm dark:border-forest-100/10 dark:bg-forest-950/40 sm:p-5"
  >
    <p class={`${sectionLabel} mt-0`}>Sampling and data</p>
    <ol
      class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr]"
    >
      <li
        class={`${card} border-moss-200 bg-moss-50 dark:border-moss-900 dark:bg-moss-950/50`}
      >
        <p class={`${heading} text-moss-900 dark:text-moss-50`}>
          <span
            class={`${badge} bg-moss-600 text-white dark:bg-moss-400 dark:text-moss-950`}
            >1</span
          >Field collection
        </p>
        <svg
          viewBox="0 0 200 110"
          class="my-2 h-auto w-full"
          aria-hidden="true"
        >
          <path
            d="M70 58L116 32M70 58L160 56"
            fill="none"
            stroke-width="1.25"
            stroke-dasharray="3 3"
            class={line}></path>
          <g transform="translate(8 50) scale(1.45)">
            <path
              d={rodent.tail}
              fill="none"
              stroke-width="2.2"
              stroke-linecap="round"
              class="stroke-mist-500 dark:stroke-mist-400"></path>
            <path d={rodent.body} class={rodentFill}></path>
            <path d={rodent.head} class={rodentFill}></path>
            <circle
              cx="19"
              cy="10"
              r="4.5"
              class="fill-mist-400 dark:fill-mist-300"></circle>
            <circle cx="8" cy="17" r="1.2" class="fill-forest-950"></circle>
          </g>
          <circle cx="132" cy="28" r="18" stroke-width="1.5" class={callout}
          ></circle>
          <path
            d="M132 17C137 24 140 28 140 32A8 8 0 0 1 124 32C124 28 127 24 132 17Z"
            class="fill-rose-600 dark:fill-rose-500"></path>
          <circle cx="176" cy="58" r="18" stroke-width="1.5" class={callout}
          ></circle>
          <path
            d="M165 66C168 52 174 70 178 56S186 50 188 52"
            fill="none"
            stroke-width="3.5"
            stroke-linecap="round"
            class="stroke-amber-600 dark:stroke-amber-400"></path>
        </svg>
        <p class="text-sm text-moss-900 dark:text-moss-100">
          Collect host specimens and associated parasites with environmental
          metadata (location, habitat, climate).
        </p>
      </li>

      <li class="hidden items-center lg:flex" aria-hidden="true">
        <svg viewBox="0 0 16 16" class="h-5 w-5 text-forest-500"
          ><path
            d="M2 8h11M9 4l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </li>

      <li
        class={`${card} border-mist-200 bg-mist-50 dark:border-mist-800 dark:bg-mist-950/50`}
      >
        <p class={`${heading} text-mist-900 dark:text-mist-50`}>
          <span
            class={`${badge} bg-mist-600 text-white dark:bg-mist-300 dark:text-mist-950`}
            >2</span
          >Sample processing
        </p>
        <svg
          viewBox="0 0 200 110"
          class="my-2 h-auto w-full"
          aria-hidden="true"
        >
          <rect
            x="16"
            y="8"
            width="30"
            height="13"
            rx="3"
            class="fill-amber-500 dark:fill-amber-400"></rect>
          <path
            d="M19 21H43V86A12 12 0 0 1 19 86Z"
            stroke-width="1.5"
            class="fill-white stroke-mist-400 dark:fill-mist-900 dark:stroke-mist-500"
          ></path>
          <path
            d="M19 58H43V86A12 12 0 0 1 19 86Z"
            class="fill-rose-100 dark:fill-rose-950"></path>
          <ellipse
            cx="29"
            cy="72"
            rx="6"
            ry="5"
            class="fill-rose-400 dark:fill-rose-500"></ellipse>
          <ellipse
            cx="34"
            cy="86"
            rx="5"
            ry="4.5"
            class="fill-rose-500 dark:fill-rose-600"></ellipse>
          <g fill="none" stroke-width="1.5" stroke-linecap="round" class={line}>
            <path d="M52 44C62 26 72 20 90 20"></path>
            <path d="M52 56H90"></path>
            <path d="M52 68C62 86 72 92 90 92"></path>
          </g>
          <g class="fill-forest-400 dark:fill-forest-500">
            <polygon points="92,20 86,17 86,23"></polygon>
            <polygon points="92,56 86,53 86,59"></polygon>
            <polygon points="92,92 86,89 86,95"></polygon>
          </g>
          <ellipse
            cx="106"
            cy="20"
            rx="8"
            ry="6.5"
            class="fill-rose-400 dark:fill-rose-500"></ellipse>
          <path
            d="M98 61C101 50 106 64 110 53S114 50 116 51"
            fill="none"
            stroke-width="2.5"
            stroke-linecap="round"
            class="stroke-amber-600 dark:stroke-amber-400"></path>
          <g class="fill-mist-500 dark:fill-mist-300">
            <path d="M98 86H110L116 92L110 98H98Z"></path>
          </g>
          <g font-size="12" class="fill-mist-900 dark:fill-mist-100">
            <text x="122" y="24">Host tissue</text>
            <text x="122" y="60">Parasites</text>
            <text x="122" y="96">Metadata</text>
          </g>
        </svg>
        <p class="text-sm text-mist-900 dark:text-mist-100">
          Host tissue for genomics and single-cell, parasites for genomics and
          transcriptomics, and host and parasite IDs.
        </p>
      </li>

      <li class="hidden items-center lg:flex" aria-hidden="true">
        <svg viewBox="0 0 16 16" class="h-5 w-5 text-forest-500"
          ><path
            d="M2 8h11M9 4l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </li>

      <li
        class={`${card} border-forest-200 bg-forest-50 dark:border-forest-800 dark:bg-forest-950/60`}
      >
        <p class={`${heading} text-forest-900 dark:text-forest-50`}>
          <span
            class={`${badge} bg-forest-600 text-white dark:bg-forest-300 dark:text-forest-950`}
            >3</span
          >Data generation
        </p>
        <ul class="mt-3 space-y-2.5">
          {
            dataTypes.map((d) => (
              <li class="flex gap-2.5">
                <svg
                  viewBox="0 0 24 24"
                  class="h-7 w-7 shrink-0"
                  aria-hidden="true"
                >
                  {d.icon === "dna" && (
                    <g
                      fill="none"
                      stroke-width="2"
                      stroke-linecap="round"
                      class={d.tone}
                    >
                      <path d="M7 2C17 8 7 16 17 22M17 2C7 8 17 16 7 22" />
                      <path d="M9 5H15M10 12H14M9 19H15" stroke-width="1.25" />
                    </g>
                  )}
                  {d.icon === "cells" && (
                    <g>
                      <circle
                        cx="7"
                        cy="8"
                        r="4.5"
                        class="fill-sky-500 dark:fill-sky-400"
                      />
                      <circle
                        cx="17"
                        cy="7"
                        r="4"
                        class="fill-violet-500 dark:fill-violet-400"
                      />
                      <circle
                        cx="9"
                        cy="18"
                        r="4"
                        class="fill-rose-500 dark:fill-rose-400"
                      />
                      <circle
                        cx="18"
                        cy="17"
                        r="4.5"
                        class="fill-moss-500 dark:fill-moss-400"
                      />
                    </g>
                  )}
                  {d.icon === "globe" && (
                    <g>
                      <circle
                        cx="12"
                        cy="12"
                        r="10"
                        class="fill-sky-500 dark:fill-sky-600"
                      />
                      <path
                        d="M5 8C8 6 10 8 9 11S5 13 4 12ZM13 4C17 5 20 9 19 12C16 13 15 10 13 9S12 5 13 4ZM12 15C15 14 17 16 15 20C13 20 11 18 12 15Z"
                        class="fill-moss-400 dark:fill-moss-300"
                      />
                    </g>
                  )}
                </svg>
                <span class="text-sm">
                  <span class="block font-semibold leading-tight text-forest-900 dark:text-forest-50">
                    {d.title}
                  </span>
                  <span class="block text-xs text-forest-700 dark:text-forest-300">
                    {d.text}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </li>

      <li class="hidden items-center lg:flex" aria-hidden="true">
        <svg viewBox="0 0 16 16" class="h-5 w-5 text-forest-500"
          ><path
            d="M2 8h11M9 4l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </li>

      <li
        class={`${card} border-forest-700 bg-forest-700 text-white dark:border-forest-600 dark:bg-forest-800`}
      >
        <p class={heading}>
          <span class={`${badge} bg-moss-400 text-moss-950`}>4</span>Linked in
          NAHPU
        </p>
        <svg viewBox="0 0 200 64" class="my-2 h-auto w-full" aria-hidden="true">
          <g class="fill-forest-500 stroke-forest-300" stroke-width="1.5">
            <path d="M14 14V50A20 7 0 0 0 54 50V14"></path>
            <ellipse cx="34" cy="14" rx="20" ry="7" class="fill-forest-400"
            ></ellipse>
          </g>
          <path
            d="M14 26A20 7 0 0 0 54 26M14 38A20 7 0 0 0 54 38"
            fill="none"
            stroke-width="1.5"
            class="stroke-forest-300"></path>
          <text
            x="66"
            y="42"
            font-size="26"
            class="fill-white font-bold tracking-wide">NAHPU</text
          >
        </svg>
        <ul
          class="list-disc space-y-1 pl-4 text-sm text-forest-50 marker:text-moss-300"
        >
          <li>
            Links each parasite to its host specimen and collection metadata
          </li>
          <li>Tracks screening results, sequencing data, and tissue use</li>
          <li>
            Maintains the chain from field specimen → molecular data → analyses
          </li>
        </ul>
      </li>
    </ol>

    <p class={sectionLabel}>Analyses</p>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        analyses.map((a) => (
          <li
            class={`analysis ${card} border-forest-900/10 bg-white transition duration-300 data-[dim=true]:opacity-35 motion-reduce:transition-none dark:border-forest-100/10 dark:bg-forest-950`}
            data-analysis={a.id}
          >
            <p class="font-semibold text-forest-900 dark:text-forest-50">
              <span class="text-moss-700 dark:text-moss-300">{a.letter}.</span>{" "}
              {a.title}
            </p>
            <p class="text-xs text-forest-700 dark:text-forest-300">{a.text}</p>
            <svg
              viewBox="0 0 200 120"
              class="mt-2 h-auto w-full"
              aria-hidden="true"
            >
              {a.id === "host" && (
                <g>
                  <path
                    d="M24 6V102H192"
                    fill="none"
                    stroke-width="1.25"
                    class={axis}
                  />
                  <text
                    x="108"
                    y="116"
                    font-size="10"
                    text-anchor="middle"
                    class={axisText}
                  >
                    PC1
                  </text>
                  <text
                    transform="translate(14 54) rotate(-90)"
                    font-size="10"
                    text-anchor="middle"
                    class={axisText}
                  >
                    PC2
                  </text>
                  {pca.map((p) => (
                    <circle
                      cx={p.x.toFixed(1)}
                      cy={p.y.toFixed(1)}
                      r="3.6"
                      class={pops[p.g]}
                    />
                  ))}
                </g>
              )}
              {a.id === "parasite" && (
                <g>
                  <path
                    d={treePath}
                    fill="none"
                    stroke-width="1.75"
                    class="stroke-forest-700 dark:stroke-forest-200"
                  />
                  {tipY.map((y, i) => (
                    <g>
                      <circle cx="134" cy={y} r="4.5" class={pops[tipPop[i]]} />
                      <g transform={`translate(146 ${y - 7}) scale(0.5)`}>
                        <path
                          d={rodent.tail}
                          fill="none"
                          stroke-width="3"
                          stroke-linecap="round"
                          class="stroke-mist-600 dark:stroke-mist-300"
                        />
                        <path
                          d={rodent.body}
                          class="fill-mist-600 dark:fill-mist-300"
                        />
                        <path
                          d={rodent.head}
                          class="fill-mist-600 dark:fill-mist-300"
                        />
                      </g>
                    </g>
                  ))}
                </g>
              )}
              {a.id === "singlecell" && (
                <g>
                  <path
                    d="M14 6V110H192"
                    fill="none"
                    stroke-width="1.25"
                    class={axis}
                  />
                  {umap.map((p) => (
                    <circle
                      cx={p.x.toFixed(1)}
                      cy={p.y.toFixed(1)}
                      r="2.8"
                      class={cellTypes[p.k].fill}
                    />
                  ))}
                </g>
              )}
              {a.id === "environment" && (
                <g>
                  <rect
                    x="8"
                    y="8"
                    width="100"
                    height="104"
                    rx="8"
                    class="fill-moss-100 dark:fill-moss-950"
                  />
                  <g
                    fill="none"
                    stroke-width="1.25"
                    class="stroke-moss-400 dark:stroke-moss-700"
                  >
                    <path d="M20 96C30 70 24 40 50 24S96 30 98 60 76 104 52 102 14 112 20 96Z" />
                    <path d="M34 84C40 64 36 46 54 38S84 44 84 62 70 92 54 90 30 96 34 84Z" />
                    <path d="M48 72C50 60 50 54 58 52S72 56 70 66 62 80 54 78 46 80 48 72Z" />
                  </g>
                  <path
                    d="M66 8C64 30 80 40 74 64S88 96 84 112"
                    fill="none"
                    stroke-width="2.5"
                    class="stroke-sky-400 dark:stroke-sky-600"
                  />
                  {sites.map((s) => (
                    <circle
                      cx={s.x}
                      cy={s.y}
                      r="5"
                      stroke-width="1.5"
                      class={`${pops[s.g]} stroke-white dark:stroke-forest-950`}
                    />
                  ))}
                  <path
                    d="M128 30L190 22L190 46L128 54Z"
                    class="fill-amber-400/90 dark:fill-amber-500/80"
                  />
                  <path
                    d="M128 58L190 50L190 74L128 82Z"
                    class="fill-moss-400/90 dark:fill-moss-500/80"
                  />
                  <path
                    d="M128 86L190 78L190 102L128 110Z"
                    class="fill-sky-400/90 dark:fill-sky-500/80"
                  />
                  <g font-size="9" class="fill-forest-950" text-anchor="middle">
                    <text x="159" y="42" transform="rotate(-7 159 42)">
                      Climate
                    </text>
                    <text x="159" y="70" transform="rotate(-7 159 70)">
                      Vegetation
                    </text>
                    <text x="159" y="98" transform="rotate(-7 159 98)">
                      Altitude
                    </text>
                  </g>
                </g>
              )}
            </svg>
            {a.id === "singlecell" && (
              <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-[0.7rem] text-forest-800 dark:text-forest-200">
                {cellTypes.map((c) => (
                  <li class="flex items-center gap-1">
                    <span class={`h-2 w-2 rounded-full ${c.dot}`} />
                    {c.label}
                  </li>
                ))}
              </ul>
            )}
            {(a.id === "host" || a.id === "environment") && (
              <ul class="mt-1 flex flex-wrap gap-x-3 text-[0.7rem] text-forest-800 dark:text-forest-200">
                {["bg-sky-500", "bg-moss-500", "bg-amber-500"].map((dot, i) => (
                  <li class="flex items-center gap-1">
                    <span class={`h-2 w-2 rounded-full ${dot}`} />
                    Population {i + 1}
                  </li>
                ))}
              </ul>
            )}
            {a.id === "parasite" && (
              <p class="mt-1 text-[0.7rem] text-forest-800 dark:text-forest-200">
                Tips colored by host population
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-5 grid gap-3 lg:grid-cols-[1fr_auto_1fr]">
      <div
        class={`${card} border-mist-200 bg-mist-50 dark:border-mist-800 dark:bg-mist-950/50`}
      >
        <p class="font-semibold text-mist-900 dark:text-mist-50">
          Key questions
        </p>
        <ol class="mt-2 space-y-1">
          {
            questions.map((q, i) => (
              <li
                class="highlighter flex gap-3 rounded-xl p-2 text-sm text-mist-900 outline-none transition-colors hover:bg-mist-100 focus-visible:bg-mist-100 focus-visible:ring-2 focus-visible:ring-mist-400 dark:text-mist-50 dark:hover:bg-mist-900 dark:focus-visible:bg-mist-900"
                data-uses={q.uses}
                tabindex="0"
              >
                <span
                  class={`${badge} h-7 w-7 bg-mist-600 text-sm text-white dark:bg-mist-300 dark:text-mist-950`}
                >
                  {i + 1}
                </span>
                {q.text}
              </li>
            ))
