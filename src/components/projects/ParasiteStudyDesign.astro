</figure>

<script>
  document.querySelectorAll<HTMLElement>(".study-design").forEach((root) => {
    const analyses = [...root.querySelectorAll<HTMLElement>(".analysis")];
    const highlight = (uses?: string[]) =>
      analyses.forEach(
        (a) =>
          (a.dataset.dim = String(
            !!uses && !uses.includes(a.dataset.analysis!),
          )),
      );

    root.querySelectorAll<HTMLElement>(".highlighter").forEach((el) => {
      const uses = el.dataset.uses!.split(" ");
      el.addEventListener("mouseenter", () => highlight(uses));
      el.addEventListener("focus", () => highlight(uses));
      el.addEventListener("mouseleave", () => highlight());
      el.addEventListener("blur", () => highlight());
    });
  });
</script>
