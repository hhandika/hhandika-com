---
import myCv from "../assets/docs/hhandika-cv.pdf";
import LinkIcons from "./svg/LinkIcons.astro";
import cntl from "cntl";

const socialMediaClasses = cntl`
  flex
  justify-center
  mt-5
  gap-3
`;

const linkClasses = cntl`
  flex
  h-11
  w-11
  items-center
  justify-center
  rounded-full
  border
  border-forest-900/15
  bg-white/70
  text-forest-700
  transition
  hover:-translate-y-0.5
  hover:border-moss-400
  hover:text-moss-700
  dark:border-forest-100/15
  dark:bg-forest-950/60
  dark:text-forest-200
  dark:hover:text-moss-300
`;

const socialMediaData = [
  {
    name: "GitHub",
    url: "https://github.com/hhandika",
    alt: "Open my GitHub profile",
    icon: "github",
  },
  {
    name: "Google Scholar",
    url: "https://scholar.google.com/citations?user=Jaub_M0AAAAJ&hl=en",
    alt: "Open my Google Scholar profile",
    icon: "scholar",
  },
  {
    name: "LinkTree",
    url: "https://linktr.ee/hhandika",
    alt: "Open my LinkTree profile",
    icon: "linktree",
  },
  {
    name: "Mail",
    url: "mailto:" + "hhandi1" + "@" + "lsu.edu",
    alt: "Send me an email",
    icon: "mail",
  },
  {
    name: "CV",
    url: myCv,
    alt: "Download my CV",
    icon: "cv",
  },
] as const;

// The outer tips align to their icon's edge so they stay on screen when the
// row sits against the page edge.
const tipAlign = (i: number) =>
  i === 0 ? "left-0" : i === socialMediaData.length - 1 ? "right-0" : "left-1/2 -translate-x-1/2";
---

<div class={socialMediaClasses}>
  {
    socialMediaData.map((item, i) => (
      <div class="group relative">
        <a
          href={item.url}
          target="_blank"
          rel="noopener"
          aria-label={item.alt}
          class={linkClasses}
        >
          <LinkIcons name={item.icon} />
        </a>
        {/* The link already has an aria-label, so the visual tip is hidden from screen readers. */}
        <span
          class={`pointer-events-none absolute top-full z-10 mt-2 whitespace-nowrap ${tipAlign(i)} rounded-md bg-forest-900 px-2 py-1 text-xs text-forest-50 opacity-0 shadow-md transition-opacity duration-200 group-focus-within:opacity-100 group-hover:opacity-100 motion-reduce:transition-none dark:bg-forest-100 dark:text-forest-950`}
          aria-hidden="true"
        >
          {item.alt}
        </span>
      </div>
    ))
  }
</div>
