---
import myCv from "../assets/docs/hhandika-cv.pdf";
import LinkIcons from "./svg/LinkIcons.astro";
import cntl from "cntl";

const socialMediaClasses = cntl`
  flex
  justify-center
  mt-5
  gap-3
`;

const linkClasses = cntl`
  flex
  h-11
  w-11
  items-center
  justify-center
  rounded-full
  border
  border-forest-900/15
  bg-white/70
  text-forest-700
  transition
  hover:-translate-y-0.5
  hover:border-moss-400
  hover:text-moss-700
  dark:border-forest-100/15
  dark:bg-forest-950/60
  dark:text-forest-200
  dark:hover:text-moss-300
`;

const socialMediaData = [
  {
    name: "GitHub",
    url: "https://github.com/hhandika",
    alt: "Open my GitHub profile",
    icon: "github",
  },
  {
    name: "Google Scholar",
    url: "https://scholar.google.com/citations?user=Jaub_M0AAAAJ&hl=en",
    alt: "Open my Google Scholar profile",
    icon: "scholar",
  },
  {
    name: "LinkTree",
    url: "https://linktr.ee/hhandika",
    alt: "Open my LinkTree profile",
    icon: "linktree",
  },
  {
    name: "Mail",
    url: "mailto:" + "hhandi1" + "@" + "lsu.edu",
    alt: "Send me an email",
    icon: "mail",
  },
  {
    name: "CV",
    url: myCv,
    alt: "Download my CV",
    icon: "cv",
  },
] as const;
---

<div class={socialMediaClasses}>
  {
    socialMediaData.map((item) => (
      <div class="tooltip tooltip-bottom" data-tip={item.alt}>
        <a
          href={item.url}
          target="_blank"
          rel="noopener"
          aria-label={item.alt}
          class={linkClasses}
        >
          <LinkIcons name={item.icon} />
        </a>
      </div>
    ))
  }
</div>
