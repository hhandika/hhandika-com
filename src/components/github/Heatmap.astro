---
import { formatDay, levelOf, type Activity } from "../../scripts/github-activity";

interface Props {
  activity: Activity;
  /** Cell shape: square GitHub-style tiles or round dots. */
  shape?: "square" | "dot";
  showLabels?: boolean;
  class?: string;
}

const { activity, shape = "square", showLabels = true, class: className } = Astro.props;

const cell = 11;
const gap = 3;
const step = cell + gap;
const left = showLabels ? 28 : 0;
const top = showLabels ? 16 : 0;
const width = left + activity.weeks.length * step - gap;
const height = top + 7 * step - gap;

const levels = [
  "fill-mist-200 dark:fill-forest-800",
  "fill-moss-200 dark:fill-moss-900",
  "fill-moss-400 dark:fill-moss-700",
  "fill-moss-600 dark:fill-moss-500",
  "fill-forest-800 dark:fill-moss-300",
];
const radius = shape === "dot" ? cell / 2 : 2.5;
const label = `Contribution heatmap: ${activity.total.toLocaleString("en")} contributions on ${activity.activeDays} of ${activity.days.length} days in the past year; busiest day ${formatDay(activity.best.date)} with ${activity.best.count}.`;
---

<figure class={className}>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="block h-auto w-full"
    role="img"
    aria-label={label}
  >
    {
      showLabels &&
        activity.monthLabels.map((m) => (
          <text
            x={left + m.col * step}
            y={10}
            font-size="9" class="fill-slate-500 dark:fill-slate-400"
          >
            {m.label}
          </text>
        ))
    }
    {
      showLabels &&
        [
          [1, "Mon"],
          [3, "Wed"],
          [5, "Fri"],
        ].map(([row, name]) => (
          <text
            x={0}
            y={top + Number(row) * step + cell - 2}
            font-size="9" class="fill-slate-500 dark:fill-slate-400"
          >
            {name}
          </text>
        ))
    }
    {
      activity.weeks.map((week, col) =>
        week.map(
          (d, row) =>
            d && (
              <rect
                x={left + col * step}
                y={top + row * step}
                width={cell}
                height={cell}
                rx={radius}
                class={levels[levelOf(d.count, activity.thresholds)]}
              >
                <title>
                  {d.count} contributions · {formatDay(d.date)}
                </title>
              </rect>
            ),
        ),
      )
    }
  </svg>
  <figcaption
    class="mt-2 flex items-center justify-end gap-1.5 text-xs text-slate-600 dark:text-slate-400"
  >
    Less
    {
      levels.map((c) => (
        <svg viewBox="0 0 11 11" class="h-2.5 w-2.5" aria-hidden="true">
          <rect width="11" height="11" rx={radius} class={c} />
        </svg>
      ))
    }
    More
  </figcaption>
</figure>
