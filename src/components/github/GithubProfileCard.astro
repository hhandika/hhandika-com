---
// Landing-page teaser for the software page: a thin language bar, one line of
// totals, and the main apps. The full code activity lives on /software.
import {
  languageBarHtml,
  languageNames,
  loadStats,
  topLanguages,
} from "../../scripts/github-stats";
import LiveStat from "./LiveStat.astro";
import LiveStatsScript from "./LiveStatsScript.astro";

const stats = await loadStats();

const apps = ["SEGUL", "NAHPU", "ULLAR", "MDD app"];
---

<a
  href="/software"
  class="group block w-full rounded-3xl border border-forest-900/10 bg-white/80 p-5 text-left shadow-xl shadow-forest-900/5 backdrop-blur transition hover:border-moss-400/60 dark:border-forest-100/10 dark:bg-forest-950/60 sm:p-6"
>
  <div
    class="[&>div]:h-1.5"
    data-gh-languages="5"
    data-gh-legend="false"
    set:html={languageBarHtml(topLanguages(stats, 5), false)}
  />
  <p class="mt-4 text-forest-950 dark:text-forest-50">
    <strong
      class="text-2xl font-semibold tabular-nums text-moss-800 dark:text-moss-200"
      ><LiveStat path="code_changes.totals.commits" /></strong
    > commits across <strong
      class="font-semibold tabular-nums text-moss-800 dark:text-moss-200"
      ><LiveStat path="overview.total_repositories" /></strong
    > open-source repositories
  </p>
  <p class="mt-1 text-sm text-forest-700 dark:text-forest-200">
    <span data-gh-language-names="4">{languageNames(stats, 4)}</span> · updated daily
  </p>
  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Main software">
    {
      apps.map((app) => (
        <li class="rounded-full bg-forest-100 px-3 py-0.5 text-sm font-medium text-forest-800 dark:bg-forest-800 dark:text-forest-100">
          {app}
        </li>
      ))
    }
  </ul>
  <span
    class="mt-4 block text-sm font-semibold text-forest-700 group-hover:underline dark:text-forest-200"
  >
    Explore my software →
  </span>
</a>
<LiveStatsScript />
