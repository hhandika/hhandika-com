---
// Simplified monochrome store glyphs; they inherit the text color.
interface Props {
  store: string;
  class?: string;
}

const { store, class: className = "h-5 w-5" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  {
    store === "apple" && (
      <path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.8zM14.1 5.8c.6-.8 1.1-1.8 1-2.8-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.7-1 2.7 1 .1 2-.5 2.7-1.3z" />
    )
  }
  {
    store === "google" && (
      <path d="M5 2.6v18.8c0 .7.8 1.1 1.4.7l15-9.4a.8.8 0 0 0 0-1.4L6.4 1.9C5.8 1.5 5 1.9 5 2.6z" />
    )
  }
  {
    store === "microsoft" && (
      <>
        <rect x="3" y="3" width="8.5" height="8.5" />
        <rect x="12.5" y="3" width="8.5" height="8.5" />
        <rect x="3" y="12.5" width="8.5" height="8.5" />
        <rect x="12.5" y="12.5" width="8.5" height="8.5" />
      </>
    )
  }
  {
    store === "snap" && (
      <>
        <polygon points="3,3 15,3 10.5,10" />
        <polygon points="10.5,11.5 21,14.5 8,21" />
      </>
    )
  }
</svg>
