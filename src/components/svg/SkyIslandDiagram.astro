---
/**
 * Schematic north–south profile through the four mountains of Sulawesi's
 * central core, spaced by their real distances. Dots follow the Bunomys-clade
 * elevation data (src/data/bunomys-elevation.json): the widespread
 * T. dominator occurs on all four, while montane haplogroups are confined to
 * one or two summits. On scroll into view, montane dots take on their
 * lineage colours. Selecting a taxon (a legend chip or one of its dots)
 * highlights its populations, draws its recorded elevation range on each
 * mountain, and describes it below. Scrolls horizontally on small screens.
 */
import relief from "../../assets/graphics/sulawesi-relief.png";
import elevation from "../../data/bunomys-elevation.json";
import sulawesi from "../../data/sulawesi-dominator.json";

const taxon = (label: string) => elevation.taxa.find((t) => t.label === label)!;
const fmt = (m: number) => m.toLocaleString("en-US");

// ---- Mountains, north to south ----------------------------------------
// Summit heights in metres (Latimojong = Rantemario peak).
const mountainsRaw = [
  { name: "Rorekatimbo", lat: -1.30934, lon: 120.30919, h: 2610 },
  { name: "Torompupu", lat: -1.412105, lon: 119.939312, h: 2495 },
  { name: "Gandangdewata", lat: -2.88284, lon: 119.38777, h: 3074 },
  { name: "Latimojong", lat: -3.420665, lon: 120.094371, h: 3478 },
];

const km = (
  a: { lat: number; lon: number },
  b: { lat: number; lon: number },
) => {
  const r = Math.PI / 180;
  const s =
    Math.sin(((b.lat - a.lat) * r) / 2) ** 2 +
    Math.cos(a.lat * r) *
      Math.cos(b.lat * r) *
      Math.sin(((b.lon - a.lon) * r) / 2) ** 2;
  return 6371 * 2 * Math.asin(Math.sqrt(s));
};

// Horizontal position from cumulative distance along the profile.
const W = 1000;
const X0 = 120;
const X1 = 900;
const gaps = mountainsRaw.slice(1).map((m, i) => km(mountainsRaw[i], m));
const total = gaps.reduce((a, b) => a + b, 0);
let cum = 0;
// Valley floors between neighbouring summits, north to south (m).
const valleys = [350, 250, 500];
const valleyKnown = [true, false, true]; // the middle floor is illustrative
const FLOOR = 250; // lowland beyond the outer slopes, m

const xs = mountainsRaw.map((_, i) => {
  if (i > 0) cum += gaps[i - 1];
  return X0 + (cum / total) * (X1 - X0);
});

// Each flank descends from the summit to its valley floor over at most
// `reach` px, meeting the neighbouring flank midway when summits are close.
const mountains = mountainsRaw.map((m, i) => {
  const montane = elevation.taxa
    .filter(
      (t) =>
        t.group === "Montane" && t.records.some((r) => r.locality === m.name),
    )
    .map((t) => t.label);
  const reach = 55 + m.h * 0.03;
  const flank = (j: number) =>
    j < 0 || j >= xs.length
      ? { d: reach, f: FLOOR }
      : {
          d: Math.min(reach, Math.abs(xs[j] - xs[i]) / 2),
          f: valleys[Math.min(i, j)],
        };
  return { ...m, x: xs[i], left: flank(i - 1), right: flank(i + 1), montane };
});

// ---- Elevation → y ----------------------------------------------------
const GROUND = 300;
const PER_M = 245 / 3500;
const y = (m: number) => GROUND - m * PER_M;

// Terrain: each flank is a concave curve from summit to valley floor;
// between flanks the ground sits on the valley floor. Small roughness.
const SHAPE = 1.35;
const floorAt = (x: number) => {
  for (let i = 0; i < xs.length - 1; i++)
    if (x > xs[i] && x < xs[i + 1]) return valleys[i];
  return FLOOR;
};
const elevAt = (x: number) =>
  Math.max(
    floorAt(x),
    ...mountains.map((m) => {
      const { d, f } = x < m.x ? m.left : m.right;
      const t = Math.abs(x - m.x) / d;
      return t >= 1 ? 0 : f + (m.h - f) * (1 - t) ** SHAPE;
    }),
  );
const rough = (x: number) =>
  25 * Math.sin(x * 0.37) + 18 * Math.sin(x * 0.91 + 1.3);
const pts: string[] = [];
for (let x = 40; x <= W - 40; x += 2) {
  const e = elevAt(x);
  pts.push(`${x} ${y(e > floorAt(x) + 80 ? e + rough(x) : e).toFixed(1)}`);
}
const terrain = `M40 360 L${pts.join(" L")} L${W - 40} 360 Z`;

// ---- Dots -------------------------------------------------------------
const rand = (i: number, seed: number) =>
  Math.abs(Math.sin((i + 1) * 12.9898 * seed) * 43758.5453) % 1;

// Scatter n dots on mountain m within an elevation band, inside the cone.
const scatter = (
  m: (typeof mountains)[number],
  n: number,
  lo: number,
  hi: number,
  seed: number,
) => {
  const top = Math.min(hi, m.h - 150);
  const bottom = Math.max(lo, Math.min(m.left.f, m.right.f) + 100);
  return Array.from({ length: n }, (_, i) => {
    const e = bottom + rand(i, seed) * Math.max(top - bottom, 0);
    // Pick a flank; fall back to the other if this one's floor is too high.
    let side = rand(i, seed * 2.3 + 0.1) < 0.5 ? m.left : m.right;
    if (e < side.f + 100) side = side === m.left ? m.right : m.left;
    const sign = side === m.left ? -1 : 1;
    const half =
      side.d * (1 - ((e - side.f) / (m.h - side.f)) ** (1 / SHAPE)) * 0.8;
    return { x: m.x + sign * rand(i, seed * 1.9 + 0.7) * half, y: y(e) };
  });
};

// Featured montane lineages (colours) and the widespread T. dominator.
const lineages = [
  { label: "E. canus WC-A", color: "#5f92cb" },
  { label: "E. canus WC-B", color: "#b58ae0" },
  { label: "E. canus WC-C", color: "#37b8a8" },
  { label: "B. torajae WC-A", color: "#ef6fa8" },
  { label: "B. torajae WC-B", color: "#f2cf4a" },
  { label: "B. penitus WC-B", color: "#e9edd6" },
];
// Every other taxon also has its own colour, used for its legend chip and
// whenever it is selected. Widespread taxa take warm, earthy tones; the
// remaining montane taxa stay grey in the overview.
const ownColors: Record<string, string> = {
  "B. andrewsi": "#e4572e",
  "T. celebensis": "#b98b5e",
  "B. penitus WC-A": "#f7a072",
  "B. chrysocomus EC-SE-WC": "#8c5a3c",
  "T. callitrichus": "#d4c09a",
  "Bunomys sp2": "#9bd15f",
  "T. hamatus": "#9cd3f0",
  "Taeromys spnov": "#3f9a5c",
  "Genus spnov": "#e07a7a",
  "Taeromys sp3": "#7b6fc4",
};
const OTHER = "#8199a2";
const SHARED = "#f5a028";
const WIDE = "T. dominator EC-SE-SW-WC";
const wide = taxon(WIDE);

// Names: "B. torajae WC-A" -> Bunomys torajae WC-A, with the binomial italic.
const genera: Record<string, string> = {
  "B.": "Bunomys",
  "E.": "Eropeplus",
  "T.": "Taeromys",
};
const nameParts = (label: string, full: boolean) => {
  if (label === "Genus spnov") return { name: "Undescribed genus", suffix: "" };
  const [g, sp, ...rest] = label.split(" ");
  const genus = full ? (genera[g] ?? g) : g;
  if (sp.startsWith("sp"))
    return {
      name: `<i>${genus}</i> ${sp === "spnov" ? "sp. nov." : `sp. ${sp.slice(2)}`}`,
      suffix: "",
    };
  return { name: `<i>${genus} ${sp}</i>`, suffix: rest.join(" ") };
};
const html = (label: string, full: boolean) => {
  const { name, suffix } = nameParts(label, full);
  return suffix ? `${name} ${suffix}` : name;
};

// Every taxon recorded on the four mountains, with its records per mountain.
const names = mountains.map((m) => m.name);
const rank = (label: string) =>
  label === WIDE ? 0 : lineages.some((l) => l.label === label) ? 1 : 2;
const taxa = elevation.taxa
  .filter((t) => t.records.some((r) => names.includes(r.locality)))
  .sort((a, b) => rank(a.label) - rank(b.label))
  .map((t, ti) => {
    const ranges = mountains.flatMap((m, mi) => {
      const recs = t.records.filter((r) => r.locality === m.name);
      return recs.length
        ? [
            {
              mi,
              min: Math.min(...recs.map((r) => r.min)),
              max: Math.max(...recs.map((r) => r.max)),
              n: recs.reduce((sum, r) => sum + r.n, 0),
            },
          ]
        : [];
    });
    const featured = t.label === WIDE || lineages.some((l) => l.label === t.label);
    const color =
      t.label === WIDE
        ? SHARED
        : (lineages.find((l) => l.label === t.label)?.color ?? ownColors[t.label] ?? OTHER);
    const lo = Math.min(...ranges.map((r) => r.min));
    const hi = Math.max(...ranges.map((r) => r.max));
    const n = ranges.reduce((sum, r) => sum + r.n, 0);
    const where = ranges.map((r) => mountains[r.mi].name);
    const zone =
      t.min >= elevation.threshold
        ? `montane, recorded only above ${fmt(elevation.threshold)} m`
        : t.max < elevation.threshold
          ? `lowland, recorded only below ${fmt(elevation.threshold)} m`
          : `widespread, recorded below and above ${fmt(elevation.threshold)} m`;
    return {
      id: `t${ti}`,
      label: t.label,
      group: t.group,
      color,
      featured,
      // Grey in the overview until selected.
      muted: !featured && t.group === "Montane",
      // Drawn before any selection: T. dominator and the montane taxa.
      shown: t.label === WIDE || t.group === "Montane",
      chip: html(t.label, false),
      full: html(t.label, true),
      summary: `${html(t.label, true)} is ${zone}. On these mountains: ${where.length > 1 ? `${where.slice(0, -1).join(", ")} and ${where.at(-1)}` : where[0]}, ${fmt(lo)}–${fmt(hi)} m, ${n} specimen${n === 1 ? "" : "s"}.`,
      ranges,
    };
  });

// Dots for every taxon, placed within its recorded elevations on each
// mountain. Featured lineages and T. dominator get more dots than the rest.
const dots = taxa.flatMap((t, ti) =>
  t.ranges.flatMap((r) => {
    const n = t.featured ? 6 : 3;
    const seed = 2.1 + r.mi * 1.7 + ti * 0.61;
    return scatter(mountains[r.mi], n, r.min, r.max, seed).map((d) => ({
      ...d,
      t,
      delay: 0.3 + r.mi * 0.3,
    }));
  }),
);

const groups = ["Montane", "Widespread"].map((g) => ({
  name: g,
  taxa: taxa.filter((t) => t.group === g),
}));

// ---- Locator inset ----------------------------------------------------
const bb = sulawesi.bbox;
const INSET = { x: 330, y: 8, w: 118 };
const insetH = (INSET.w * sulawesi.image.height) / sulawesi.image.width;
const ix = (lon: number) =>
  INSET.x + ((lon - bb.xmin) / (bb.xmax - bb.xmin)) * INSET.w;
const iy = (lat: number) =>
  INSET.y + ((bb.ymax - lat) / (bb.ymax - bb.ymin)) * insetH;

const ticks = [1000, 2000, 3000];
const yThreshold = y(elevation.threshold);
---

<figure class="sky-island">
  <div
    class="sky-scroll -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0"
    tabindex="0"
    aria-label="Mountain profile, scrolls horizontally"
  >
    <svg
      viewBox={`0 0 ${W} 360`}
      class="h-auto w-full min-w-[760px]"
      role="img"
      aria-labelledby="sky-title sky-desc"
    >
      <title id="sky-title">Four sky islands in Sulawesi's central core</title>
      <desc id="sky-desc">
        A schematic north–south profile through Rorekatimbo, Torompupu,
        Gandangdewata, and Latimojong, spaced by their real distances ({
          gaps.map((g) => `${Math.round(g)} km`).join(", ")
        }). Taeromys dominator occurs on all four mountains. Above 1,000 m,
        montane lineages are confined to one or two summits: Eropeplus canus has
        a different haplogroup on Rorekatimbo and Torompupu but shares one
        between Gandangdewata and Latimojong; Bunomys torajae differs between
        Gandangdewata and Latimojong; Bunomys penitus WC-B is shared by
        Rorekatimbo and Torompupu.
      </desc>
      <defs>
        <clipPath id="terrain-clip"><path d={terrain}></path></clipPath>
      </defs>

      <!-- elevation axis -->
      {
        ticks.map((m) => (
          <g class="fill-forest-700 dark:fill-forest-300">
            <line
              x1="40"
              x2={W - 40}
              y1={y(m)}
              y2={y(m)}
              class="stroke-forest-900/10 dark:stroke-forest-100/10"
              stroke-width="1"
            />
            <text x="4" y={y(m) + 4} font-size="11">
              {fmt(m)} m
            </text>
          </g>
        ))
      }

      <!-- locator inset -->
      <g aria-hidden="true">
        <image
          href={relief.src}
          x={INSET.x}
          y={INSET.y}
          width={INSET.w}
          height={insetH}
          opacity="0.9"
        />
        <polyline
          points={mountains
            .map((m) => `${ix(m.lon).toFixed(1)},${iy(m.lat).toFixed(1)}`)
            .join(" ")}
          fill="none"
          stroke="#c95d10"
          stroke-width="1.5"
          stroke-dasharray="3 2"></polyline>
        {
          mountains.map((m) => (
            <circle
              cx={ix(m.lon)}
              cy={iy(m.lat)}
              r="2.6"
              fill="#c95d10"
              stroke="#fff"
              stroke-width="0.8"
            />
          ))
        }
        <text
          x={INSET.x + INSET.w + 6}
          y={INSET.y + 58}
          font-size="10.5"
          class="fill-forest-700 dark:fill-forest-300"
        >
          <tspan x={INSET.x + INSET.w + 6}>Profile line through</tspan>
          <tspan x={INSET.x + INSET.w + 6} dy="13">the central core</tspan>
        </text>
      </g>

      <!-- terrain, darker above the lowland–montane threshold -->
      <path d={terrain} class="fill-forest-500 dark:fill-forest-600"></path>
      <g clip-path="url(#terrain-clip)">
        <rect
          x="0"
          y="0"
          width={W}
          height={yThreshold}
          class="fill-forest-800 dark:fill-forest-900"></rect>
        <rect x="0" y="0" width={W} height={y(2500)} class="fill-moss-800/70"
        ></rect>
      </g>

      <!-- threshold -->
      <line
        x1="40"
        x2={W - 40}
        y1={yThreshold}
        y2={yThreshold}
        stroke="#e9edd6"
        stroke-width="1.5"
        stroke-dasharray="6 6"
        opacity="0.85"></line>
      <text
        x={(mountains[1].x + mountains[2].x) / 2}
        y={yThreshold - 8}
        text-anchor="middle"
        font-size="11"
        font-weight="600"
        class="fill-forest-800 dark:fill-forest-100"
      >
        {fmt(elevation.threshold)} m: lowland | montane
      </text>

      <!-- mountain names -->
      {
        mountains.map((m, mi) => (
          <g text-anchor="middle" class="peak-label" data-mountain={mi}>
            <text
              x={m.x}
              y={y(m.h) - 34}
              font-size="12.5"
              font-weight="700"
              class="fill-forest-900 dark:fill-forest-50"
            >
              {m.name}
            </text>
            <text
              x={m.x}
              y={y(m.h) - 21}
              font-size="10.5"
              class="fill-forest-700 dark:fill-forest-300"
            >
              {fmt(m.h)} m
            </text>
            <text
              x={m.x}
              y={y(m.h) - 8}
              font-size="10.5"
              class="fill-forest-700 dark:fill-forest-300"
            >
              {m.montane.length} montane taxa
            </text>
          </g>
        ))
      }

      <!-- populations; dots of widespread taxa other than T. dominator appear only when selected -->
      {
        dots.map((d) => (
          <circle
            cx={d.x.toFixed(1)}
            cy={d.y.toFixed(1)}
            r="3.6"
            class={`dot ${d.t.label === WIDE ? "dot-wide" : d.t.shown ? "dot-peak" : "dot-extra"}`}
            data-taxon={d.t.id}
            style={`--c:${d.t.muted ? OTHER : d.t.color};--sel:${d.t.color};transition-delay:${d.delay.toFixed(2)}s`}
          />
        ))
      }

      <!-- recorded elevation range of the selected taxon on each mountain -->
      {
        taxa.map((t) => (
          <g class="range hidden" data-range={t.id} aria-hidden="true">
            {t.ranges.map((r) => {
              const x = mountains[r.mi].x;
              const y1 = y(r.max);
              const y2 = y(r.min);
              // Label beside the bar, on the left near the right edge.
              const left = x > W - 200;
              const lx = left ? x - 10 : x + 10;
              return (
                <g>
                  <line x1={x} x2={x} y1={y1} y2={y2} class="range-halo" />
                  <line
                    x1={x}
                    x2={x}
                    y1={y1}
                    y2={y2}
                    class="range-bar"
                    style={`--c:${t.color}`}
                  />
                  <line
                    x1={x - 6}
                    x2={x + 6}
                    y1={y1}
                    y2={y1}
                    class="range-bar"
                    style={`--c:${t.color}`}
                  />
                  <line
                    x1={x - 6}
                    x2={x + 6}
                    y1={y2}
                    y2={y2}
                    class="range-bar"
                    style={`--c:${t.color}`}
                  />
                  <text
                    x={lx}
                    y={(y1 + y2) / 2 - 2}
                    text-anchor={left ? "end" : "start"}
                    font-size="11.5"
                    font-weight="700"
                    class="range-text"
                  >
                    <tspan x={lx}>
                      {r.min === r.max
                        ? `${fmt(r.min)} m`
                        : `${fmt(r.min)}–${fmt(r.max)} m`}
                    </tspan>
                    <tspan x={lx} dy="13" font-weight="500">
                      {r.n} specimen{r.n === 1 ? "" : "s"}
                    </tspan>
                  </text>
                </g>
              );
            })}
          </g>
        ))
      }

      <!-- valley floors -->
      {
        valleys.map((f, i) =>
          valleyKnown[i] ? (
            <text
              x={(xs[i] + xs[i + 1]) / 2}
              y={y(f) + 16}
              text-anchor="middle"
              font-size="10.5"
              font-weight="600"
              class="fill-forest-50"
            >
              ~{fmt(f)} m
            </text>
          ) : null,
        )
      }

      <!-- distances between neighbouring summits -->
      {
        mountains.slice(1).map((m, i) => {
          const a = mountains[i].x;
          const b = m.x;
          return (
            <g class="fill-forest-50 stroke-forest-50">
              <line x1={a} x2={b} y1="326" y2="326" stroke-width="1" />
              <line x1={a} x2={a} y1="321" y2="331" stroke-width="1" />
              <line x1={b} x2={b} y1="321" y2="331" stroke-width="1" />
              <text
                x={(a + b) / 2}
                y="346"
                text-anchor="middle"
                font-size="11.5"
                font-weight="600"
                stroke="none"
              >
                {Math.round(gaps[i])} km
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>
  <p
    class="mt-1 text-right text-xs text-forest-600 sm:hidden dark:text-forest-400"
  >
    Swipe to explore →
  </p>

  <figcaption class="mt-3 text-sm text-forest-800 dark:text-forest-200">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <p class="font-semibold text-forest-900 dark:text-forest-50">
        Select a taxon to see where it lives
      </p>
      <button
        type="button"
        class="sky-clear hidden rounded-full px-2.5 py-1 text-xs font-semibold text-forest-700 underline hover:text-forest-950 dark:text-forest-300 dark:hover:text-forest-50"
      >
        Show all
      </button>
    </div>
    {
      groups.map((g) => (
        <div class="mt-2" role="group" aria-label={`${g.name} taxa`}>
          <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-forest-700 dark:text-forest-300">
            {g.name}
          </p>
          <ul class="flex flex-wrap gap-1.5">
            {g.taxa.map((t) => (
              <li>
                <button
                  type="button"
                  class="sky-chip group flex items-center gap-1.5 rounded-full border border-forest-900/15 px-2.5 py-1 text-xs text-forest-800 transition-colors hover:bg-forest-100 aria-pressed:border-forest-700 aria-pressed:bg-forest-700 aria-pressed:text-white dark:border-forest-100/20 dark:text-forest-100 dark:hover:bg-forest-900 dark:aria-pressed:border-forest-200 dark:aria-pressed:bg-forest-200 dark:aria-pressed:text-forest-950"
                  data-select={t.id}
                  data-mountains={t.ranges.map((r) => r.mi).join(" ")}
                  data-detail={t.summary}
                  aria-pressed="false"
                >
                  <span
                    class="inline-block h-2.5 w-2.5 shrink-0 rounded-full"
                    style={`background:${t.color};box-shadow:0 0 0 1px rgb(14 26 18 / 0.3)`}
                  />
                  {/* Abbreviated in the list; the full name once selected. */}
                  <span class="group-aria-pressed:hidden" set:html={t.chip} />
                  <span class="hidden group-aria-pressed:inline" set:html={t.full} />
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <p
      class="sky-detail mt-3 min-h-[2.5rem] rounded-xl bg-forest-50 px-3 py-2 text-forest-800 dark:bg-forest-900/60 dark:text-forest-100"
      aria-live="polite"
    >
      Orange dots are <i>Taeromys dominator</i>, the only taxon on all four
      mountains. Select a taxon to show its populations and elevation range.
    </p>
    <p class="mt-3 text-pretty text-forest-700 dark:text-forest-300">
      Distance alone does not predict shared ancestry. Rorekatimbo and
      Torompupu,
      {Math.round(gaps[0])} km apart, have different <i>E. canus</i> haplogroups yet
      share <i>B. penitus</i> WC-B. Mts. Gandangdewata and Latimojong,
      {Math.round(gaps[2])} km apart, on the other hand, share an <i>E. canus</i
      > haplogroup but not
      <i> B. torajae</i>. The peaks in the schematic profile are drawn according
      to their present-day summit heights.
    </p>
  </figcaption>
</figure>

<style>
  .sky-scroll {
    scrollbar-width: thin;
  }
  .dot-wide {
    fill: #f5a028;
    cursor: pointer;
    stroke: #3b2a10;
    stroke-width: 0.6;
  }
  .dot-peak {
    fill: #a9bcc2;
    stroke: #1c2b21;
    stroke-width: 0.6;
    transition:
      fill 1.2s ease,
      opacity 0.3s ease;
  }
  .sky-island.in .dot-peak {
    fill: var(--c);
  }
  .dot {
    cursor: pointer;
  }
  .dot-wide {
    transition: opacity 0.3s ease;
  }
  .dot-extra {
    display: none;
    fill: var(--sel);
    stroke: #1c2b21;
    stroke-width: 0.6;
  }
  /* A selection fades every other population and outlines its own. */
  .has-sel .dot:not(.sel) {
    opacity: 0.15;
  }
  .dot.sel {
    display: inline;
    stroke: #fff;
    stroke-width: 1.4;
    transition-delay: 0s !important;
  }
  .dot-extra.sel,
  .dot-peak.sel {
    fill: var(--sel);
  }
  .peak-label {
    transition: opacity 0.3s ease;
  }
  .has-sel .peak-label:not(.sel) {
    opacity: 0.35;
  }
  .range-halo {
    stroke: #0e1a12;
    stroke-width: 6;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .range-bar {
    stroke: var(--c);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .range-text {
    fill: #fff;
    stroke: #0e1a12;
    stroke-width: 2.5;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot-peak {
      transition: none;
    }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => e.isIntersecting && e.target.classList.add("in")),
    { threshold: 0.3 },
  );
  document.querySelectorAll(".sky-island").forEach((el) => io.observe(el));

  // Select one taxon at a time from the chips or by clicking one of its dots.
  document.querySelectorAll<HTMLElement>(".sky-island").forEach((root) => {
    const svg = root.querySelector("svg")!;
    const chips = root.querySelectorAll<HTMLButtonElement>(".sky-chip");
    const detail = root.querySelector<HTMLElement>(".sky-detail")!;
    const intro = detail.innerHTML;
    const clear = root.querySelector<HTMLButtonElement>(".sky-clear")!;

    const select = (id: string | null) => {
      const chip = [...chips].find((c) => c.dataset.select === id);
      const peaks = (chip?.dataset.mountains ?? "").split(" ");
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      svg.classList.toggle("has-sel", id !== null);
      svg
        .querySelectorAll<SVGElement>(".dot")
        .forEach((d) => d.classList.toggle("sel", d.dataset.taxon === id));
      svg
        .querySelectorAll<SVGElement>(".range")
        .forEach((g) => g.classList.toggle("hidden", g.dataset.range !== id));
      svg
        .querySelectorAll<SVGElement>(".peak-label")
        .forEach((g) =>
          g.classList.toggle("sel", peaks.includes(g.dataset.mountain!)),
        );
      // Summaries are built from the data file at build time; they carry <i>.
      detail.innerHTML = chip?.dataset.detail ?? intro;
      clear.classList.toggle("hidden", id === null);
    };

    chips.forEach((c) =>
      c.addEventListener("click", () =>
        select(
          c.getAttribute("aria-pressed") === "true" ? null : c.dataset.select!,
        ),
      ),
    );
    svg
      .querySelectorAll<SVGElement>(".dot")
      .forEach((d) =>
        d.addEventListener("click", () => select(d.dataset.taxon!)),
      );
    clear.addEventListener("click", () => select(null));
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape") select(null);
    });
  });
</script>
