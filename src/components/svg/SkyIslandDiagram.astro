---
/**
 * Schematic cross-section of a mountainous island. Lowland populations are
 * connected; above the cloud line each summit is a "sky island" whose
 * population diverges. On scroll into view, summit dots shift from the shared
 * lowland color to distinct colors.
 */
const island =
  "M20 270 C100 265 150 245 180 215 L230 80 L285 165 L330 200 L380 140 L430 50 L480 130 L530 185 L575 150 L620 95 L670 185 C710 240 740 262 800 270 Z";

// Deterministic scatter of dots inside a box.
const scatter = (n: number, x0: number, x1: number, y0: number, y1: number, seed: number) =>
  Array.from({ length: n }, (_, i) => {
    const r1 = Math.abs(Math.sin((i + 1) * 12.9898 * seed) * 43758.5453) % 1;
    const r2 = Math.abs(Math.sin((i + 1) * 78.233 * seed) * 12345.6789) % 1;
    return { x: x0 + r1 * (x1 - x0), y: y0 + r2 * (y1 - y0) };
  });

const lowland = [
  ...scatter(9, 120, 200, 238, 258, 1.1),
  ...scatter(8, 300, 360, 215, 250, 2.3),
  ...scatter(8, 500, 560, 210, 250, 3.7),
  ...scatter(9, 670, 740, 238, 258, 4.9),
];
const peaks = [
  { cls: "p1", dots: scatter(7, 214, 246, 102, 150, 5.3), label: "Species A", x: 230 },
  { cls: "p2", dots: scatter(9, 412, 448, 74, 150, 6.1), label: "Species B", x: 430 },
  { cls: "p3", dots: scatter(6, 606, 634, 116, 152, 7.7), label: "Species C", x: 620 },
];
const elev = [
  { m: "0 m", y: 270 },
  { m: "1,000", y: 197 },
  { m: "2,000", y: 123 },
  { m: "3,000", y: 50 },
];
---

<figure class="sky-island">
  <svg
    viewBox="0 0 820 320"
    class="h-auto w-full"
    role="img"
    aria-labelledby="sky-title sky-desc"
  >
    <title id="sky-title">Sky islands: how mountains create islands within islands</title>
    <desc id="sky-desc">
      A cross-section of a mountainous island. Below the cloud line, one
      lowland population spans the island. Above it, three summits each hold
      an isolated population that diverges into its own species.
    </desc>
    <defs>
      <clipPath id="island-clip"><path d={island} /></clipPath>
      <linearGradient id="sea-grad" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#5a7bbe" stop-opacity="0.7" />
        <stop offset="1" stop-color="#303c5b" stop-opacity="0.9" />
      </linearGradient>
    </defs>

    <!-- elevation axis -->
    {
      elev.map((e) => (
        <g class="fill-moss-700 dark:fill-moss-300">
          <line x1="40" x2="800" y1={e.y} y2={e.y} class="stroke-moss-900/10 dark:stroke-moss-100/10" stroke-width="1" />
          <text x="4" y={e.y + 4} font-size="11">{e.m}</text>
        </g>
      ))
    }

    <!-- island -->
    <path d={island} class="fill-moss-500 dark:fill-moss-600" />
    <g clip-path="url(#island-clip)">
      <rect x="0" y="0" width="820" height="160" class="fill-moss-800 dark:fill-moss-900" />
      <rect x="0" y="0" width="820" height="85" class="fill-sunrise-800/70" />
    </g>
    <rect x="0" y="270" width="820" height="50" fill="url(#sea-grad)" />

    <!-- cloud line -->
    <line x1="40" x2="800" y1="160" y2="160" stroke="#e9edd6" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.8" />
    <text x="796" y="154" text-anchor="end" font-size="12" class="fill-moss-800 dark:fill-moss-100">cloud line ≈ 1,500 m</text>

    <!-- populations -->
    {lowland.map((d) => <circle cx={d.x} cy={d.y} r="4" class="dot-low" />)}
    {
      peaks.map((p, i) => (
        <g>
          {p.dots.map((d) => (
            <circle cx={d.x} cy={d.y} r="4" class={`dot-peak ${p.cls}`} style={`transition-delay:${0.4 + i * 0.35}s`} />
          ))}
          <text x={p.x} y={i === 1 ? 36 : p.x === 230 ? 66 : 81} text-anchor="middle" font-size="12" font-weight="600" class={`peak-label ${p.cls}-text`} style={`transition-delay:${0.6 + i * 0.35}s`}>
            {p.label}
          </text>
        </g>
      ))
    }

    <text x="60" y="300" font-size="12" fill="#f6f7ee">Lowland: one connected population</text>
  </svg>
  <figcaption class="mt-3 grid gap-2 text-sm text-moss-800 sm:grid-cols-2 dark:text-moss-200">
    <span><span class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-sunrise-400 align-middle"></span>Below the clouds, warm lowland forests connect populations.</span>
    <span><span class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-crater-400 align-middle"></span>Above them, cool, wet summits isolate populations that diverge.</span>
  </figcaption>
</figure>

<style>
  .dot-low { fill: #eeab30; }
  .dot-peak {
    fill: #eeab30;
    transition: fill 1.2s ease;
  }
  .peak-label {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .sky-island.in .peak-label { opacity: 1; }
  .sky-island.in .p1 { fill: #7598cd; }
  .sky-island.in .p2 { fill: #c46815; }
  .sky-island.in .p3 { fill: #e9edd6; }
  .sky-island.in .p1-text { fill: #7598cd; }
  .sky-island.in .p2-text { fill: #e08b1b; }
  .sky-island.in .p3-text { fill: #b5c47c; }
  @media (prefers-reduced-motion: reduce) {
    .dot-peak, .peak-label { transition: none; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => e.isIntersecting && e.target.classList.add("in")),
    { threshold: 0.4 },
  );
  document.querySelectorAll(".sky-island").forEach((el) => io.observe(el));
</script>
