---
/** Line icons for the profile links. Inherit color via `currentColor`. */
interface Props {
  name: "github" | "scholar" | "linktree" | "mail" | "cv";
  class?: string;
}
const { name, class: className = "h-5 w-5" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "github" && (
      <>
        {/* Octocat silhouette */}
        <path d="M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
        <path d="M9 18c-4.5 2-5-2-7-2" />
      </>
    )
  }
  {
    name === "scholar" && (
      <>
        {/* Mortarboard */}
        <path d="M22 9.5 12 4.5 2 9.5l10 5 10-5Z" />
        <path d="M6 11.5v5c3.3 2.7 8.7 2.7 12 0v-5" />
        <path d="M22 9.5v6" />
      </>
    )
  }
  {
    name === "linktree" && (
      <>
        {/* Branching tree of links */}
        <path d="M12 22v-8" />
        <path d="M12 10V2" />
        <path d="M3.5 7.5h17" />
        <path d="M6 3l6 6 6-6" />
        <path d="M6 15l6-6 6 6" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        {/* Envelope */}
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="m3 6.5 9 6.5 9-6.5" />
      </>
    )
  }
  {
    name === "cv" && (
      <>
        {/* Document with a download arrow */}
        <path d="M14 2.5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-12Z" />
        <path d="M14 2.5v5h5" />
        <path d="M12 11v6.5" />
        <path d="m9 14.5 3 3 3-3" />
      </>
    )
  }
</svg>
