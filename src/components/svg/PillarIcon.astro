---
/** Line icons for the research pillars. Inherit color via `currentColor`. */
interface Props {
  name: "island" | "phenomics" | "software" | "collections";
  class?: string;
}
const { name, class: className = "h-10 w-10" } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "island" && (
      <>
        {/* Two peaks over water, a cloud line, and a lone tree */}
        <path d="M4 34 L15 18 L21 25 L29 12 L44 34" />
        <path d="M24 20 h10" stroke-dasharray="2 3" />
        <path d="M4 39 c4 -2 6 2 10 0 s6 2 10 0 s6 2 10 0 s6 2 10 0" />
        <path d="M12 34 v-5 M9.5 30.5 L12 26 L14.5 30.5" />
      </>
    )
  }
  {
    name === "phenomics" && (
      <>
        {/* Butterfly wing mapped to embedding points */}
        <path d="M18 24 C8 12 4 20 8 26 C4 32 10 38 18 28 Z" />
        <path d="M18 18 v16" />
        <circle cx="30" cy="16" r="1.6" fill="currentColor" />
        <circle cx="36" cy="22" r="1.6" fill="currentColor" />
        <circle cx="33" cy="30" r="1.6" fill="currentColor" />
        <circle cx="41" cy="31" r="1.6" fill="currentColor" />
        <path d="M22 24 h4" stroke-dasharray="1 2" />
        <path d="M28 38 h16 M28 38 V10" opacity="0.5" />
      </>
    )
  }
  {
    name === "software" && (
      <>
        {/* Phone running code with a leaf */}
        <rect x="13" y="5" width="22" height="38" rx="4" />
        <path d="M21 39 h6" />
        <path d="M20 15 l-4 4 4 4 M28 15 l4 4 -4 4" />
        <path d="M18 33 c2 -6 8 -8 12 -7 c-1 5 -6 8 -12 7 Z M18 33 l6 -4" />
      </>
    )
  }
  {
    name === "collections" && (
      <>
        {/* Specimen tag with string */}
        <path d="M10 14 h24 l6 6 v18 a2 2 0 0 1 -2 2 H10 a2 2 0 0 1 -2 -2 V16 a2 2 0 0 1 2 -2 Z" />
        <circle cx="34" cy="20" r="1.8" />
        <path d="M34 18 C38 8 44 8 44 4" />
        <path d="M13 22 h14 M13 27 h18 M13 32 h10" />
      </>
    )
  }
</svg>
