---
/** Line icons for the kinds of fieldwork. Inherit color via `currentColor`. */
import type { FieldworkKind } from "../../scripts/fieldwork";
import { fieldworkIconPaths } from "../../scripts/fieldworkIcons";

interface Props {
  name: FieldworkKind;
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={fieldworkIconPaths[name]}
></svg>
