---
/** Line icons for the kinds of fieldwork. Inherit color via `currentColor`. */
import type { FieldworkKind } from "../../scripts/fieldwork";

interface Props {
  name: FieldworkKind;
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "collecting" && (
      <>
        {/* Live trap with its door open and a specimen tag */}
        <path d="M5 15 L14 7 H43 L34 15 Z" />
        <path d="M34 15 V31 L43 23 V7" />
        <rect x="5" y="15" width="29" height="16" rx="1" />
        <path d="M37 19 L40.5 16 V24 L37 27 Z" />
        <path d="M10 31 q0 9 9 9" />
        <path d="M19 35 H34 L39 40 L34 45 H19 Z" />
        <circle cx="23" cy="40" r="1.2" />
      </>
    )
  }
  {
    name === "limited" && (
      <>
        {/* Field notebook with a tissue vial */}
        <rect x="6" y="5" width="23" height="38" rx="2" />
        <path d="M11 5 v38" />
        <path d="M16 14 h8 M16 20 h8 M16 26 h5" />
        <rect x="34" y="14" width="8" height="26" rx="4" />
        <path d="M33 14 h10 M34 31 h8" />
      </>
    )
  }
  {
    name === "survey" && (
      <>
        {/* Binoculars */}
        <circle cx="13" cy="33" r="8" />
        <circle cx="35" cy="33" r="8" />
        <path d="M6 30 L10 10 H18 L21 27" />
        <path d="M42 30 L38 10 H30 L27 27" />
        <path d="M21 20 h6" />
        <path d="M11 10 V6 h6 v4 M31 10 V6 h6 v4" />
      </>
    )
  }
</svg>
