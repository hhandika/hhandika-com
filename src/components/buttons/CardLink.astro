---
import cntl from "cntl";

const { text, url } = Astro.props;

const linkClasses = cntl`
  text-mist-700
  dark:text-mist-200
  text-semibold
  text-md
  underline
  hover:text-mist-900
  dark:hover:text-mist-50
  mr-4
`;
---

<a class={linkClasses} href={url} target="_blank" rel="noopener">{text}</a>
