---
import DownloadButton from "./DownloadButton.astro";
import SendMessageButton from "./SendMessageButton.astro";
import leadingIcon from "../../assets/icons/paper.svg";
import cntl from "cntl";

interface PubButton {
  author: string;
  year: string;
  title: string;
  doi?: string;
  pdfUrl?: string;
  isRequest: boolean;
  url?: string;
  codeUrl?: string;
}

const { title, author, year, doi, pdfUrl, isRequest, url, codeUrl } =
  Astro.props as PubButton;

// Each instance needs its own ids for aria-controls and aria-labelledby.
const id = `pub-${`${year}-${title}`.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 60)}`;

const openBtnClasses = cntl`
  font-medium
  text-mist-700
  underline
  decoration-mist-400/60
  underline-offset-2
  hover:text-moss-700
  hover:decoration-moss-500
  dark:text-mist-300
  dark:hover:text-moss-300
`;

const closeBtnClasses = cntl`
  btn 
  btn-circle 
  btn-ghost 
  btn-xs
`;

const snackbarClasses = cntl`
  hidden
  flex
  fixed
  bottom-4
  left-4
  right-4
  z-50
  sm:right-auto
  sm:max-w-xl
  items-start
  gap-3
  rounded-2xl
  border
  border-moss-200
  bg-white
  p-4
  text-forest-950
  shadow-xl
  shadow-forest-950/10
  dark:border-forest-700
  dark:bg-forest-900
  dark:text-forest-50
`;

---

<button
  type="button"
  class={`pub-open ${openBtnClasses}`}
  aria-expanded="false"
  aria-controls={id}
>
  {year}<span class="sr-only">: {title}, show links</span>
</button>

<div
  id={id}
  role="dialog"
  aria-labelledby={`${id}-title`}
  tabindex="-1"
  class={`pub-panel ${snackbarClasses}`}
>
  <img src={leadingIcon.src} alt="" class="mt-0.5 h-8 w-8 shrink-0" />
  <div class="min-w-0 flex-1 text-start">
    <h3 id={`${id}-title`} class="font-semibold leading-snug">{title}</h3>
    <div class="mt-1 text-xs text-forest-700 dark:text-forest-300">{author}. {year}</div>
    {
      (() => {
        let activeGiven = false;
        const active = () => {
          if (activeGiven) return false;
          activeGiven = true;
          return true;
        };

        return (
          (doi || url || codeUrl) && (
            <div class="mt-3 flex flex-wrap gap-2">
              {doi && (
                <>
                  {pdfUrl &&
                    (isRequest ? (
                      <SendMessageButton
                        text="Request PDF"
                        url={pdfUrl}
                        primary={active()}
                      />
                    ) : (
                      <DownloadButton
                        text="Download PDF"
                        url={pdfUrl}
                        isDownload="true"
                        primary={active()}
                      />
                    ))}
                  <DownloadButton
                    text="Article"
                    url={doi}
                    primary={!pdfUrl && active()}
                  />
                </>
              )}
              {url && (
                <>
                  <DownloadButton
                    text="Website"
                    url={url}
                    primary={!isRequest && !doi && !pdfUrl && active()}
                  />
                  {codeUrl && (
                    <DownloadButton
                      text="Code"
                      url={codeUrl}
                      primary={!isRequest && !doi && !pdfUrl && !url && active()}
                    />
                  )}
                </>
              )}
              {!url && codeUrl && !doi && (
                <DownloadButton
                  text="Code"
                  url={codeUrl}
                  primary={!isRequest && !doi && !pdfUrl && active()}
                />
              )}
            </div>
          )
        );
      })()
    }
  </div>
  <button type="button" class={`pub-close ${closeBtnClasses}`} aria-label="Close">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      aria-hidden="true"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script>
  // A non-modal popup: it stays open until closed (no time limit), Escape or the
  // close button returns focus to its trigger, and it closes when focus moves
  // on so the fixed panel never covers the next focused element.
  const close = (panel: HTMLElement, restoreFocus = false) => {
    if (panel.classList.contains("hidden")) return;
    panel.classList.add("hidden");
    const trigger = panel.previousElementSibling as HTMLButtonElement | null;
    trigger?.setAttribute("aria-expanded", "false");
    if (restoreFocus) trigger?.focus();
  };
  const closeAll = () => document.querySelectorAll<HTMLElement>(".pub-panel").forEach((p) => close(p));

  document.querySelectorAll<HTMLButtonElement>(".pub-open").forEach((button) => {
    const panel = button.nextElementSibling as HTMLElement;
    button.addEventListener("click", () => {
      const opening = panel.classList.contains("hidden");
      closeAll();
      if (!opening) return;
      panel.classList.remove("hidden");
      button.setAttribute("aria-expanded", "true");
      panel.focus();
    });
    panel.querySelector(".pub-close")!.addEventListener("click", () => close(panel, true));
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close(panel, true);
    });
    panel.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !panel.contains(next) && next !== button) close(panel);
    });
  });
</script>
