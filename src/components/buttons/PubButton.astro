---
import DownloadButton from "./DownloadButton.astro";
import SendMessageButton from "./SendMessageButton.astro";
import leadingIcon from "../../assets/icons/paper.svg";
import cntl from "cntl";

import {
  formatVolume,
  plainTitle,
  pubActions,
  yearLabel,
  type Publication,
} from "../../lib/publications";

interface Props {
  pub: Publication;
  /** Year as cited, e.g. "2024a" when one author has two papers that year. */
  year?: string;
}

const { pub, year = yearLabel(pub) } = Astro.props;
const title = plainTitle(pub.title);
const volume = formatVolume(pub);
const author =
  pub.authors.length <= 2
    ? pub.authors.join(" and ")
    : `${pub.authors.slice(0, -1).join(", ")}, and ${pub.authors.at(-1)}`;

// Badge: a published version wins over a preprint.
const typeLabel = pub.doi || pub.url
  ? pub.type === "dataset" ? "Dataset" : "Article"
  : pub.preprint ? "Preprint" : undefined;
const typeClasses = typeLabel === "Preprint"
  ? "bg-mist-100 text-mist-800 dark:bg-mist-800 dark:text-mist-100"
  : "bg-moss-100 text-moss-800 dark:bg-moss-900 dark:text-moss-100";

// The first action is primary and sits on the left.
const actions = pubActions(pub);
const labels = {
  pdf: pub.pdfRequest ? "Request PDF" : "Download PDF",
  article: pub.type === "dataset" ? "Dataset" : "Article",
  preprint: "Preprint",
  code: "Code",
  website: "Website",
};

// Highlight the site author's name in the author string, as in the CV list.
// Matches both "Handika, H." and "Handika H"; the capture group keeps the
// name, so odd indices of authorParts are the highlighted name.
const authorParts = author.split(/(Handika,? H\.?)/);
const selfClasses = cntl`
  font-bold
  text-moss-700
  dark:text-moss-300
`;

// Each instance needs its own ids for aria-controls and aria-labelledby.
const id = `pub-${`${year}-${title}`.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 60)}`;

const openBtnClasses = cntl`
  font-medium
  text-mist-700
  underline
  decoration-mist-400/60
  underline-offset-2
  hover:text-moss-700
  hover:decoration-moss-500
  dark:text-mist-300
  dark:hover:text-moss-300
`;

const closeBtnClasses = cntl`
  inline-flex
  h-6
  w-6
  shrink-0
  cursor-pointer
  items-center
  justify-center
  rounded-full
  text-xs
  transition-colors
  hover:bg-forest-900/10
  focus-visible:outline
  focus-visible:outline-2
  focus-visible:outline-offset-2
  dark:hover:bg-white/10
`;

const snackbarClasses = cntl`
  hidden
  flex
  fixed
  bottom-4
  left-4
  right-4
  z-50
  sm:right-auto
  sm:max-w-xl
  items-start
  gap-3
  rounded-2xl
  border
  border-moss-200
  bg-white
  p-4
  text-forest-950
  shadow-xl
  shadow-forest-950/10
  dark:border-forest-700
  dark:bg-forest-900
  dark:text-forest-50
`;

---

<button
  type="button"
  class={`pub-open ${openBtnClasses}`}
  aria-expanded="false"
  aria-controls={id}
>
  {year}<span class="sr-only">: {title}, show links</span>
</button>

<div
  id={id}
  role="dialog"
  aria-labelledby={`${id}-title`}
  tabindex="-1"
  class={`pub-panel ${snackbarClasses}`}
>
  <img src={leadingIcon.src} alt="" class="mt-0.5 h-8 w-8 shrink-0" />
  <div class="min-w-0 flex-1 text-start">
    {typeLabel && (
      <span class={`mb-1 inline-block rounded-full px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wide ${typeClasses}`}>
        {typeLabel}
      </span>
    )}
    <h3 id={`${id}-title`} class="font-semibold leading-snug" set:html={pub.title} />
    <div class="mt-1 text-xs text-forest-700 dark:text-forest-300">{authorParts.map((part, i) => (i % 2 ? <strong class={selfClasses}>{part}</strong> : part))}. {year}.{pub.journal && <> <em>{pub.journal}</em>{volume && `, ${volume}`}.</>}</div>
    {actions.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {actions.map(({ kind, url }, i) =>
          kind === "pdf" && pub.pdfRequest ? (
            <SendMessageButton text={labels[kind]} url={url} primary={i === 0} />
          ) : (
            <DownloadButton text={labels[kind]} url={url} isDownload={kind === "pdf"} primary={i === 0} />
          ),
        )}
      </div>
    )}
  </div>
  <button type="button" class={`pub-close ${closeBtnClasses}`} aria-label="Close">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      aria-hidden="true"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script>
  // A non-modal popup: it stays open until closed (no time limit), Escape or the
  // close button returns focus to its trigger, and it closes when focus moves
  // on so the fixed panel never covers the next focused element.
  const close = (panel: HTMLElement, restoreFocus = false) => {
    if (panel.classList.contains("hidden")) return;
    panel.classList.add("hidden");
    const trigger = panel.previousElementSibling as HTMLButtonElement | null;
    trigger?.setAttribute("aria-expanded", "false");
    if (restoreFocus) trigger?.focus();
  };
  const closeAll = () => document.querySelectorAll<HTMLElement>(".pub-panel").forEach((p) => close(p));

  document.querySelectorAll<HTMLButtonElement>(".pub-open").forEach((button) => {
    const panel = button.nextElementSibling as HTMLElement;
    button.addEventListener("click", () => {
      const opening = panel.classList.contains("hidden");
      closeAll();
      if (!opening) return;
      panel.classList.remove("hidden");
      button.setAttribute("aria-expanded", "true");
      panel.focus();
    });
    panel.querySelector(".pub-close")!.addEventListener("click", () => close(panel, true));
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close(panel, true);
    });
    panel.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !panel.contains(next) && next !== button) close(panel);
    });
  });
</script>
