---
import cntl from "cntl";

interface DownloadButton {
  text: string;
  url: string;
  isDownload: boolean;
  extendClass?: string;
  primary?: boolean;
  // What the link is for, read after its visible text (WCAG 2.4.4).
  context?: string;
}

const { text, url, isDownload, extendClass = "", primary = false, context } = Astro.props;
// Primary action: the site's moss accent (as the active navigation pill)
// instead of daisyUI's gray `btn-active`.
const primaryClasses = cntl`
    !border-moss-400
    !bg-moss-400
    !text-moss-950
    hover:!border-moss-500
    hover:!bg-moss-500
`;


const buttonClasses = cntl`
    btn
    btn-outline
    h-auto
    min-h-0
    px-3
    py-1.5
    text-sm
    leading-5  
    text-forest-950
    hover:bg-forest-900
    hover:text-forest-50
    dark:text-forest-50
    dark:hover:bg-forest-50
    dark:hover:text-forest-950
    ${primary ? primaryClasses : ""}
    ${extendClass}
`;
---

<a href={url} class={buttonClasses} target="_blank" rel="noopener noreferrer">
  {
    isDownload && (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        aria-hidden="true"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"
        />
      </svg>
    )
  }
  {/* One span, so the flex gap sits only between icon and label. */}
  <span>{text}{context && <span class="sr-only">: {context}</span>}<span class="sr-only"> (opens in new tab)</span></span>
</a>
