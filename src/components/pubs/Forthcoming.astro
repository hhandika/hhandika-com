---
import WrapButton from "../../layouts/WrapButton.astro";
import DownloadButton from "../buttons/DownloadButton.astro";
import Authors from "./Authors.astro";

interface JournalArticle {
  authors: string[];
  year: string;
  title: string;
  journal?: string;
  doi?: string;
  pdfUrl?: string;
  url?: string;
  codeUrl?: string;
}

const { authors, year, title, journal, doi, pdfUrl, url, codeUrl } =
  Astro.props as JournalArticle;
---

<div class="my-2">
  <p class="text-forest-950 dark:text-forest-50">
    <Authors authors={authors} />.
    {year}. {title}. {journal && <em>{journal}</em>}
  </p>
  {
    (doi || url || codeUrl) && (
      <WrapButton>
        {/* The primary action sits last, at the far right. */}
        {url && <DownloadButton context={title} text="Learn More" url={url} />}
        {codeUrl && (doi || pdfUrl) && (
          <DownloadButton context={title} text="View Code" url={codeUrl} />
        )}
        {pdfUrl && (
          <DownloadButton context={title}
            text="Download PDF"
            url={pdfUrl}
            isDownload="true"
            primary={!doi}
          />
        )}
        {codeUrl && !doi && !pdfUrl && (
          <DownloadButton context={title}
            text="View Code"
            url={codeUrl}
            primary
          />
        )}
        {doi && (
          <DownloadButton context={title} text="View Preprint" url={doi} primary />
        )}
      </WrapButton>
    )
  }
</div>
