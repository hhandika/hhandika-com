---
import cntl from "cntl";

// This component is used to render the authors of a publication.
// It highlights the author's name if it is the author of this website.
// It also adds commas and "and" to separate the authors.
// For two authors, it adds "and" between the authors.
// For more than two authors, it adds commas between the authors
// and Oxford comma before the last author.
interface Props {
  authors: string[];
}

const { authors } = Astro.props;

// The site author's name: bold in the moss accent, so it stands out by
// weight as well as color (WCAG 1.4.1).
const self = cntl`
  font-bold
  text-moss-700
  dark:text-moss-300
`;

const separator = (index: number, count: number) => {
  if (index < count - 2) return ", ";
  if (index === count - 2) return count > 2 ? ", and " : " and ";
  return "";
};
---

{/* Keep each name and its separator on one line: since Astro 7, line breaks
    between expressions render as spaces ("Handika, H. , Smith"). */}
{
  authors.map((part: string, index: number, array: string[]) => (
    <>{part === "Handika, H." ? <strong class={self}>{part}</strong> : part}{separator(index, array.length)}</>
  ))
}
