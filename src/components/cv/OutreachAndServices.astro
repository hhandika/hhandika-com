    roles: [
      "Contributed to the IUCN Red List assessments of 76 small mammal species native to Sulawesi, Indonesia",
    ],
  },
  {
    organization: "The American Society of Mammalogists",
    period: "2016–present",
    roles: [
      "Biodiversity committee (2024–present)",
      "Mammal Diversity Database curation team (2024–present)",
    ],
  },
  {
    organization: "The Society of Systematic Biologists",
    period: "2020–present",
    roles: ["Ernst Mayr Award judge (2025)"],
  },
  {
    organization: "KCA-LH Rafflesia Nature Conservation Club, Andalas University",
    period: "Permanent member since 2009",
    roles: [
      "Secretary (2011–2012)",
      "Training undergraduate student members on jungle survival, land navigation, search and rescue, and tropical forest ecology",
      "Led and participated in mountain and cave expeditions across Sumatra, Indonesia",
      "Led and participated in organizing conservation training and seminars for students, faculty, and the public",
    ],
  },
  {
    organization:
      "Student Association of the Indonesian Endowment Fund in Victoria, Australia",
    period: "2015–2017",
    roles: [
      "Mentorship programs for new Indonesian students studying in Melbourne, Australia",
      "Developing guidelines for Indonesian students to study in Melbourne, Australia",
    ],
  },
];

const panelClasses = cntl`
  rounded-3xl
  border
  border-forest-900/10
  bg-white
  p-5
  dark:border-forest-100/10
  dark:bg-forest-950/60
  sm:p-6
`;

const linkClasses = cntl`
  inline-flex
  items-center
  gap-1.5
  rounded-full
  border
  border-forest-900/15
  px-3
  py-1
  text-xs
  font-semibold
  text-forest-800
  transition
  hover:border-moss-400
  hover:text-moss-800
  dark:border-forest-100/15
  dark:text-forest-100
  dark:hover:text-moss-200
`;

const imgClass =
  "h-64 w-auto rounded-xl border border-forest-900/10 object-contain dark:border-forest-100/10";
---

<div>
  <Background backgroundImage={outreachIcon} />
  <PageSubtitle subtitle="Outreach & Services" />

  <SectionHead text="Outreach" />
  <div class="mb-4 flex gap-3 overflow-x-auto pb-1">
    {
      outreachImages.map((image) => (
        <Image src={image.src} alt={image.alt} class={imgClass} loading="lazy" />
      ))
    }
  </div>
  <ol class={`${panelClasses} divide-y divide-forest-900/10 dark:divide-forest-100/10`}>
    {
      outreach.map((o) => (
        <li class="py-3 first:pt-0 last:pb-0 sm:flex sm:items-baseline sm:justify-between sm:gap-6">
          <div class="min-w-0">
            <p class="font-semibold text-forest-950 dark:text-forest-50">{o.title}</p>
            <p class="text-sm text-slate-700 dark:text-slate-300">{o.organizer}</p>
          </div>
          <p class="mt-1 shrink-0 font-serif text-moss-800 dark:text-moss-200 sm:mt-0">
            {o.date}
          </p>
        </li>
      ))
    }
  </ol>

  <SectionHead text="In the Media" />
  <div class="mb-4 flex gap-3 overflow-x-auto pb-1">
    <Image
      src={kompasHogNosedRat}
      alt="Heru Handika interview in Kompas.com about Hog-nosed Rat discovery"
      class={imgClass}
      loading="lazy"
    />
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    {
      mediaGroups.map((group) => (
        <section class={panelClasses}>
          <h3 class="font-semibold text-moss-800 dark:text-moss-200">
            {group.title}
          </h3>
          <ul class="mt-3 divide-y divide-forest-900/10 dark:divide-forest-100/10">
            {group.items.map((m) => (
              <li class="py-3 first:pt-0 last:pb-0">
                <p class="text-sm text-forest-700 dark:text-forest-300">
                  {m.publisher} · {m.date}
                </p>
                {m.title && (
                  <p class="mt-0.5 font-semibold text-forest-950 dark:text-forest-50">
                    <i>{m.title}</i>
                  </p>
                )}
                {m.translation && (
                  <p class="text-sm text-slate-700 dark:text-slate-300">
                    {m.translation}
                  </p>
                )}
                {(m.url || m.pdfUrl) && (
                  <div class="mt-2 flex flex-wrap gap-2">
                    {m.url && (
                      <a href={m.url} target="_blank" rel="noopener" class={linkClasses}>
                        Read online
                      </a>
                    )}
                    {m.pdfUrl && (
                      <a href={m.pdfUrl} target="_blank" rel="noopener" class={linkClasses}>
                        PDF
                      </a>
                    )}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <SectionHead text="Popular Articles" />
  <ol class={`${panelClasses} divide-y divide-forest-900/10 dark:divide-forest-100/10`}>
    {
      articles.map((a) => (
        <li class="py-3 first:pt-0 last:pb-0 sm:flex sm:items-start sm:justify-between sm:gap-6">
          <div class="min-w-0">
            <p class="font-semibold text-forest-950 dark:text-forest-50">
              <i>{a.title}</i>
            </p>
            <p class="text-sm text-slate-700 dark:text-slate-300">
              {a.translation}
            </p>
            <p class="mt-0.5 text-sm text-forest-700 dark:text-forest-300">
              {a.publisher} · {a.date}
            </p>
          </div>
          <div class="mt-2 flex shrink-0 flex-wrap gap-2 sm:mt-0">
            {a.url && (
              <a href={a.url} target="_blank" rel="noopener" class={linkClasses}>
                Read online
              </a>
            )}
            {a.pdfUrl && (
              <a href={a.pdfUrl} target="_blank" rel="noopener" class={linkClasses}>
                PDF
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <SectionHead text="Memberships & Service" />
  <div class="grid gap-4 md:grid-cols-2">
    {
      memberships.map((m) => (
        <section class={panelClasses}>
          <h3 class="font-semibold text-forest-950 dark:text-forest-50">
            {m.organization}
          </h3>
          <p class="font-serif text-moss-800 dark:text-moss-200">
            {m.period}
          </p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-700 marker:text-forest-400 dark:text-slate-300">
            {m.roles.map((role) => (
              <li>{role}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>
