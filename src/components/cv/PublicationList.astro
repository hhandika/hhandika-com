---
import Publication from "../../layouts/Publication.astro";
import PublicationEntry from "../pubs/PublicationEntry.astro";
import Background from "../../components/Background.astro";
import publicationsBg from "../../assets/graphics/backgrounds/publications.svg";
import PageSubtitle from "../PageSubtitle.astro";
import { cvSections } from "../../lib/publications";
import myCv from "../../assets/docs/hhandika-cv.pdf";

const sections = await cvSections();
---

<div>
  <Background backgroundImage={publicationsBg} />
  <PageSubtitle subtitle="Publications" />
  {
    sections.map(({ heading, pubs }) => (
      <Publication year={heading}>
        {pubs.map((pub) => <PublicationEntry pub={pub} />)}
      </Publication>
    ))
  }
  <div class="mt-12 flex justify-center">
    <a
      href={myCv}
      download="hhandika-cv.pdf"
      class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-5 py-3 font-semibold text-forest-50 shadow-lg transition hover:scale-105 hover:bg-forest-800"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M12 4v11"></path><path d="m7 10 5 5 5-5"></path><path
          d="M5 20h14"></path></svg
      >
      Download full CV (PDF)
    </a>
  </div>
</div>
