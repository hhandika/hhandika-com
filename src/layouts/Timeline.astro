---
import cntl from "cntl";

const lineClasses = cntl`
  relative
  mt-6
  space-y-8
  before:absolute
  before:left-5
  before:top-2
  before:bottom-0
  before:w-0.5
  before:-translate-x-1/2
  before:bg-gradient-to-b
  before:from-sunrise-400
  before:via-moss-300
  before:to-transparent
  dark:before:from-sunrise-300
  dark:before:via-moss-700
`;
---

<div class={lineClasses}>
  <slot />
</div>
