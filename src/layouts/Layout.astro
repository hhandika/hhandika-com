---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="I study small mammal diversity and speciation on islands and develop efficient, scalable, and accessible software to advance biodiversity research."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme (or the system one) before first paint.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: dark)");
        const apply = (dark) =>
          document.documentElement.classList.toggle("dark", dark);
        apply(saved ? saved === "dark" : system.matches);
        system.addEventListener("change", (e) => {
          let current = null;
          try {
            current = localStorage.getItem("theme");
          } catch {}
          if (!current) apply(e.matches);
        });
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4SPVVHDKH7"
      is:inline></script>
    <script type="text/partytown" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-4SPVVHDKH7");
    </script>
  </head>
  <body class="bg-paper text-forest-950 dark:bg-soil dark:text-forest-50">
    <div class="relative isolate px-6 pt-14 lg:px-8">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
