---
import FieldworkIcon from "../components/svg/FieldworkIcon.astro";
import {
  countries,
  fieldworkKinds,
  formatSeason,
  type Expedition,
} from "../scripts/fieldwork";
import cntl from "cntl";

interface Props {
  expedition: Expedition;
}

const { expedition } = Astro.props;
const { kind } = expedition;

// Same palette as the field-site pins on the Indonesia map.
const kindStyles = {
  collecting: {
    icon: "bg-moss-400 text-moss-950",
    badge: "bg-moss-100 text-moss-900 dark:bg-moss-900/50 dark:text-moss-100",
  },
  limited: {
    icon: "bg-mist-300 text-mist-950",
    badge: "bg-mist-100 text-mist-900 dark:bg-mist-900/60 dark:text-mist-100",
  },
  survey: {
    icon: "bg-forest-200 text-forest-900",
    badge: "bg-forest-100 text-forest-900 dark:bg-forest-900/60 dark:text-forest-100",
  },
}[kind];

const iconClasses = cntl`
  absolute
  left-0
  top-2
  flex
  h-10
  w-10
  items-center
  justify-center
  rounded-full
  ring-4
  ring-white
  dark:ring-black
  ${kindStyles.icon}
`;

const cardClasses = cntl`
  rounded-2xl
  border
  border-forest-900/10
  bg-white
  px-5
  py-4
  transition
  hover:border-moss-400/60
  hover:shadow-sm
  dark:border-forest-100/10
  dark:bg-forest-950/60
  sm:flex
  sm:items-start
  sm:justify-between
  sm:gap-6
`;
---

<li class="relative pl-14" data-kind={kind}>
  <span class={iconClasses}>
    <FieldworkIcon name={kind} class="h-5 w-5" />
  </span>
  <div class={cardClasses}>
    <div>
      <h4 class="font-semibold text-forest-950 dark:text-forest-50">
        {expedition.title}
      </h4>
      <p class="text-sm text-slate-700 dark:text-slate-300">
        {expedition.region}, {expedition.country}
        <span aria-hidden="true">{countries[expedition.country]}</span>
      </p>
      {
        expedition.sites.length > 1 && (
          <p class="mt-1 text-xs text-forest-700 dark:text-forest-300">
            {expedition.sites.length} localities
          </p>
        )
      }
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2 sm:mt-0 sm:flex-col sm:items-end">
      <p class="font-serif text-moss-800 dark:text-moss-200">
        {formatSeason(expedition)}
      </p>
      <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${kindStyles.badge}`}>
        {fieldworkKinds[kind].label}
      </span>
    </div>
  </div>
</li>
