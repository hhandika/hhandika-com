---
import Layout from "../layouts/Layout.astro";
import PublicationList from "../components/cv/PublicationList.astro";
import TeachingPortfolio from "../components/cv/TeachingPortfolio.astro";
import OutreachAndServices from "../components/cv/OutreachAndServices.astro";
import MainPage from "../components/MainPage.astro";
import cntl from "cntl";
import PageTitle from "../components/PageTitle.astro";

const tabData = [
  {
    id: "publications",
    label: "Publications",
  },
  {
    id: "teaching",
    label: "Teaching",
  },
  {
    id: "outreach",
    label: "Outreach",
  },
];

const tabContainerClasses = cntl`
  border
  border-forest-200
  dark:border-forest-900
  gap-x-2
  divide-x
  divide-forest-200
  dark:divide-forest-900
  flex
  rounded-full
  items-center
  justify-center
  w-fit
  mx-auto
  mt-8
  p-1
  overflow-x-auto
  scrollbar-hide
`;

// Pressed state drives the styling, so the visual and announced state agree.
const tabButtonClasses = cntl`
  tab-button
  rounded-full
  px-4
  py-2
  text-sm
  font-normal
  text-moss-950
  transition-colors
  duration-300
  hover:bg-forest-300
  dark:text-moss-50
  dark:hover:bg-forest-800
  aria-pressed:bg-forest-600
  aria-pressed:font-semibold
  aria-pressed:text-white
  aria-pressed:hover:bg-forest-600
  dark:aria-pressed:bg-forest-300
  dark:aria-pressed:text-moss-950
  dark:aria-pressed:hover:bg-forest-300
`;
---

<Layout title="Curriculum Vitae">
  <MainPage
    ><PageTitle title="Curriculum Vitae" />
    <div class={tabContainerClasses} role="group" aria-label="CV section">
      {
        tabData.map(({ id, label }) => (
          <button
            type="button"
            class={tabButtonClasses}
            data-section={id}
            aria-controls={`${id}-section`}
            aria-pressed={id === "publications" ? "true" : "false"}
          >
            {label}
          </button>
        ))
      }
    </div>
    <div id="publications-section" class="">
      <PublicationList />
    </div>
    <div id="teaching-section" class="hidden">
      <TeachingPortfolio />
    </div>
    <div id="outreach-section" class="hidden">
      <OutreachAndServices />
    </div>
  </MainPage>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-button");

  const showSection = (section: string) => {
    buttons.forEach((btn) => {
      const active = btn.dataset.section === section;
      btn.setAttribute("aria-pressed", String(active));
      document.getElementById(`${btn.dataset.section}-section`)?.classList.toggle("hidden", !active);
    });
  };

  buttons.forEach((button) =>
    button.addEventListener("click", () => showSection(button.dataset.section!)),
  );
</script>
