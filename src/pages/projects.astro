---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import researchIcon from "../assets/icons/research.svg";
import Background from "../components/Background.astro";
import MainPage from "../components/MainPage.astro";
import PageDescription from "../components/PageDescription.astro";
import cntl from "cntl";
import Speciation from "../components/projects/Speciation.astro";
import Software from "../components/projects/Software.astro";
import Others from "../components/projects/Others.astro";

const tabData = [
  { id: "speciation", label: "Island speciation" },
  { id: "software", label: "Software & AI" },
  { id: "others", label: "Other projects" },
];

const tabContainerClasses = cntl`
  border
  border-forest-200
  dark:border-forest-900
  p-1
  gap-x-2
  divide-x
  divide-forest-200
  dark:divide-forest-900
  flex
  rounded-full
  items-center
  justify-start
  sm:justify-center
  max-w-full
  w-fit
  mx-auto
  mt-8
  overflow-x-auto
  scrollbar-hide
`;

const activeClass = cntl`
  bg-forest-600
  dark:bg-forest-300
  text-white
  dark:text-moss-950
  font-semibold
`;

const inactiveClass = cntl`
  text-moss-950
  dark:text-moss-50
  hover:bg-forest-300
  dark:hover:bg-forest-800
  font-normal
`;
---

<Layout title="Research Projects">
  <MainPage>
    <Background backgroundImage={researchIcon} />
    <PageTitle title="Research Projects">
      <PageDescription>
        How does geographic isolation shape genomic divergence, ecological
        interactions, and phenotypic evolution? I integrate fieldwork, natural
        history collections, genomics, AI, and open-source software to find
        out.
      </PageDescription>
    </PageTitle>
    <div class={tabContainerClasses} role="tablist" aria-label="Research areas">
      {
        tabData.map((tab) => (
          <button
            class={`tab-button whitespace-nowrap px-4 py-2 rounded-full transition-colors duration-300 ${inactiveClass} ${tab.id === "speciation" ? activeClass : ""}`}
            data-section={tab.id}
            role="tab"
            aria-controls={`${tab.id}-section`}
            aria-selected={tab.id === "speciation" ? "true" : "false"}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    <div id="speciation-section" class="mt-8">
      <Speciation />
    </div>
    <div id="software-section" class="mt-8 hidden">
      <Software />
    </div>
    <div id="others-section" class="mt-8 hidden">
      <Others />
    </div>
  </MainPage>

  <script>
    const activeTokens = [
      "bg-forest-600",
      "dark:bg-forest-300",
      "text-white",
      "dark:text-moss-950",
      "font-semibold",
    ];
    const inactiveTokens = [
      "text-moss-950",
      "dark:text-moss-50",
      "hover:bg-forest-300",
      "dark:hover:bg-forest-800",
      "font-normal",
    ];

    function showSection(section: string) {
      document
        .querySelectorAll<HTMLElement>("[id$='-section']")
        .forEach((el) => el.classList.toggle("hidden", el.id !== `${section}-section`));

      document.querySelectorAll<HTMLElement>(".tab-button").forEach((btn) => {
        const active = btn.dataset.section === section;
        btn.classList.remove(...(active ? inactiveTokens : activeTokens));
        btn.classList.add(...(active ? activeTokens : inactiveTokens));
        btn.setAttribute("aria-selected", String(active));
      });
    }

    const tabIds = [...document.querySelectorAll<HTMLElement>(".tab-button")].map(
      (b) => b.dataset.section!,
    );
    document.querySelectorAll<HTMLElement>(".tab-button").forEach((btn) =>
      btn.addEventListener("click", () => {
        showSection(btn.dataset.section!);
        history.replaceState(null, "", `#${btn.dataset.section}`);
      }),
    );

    // Deep links like /projects#phenomics open that tab.
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (tabIds.includes(id)) showSection(id);
    };
    addEventListener("hashchange", fromHash);
    fromHash();
  </script>
</Layout>
