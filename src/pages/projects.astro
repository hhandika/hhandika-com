---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import Background from "../components/Background.astro";
import researchBg from "../assets/graphics/backgrounds/research.svg";
import MainPage from "../components/MainPage.astro";
import PageDescription from "../components/PageDescription.astro";
import cntl from "cntl";
import Speciation from "../components/projects/Speciation.astro";
import AI from "../components/projects/AI.astro";
import Software from "../components/projects/Software.astro";
import Others from "../components/projects/Others.astro";

const tabData = [
  { id: "speciation", label: "Speciation" },
  { id: "ai", label: "AI" },
  { id: "software", label: "Software" },
];

// Other projects are tabs on larger screens and a hamburger menu on phones.
const otherProjects = [
  { id: "others", label: "Other projects" },
];

const tabContainerClasses = cntl`
  border
  border-forest-200
  dark:border-forest-900
  p-1
  gap-x-2
  divide-x
  divide-forest-200
  dark:divide-forest-900
  flex
  rounded-full
  items-center
  max-w-full
  w-fit
  mx-auto
  mt-8
  text-sm
`;

const activeClass = cntl`
  bg-forest-600
  dark:bg-forest-300
  text-white
  dark:text-moss-950
  font-semibold
`;

const inactiveClass = cntl`
  text-moss-950
  dark:text-moss-50
  hover:bg-forest-300
  dark:hover:bg-forest-800
  font-normal
`;
---

<Layout title="Research Projects">
  <MainPage>
    <Background backgroundImage={researchBg} />
    <PageTitle title="Research Projects">
      <PageDescription>
        How does geographic isolation shape genomic divergence, ecological
        interactions, and phenotypic evolution? I integrate fieldwork, natural
        history collections, genomics, AI, and open-source software to find
        out.
      </PageDescription>
    </PageTitle>
    <div class={tabContainerClasses}>
      <div class="flex items-center gap-x-2 divide-x divide-forest-200 dark:divide-forest-900" role="tablist" aria-label="Research areas">
        {
          tabData.map((tab) => (
            <button
              class={`tab-button whitespace-nowrap px-4 py-2 rounded-full transition-colors duration-300 ${inactiveClass} ${tab.id === "speciation" ? activeClass : ""}`}
              data-section={tab.id}
              role="tab"
              aria-controls={`${tab.id}-section`}
              aria-selected={tab.id === "speciation" ? "true" : "false"}
            >
              {tab.label}
            </button>
          ))
        }
        {
          otherProjects.map((tab) => (
            <button
              class={`tab-button hidden whitespace-nowrap px-4 py-2 sm:inline-block rounded-full transition-colors duration-300 ${inactiveClass}`}
              data-section={tab.id}
              role="tab"
              aria-controls={`${tab.id}-section`}
              aria-selected="false"
            >
              {tab.label}
            </button>
          ))
        }
      </div>
      <div class="relative pl-2 sm:hidden">
        <button
          id="other-projects-button"
          type="button"
          class={`flex items-center rounded-full p-2 transition-colors duration-300 ${inactiveClass}`}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="other-projects-menu"
          title="Other projects"
        >
          <span class="sr-only">Other projects</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
        <ul
          id="other-projects-menu"
          class="absolute right-0 top-full z-20 mt-2 hidden w-64 max-w-[calc(100vw-2rem)] rounded-2xl border border-forest-200 bg-white p-1 shadow-lg dark:border-forest-900 dark:bg-forest-950"
        >
          <li class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-widest text-forest-700 dark:text-forest-300" aria-hidden="true">
            Other projects
          </li>
          {
            otherProjects.map((p) => (
              <li>
                <button
                  type="button"
                  class="other-project w-full rounded-xl px-3 py-2 text-left text-moss-950 transition-colors hover:bg-forest-100 aria-[current=true]:bg-forest-600 aria-[current=true]:font-semibold aria-[current=true]:text-white dark:text-moss-50 dark:hover:bg-forest-800 dark:aria-[current=true]:bg-forest-300 dark:aria-[current=true]:text-moss-950"
                  data-section={p.id}
                  aria-current="false"
                >
                  {p.label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="speciation-section" class="project-panel mt-8">
      <Speciation />
    </div>
    <div id="ai-section" class="project-panel mt-8 hidden">
      <AI />
    </div>
    <div id="software-section" class="project-panel mt-8 hidden">
      <Software />
    </div>
    <div id="others-section" class="project-panel mt-8 hidden">
      <Others />
    </div>
  </MainPage>

  <script>
    const activeTokens = [
      "bg-forest-600",
      "dark:bg-forest-300",
      "text-white",
      "dark:text-moss-950",
      "font-semibold",
    ];
    const inactiveTokens = [
      "text-moss-950",
      "dark:text-moss-50",
      "hover:bg-forest-300",
      "dark:hover:bg-forest-800",
      "font-normal",
    ];

    const menuButton = document.getElementById("other-projects-button")!;
    const menu = document.getElementById("other-projects-menu")!;
    const tabs = [...document.querySelectorAll<HTMLElement>(".tab-button")];
    const menuItems = [...document.querySelectorAll<HTMLElement>(".other-project")];

    function setActive(el: HTMLElement, active: boolean) {
      el.classList.remove(...(active ? inactiveTokens : activeTokens));
      el.classList.add(...(active ? activeTokens : inactiveTokens));
    }

    function setMenuOpen(open: boolean) {
      menu.classList.toggle("hidden", !open);
      menuButton.setAttribute("aria-expanded", String(open));
    }

    function showSection(section: string) {
      document
        .querySelectorAll<HTMLElement>(".project-panel")
        .forEach((el) => el.classList.toggle("hidden", el.id !== `${section}-section`));

      tabs.forEach((btn) => {
        const active = btn.dataset.section === section;
        setActive(btn, active);
        btn.setAttribute("aria-selected", String(active));
      });
      menuItems.forEach((item) =>
        item.setAttribute("aria-current", String(item.dataset.section === section)),
      );
      setActive(menuButton, menuItems.some((item) => item.dataset.section === section));
    }

    const select = (section: string) => {
      showSection(section);
      setMenuOpen(false);
      history.replaceState(null, "", `#${section}`);
    };
    [...tabs, ...menuItems].forEach((btn) =>
      btn.addEventListener("click", () => select(btn.dataset.section!)),
    );

    menuButton.addEventListener("click", (e) => {
      e.stopPropagation();
      setMenuOpen(menu.classList.contains("hidden"));
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) setMenuOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        setMenuOpen(false);
        menuButton.focus();
      }
    });

    // Deep links like /projects#ai open that tab; old anchors still resolve.
    const aliases: Record<string, string> = { phenomics: "ai" };
    const sectionIds = tabs.map((b) => b.dataset.section!);
    const fromHash = () => {
      const hash = location.hash.slice(1);
      const id = aliases[hash] ?? hash;
      if (sectionIds.includes(id)) showSection(id);
    };
    addEventListener("hashchange", fromHash);
    fromHash();
  </script>
</Layout>
