---
import Layout from "../layouts/Layout.astro";
import profilePhoto from "../assets/img/profile.webp";
import lenomys from "../assets/img/lenomys-meyeri.jpg";
import lepiverseHome from "../assets/img/biocosmos/lepiverse-home.jpg";
import latimojongValley from "../assets/img/latimojong-valley.webp";
import nahpuDesktop from "../assets/img/nahpu/media-gallery.jpg";
import expeditionTeam from "../assets/img/leadership/expedition-team.jpg";
import fieldCampSelfie from "../assets/img/leadership/field-camp-selfie.jpg";
import fieldRidgeTeam from "../assets/img/leadership/field-ridge-team.jpg";
import labCodeReview from "../assets/img/leadership/lab-code-review.jpg";
import labMentoring from "../assets/img/leadership/lab-mentoring.jpg";
import cntl from "cntl";
import { Image } from "astro:assets";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import PillarIcon from "../components/svg/PillarIcon.astro";
import GithubProfileCard from "../components/github/GithubProfileCard.astro";
import LiveStat from "../components/github/LiveStat.astro";
import { expeditions, upcomingExpeditions } from "../scripts/fieldwork";

const keywordClasses = cntl`
  bg-forest-100
  dark:bg-forest-900/60
  text-forest-800
  dark:text-forest-200
  rounded-full
  py-1
  px-4
  text-sm
  font-semibold
`;

const keywordList = [
  { label: "Island speciation", href: "/projects#speciation" },
  { label: "Natural history collections", href: "/projects#others" },
  { label: "AI & biodiversity software", href: "/projects#ai" },
];

const primaryButtonClasses = cntl`
  inline-flex
  items-center
  gap-2
  rounded-xl
  bg-moss-500
  px-5
  py-3
  font-semibold
  text-forest-950
  shadow-lg
  transition
  hover:scale-105
  hover:bg-moss-400
  dark:bg-moss-400
  dark:text-forest-950
  dark:hover:bg-moss-300
`;

const secondaryButtonClasses = cntl`
  inline-flex
  items-center
  gap-2
  rounded-xl
  border-2
  border-forest-600
  px-5
  py-2.5
  font-semibold
  text-forest-800
  transition
  hover:bg-forest-50
  dark:border-forest-300
  dark:text-forest-100
  dark:hover:bg-forest-900
`;

const sectionTitleClasses = cntl`
  font-serif
  text-4xl
  text-forest-950
  dark:text-forest-50
`;

const iconClasses = cntl`
  h-10
  w-10
  shrink-0
  text-forest-600
  dark:text-forest-300
`;

const cardClasses = cntl`
  group
  flex
  flex-col
  overflow-hidden
  rounded-3xl
  border
  border-forest-900/10
  bg-white
  shadow-sm
  transition
  duration-300
  hover:-translate-y-1
  hover:shadow-xl
  dark:border-forest-100/10
  dark:bg-forest-950/60
`;

const highlights = [
  {
    eyebrow: "Island speciation",
    title: "An island of islands",
    text: "My main system is the <i>Bunomys</i> rats of Sulawesi, where paleo-islands, tectonic plate movements, and mountain formation drove an in situ radiation. Through collaborations, I also support work on island shrews and other rodents.",
    stat: "24+",
    statLabel: "mammal species described or revised with collaborators",
    note: "Received the 2023 Murie Family Conservation Award (ASM) for conserving mammals and their habitats",
    image: lenomys,
    alt: "Lenomys meyeri, an endemic rat of Sulawesi",
    href: "/projects#speciation",
    span: "lg:col-span-4",
  },
  {
    eyebrow: "AI phenomics",
    title: "Reading evolution from specimen images",
    text: "I use image embeddings to quantify coloration phenotypes from digitized specimens and test evolutionary hypotheses at scale.",
    stat: "619,739",
    statLabel: "specimen images across 9,342 species",
    image: lepiverseHome,
    alt: "Lepiverse, an AI-powered butterfly specimen explorer",
    href: "/projects#ai",
    span: "lg:col-span-2",
  },
  {
    eyebrow: "Fieldwork & collections",
    title: "15 years in remote mountains",
    text: "Collaborative expeditions across more than 20 mountain systems in Southeast Asia, building the specimen records and field experience that underly my research and software development.",
    stat: "8,000+",
    statLabel: "voucher specimens and 30,000+ specimen parts",
    image: latimojongValley,
    alt: "A valley in the Latimojong Mountains, Sulawesi",
    href: "/fieldwork",
    span: "lg:col-span-2",
  },
  {
    eyebrow: "Open software",
    title: "From phones to HPC clusters",
    text: "SEGUL, NAHPU, ULLAR, and the MDD app make genomic analysis and biodiversity data management efficient and accessible through user-friendly applications and command-line tools.",
    liveStat: "code_changes.totals.additions",
    statLabel: "lines of code added across public repositories",
    note: "SEGUL received the 2024 Ernst Mayr Award (SSB)",
    image: nahpuDesktop,
    alt: "NAHPU field catalog media gallery on desktop",
    href: "/software",
    span: "lg:col-span-4",
  },
];
const heroStats = [
  { value: String(expeditions.length), label: "field expeditions" },
  { value: "8,000+", label: "voucher specimens" },
  { value: "30,000+", label: "specimen parts" },
];

const approachSteps = [
  {
    icon: "island",
    title: "Fieldwork",
    tone: "bg-forest-600",
    text: "13 years of expeditions to more than 20 remote mountain systems in Southeast Asia, often their first modern biological surveys.",
  },
  {
    icon: "collections",
    title: "Collections",
    tone: "bg-moss-700",
    text: "More than 8,000 vouchers and 30,000 specimen parts in museums. That decade on complex islands shaped NAHPU, the digital field catalog our and other teams now use on recent expeditions.",
  },
  {
    icon: "phenomics",
    title: "Genomes & phenomes",
    tone: "bg-mist-600",
    text: "Phylogenomics and population genomics alongside AI image embeddings that measure complex traits across entire collections.",
    link: { text: "AI image embeddings", href: "/projects#ai" },
  },
  {
    icon: "software",
    title: "Software",
    tone: "bg-mist-800",
    text: "SEGUL, ULLAR, and apps that install in one click from the app stores or one command in the terminal, from phones to HPC clusters.",
  },
] as const;

const leadershipPhotos = [
  {
    src: expeditionTeam,
    alt: "Expedition team of collaborators, local community members, and students in the rainforest",
    span: "col-span-2 row-span-2",
  },
  { src: fieldRidgeTeam, alt: "Field team on a montane ridge trail", span: "" },
  {
    src: fieldCampSelfie,
    alt: "Heru with the field team building a camp shelter in the mist",
    span: "",
  },
  {
    src: labCodeReview,
    alt: "Heru and a student reviewing butterfly image analysis code",
    span: "",
  },
  {
    src: labMentoring,
    alt: "Heru walking students through code and results on a monitor",
    span: "",
  },
];

const researchQuestions = [
  {
    icon: "island",
    question:
      "How do paleo-islands, tectonic plate movements, and mountain formation drive speciation?",
    detail:
      "My genomic work on Sulawesi’s endemic <i>Bunomys</i> rodents, many of which are restricted to individual mountains, reveals in situ diversification but mixed support for the island’s classic areas of endemism. Next, I plan to test whether their parasites diversify with them or switch hosts, and how they shape infection down to the level of individual host cells.",
    href: "/projects#speciation",
  },
  {
    icon: "phenomics",
    question: "How do complex phenotypes evolve across species?",
    detail:
      "Using deep learning, I extract image embeddings from digitized butterfly specimens to map wing-pattern morphospace and identify known mimics among visually similar species, establishing a framework I aim to extend to study color evolution in island rodents.",
    href: "/projects#ai",
  },
  {
    icon: "software",
    question:
      "How can biodiversity data be collected and analyzed on any device, by anyone?",
    detail:
      "Free, open-source tools that run on anything from a phone to a computing cluster and install in one click or a single command, from NAHPU in the field to SEGUL for phylogenomic data, and beyond.",
    href: "/software",
  },
] as const;
---

<Layout title="Island speciation and efficient, scalable biodiversity software">
  <main class="mx-auto max-w-6xl">
    <section
      class="relative flex min-h-[calc(100svh-3.5rem)] flex-col justify-center py-10"
    >
      <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-14">
        <div class="text-center lg:text-left">
          <Image
            class="mx-auto block rounded-full lg:mx-0"
            src={profilePhoto}
            height={140}
            width={140}
            loading="eager"
            alt="Handika's profile"
          />
          <h1
            class="mt-4 font-serif text-5xl text-forest-950 dark:text-forest-50 sm:text-6xl"
          >
            Hi, I'm <strong class="text-moss-700 dark:text-moss-300"
              >Heru Handika</strong
            >
          </h1>
          <p
            class="mt-3 text-lg font-medium text-forest-800 dark:text-forest-200"
          >
            Postdoctoral Researcher · <a
              href="/projects#ai"
              class="underline decoration-moss-500/50 underline-offset-4 hover:decoration-moss-500"
              >AI Biodiversity Informatics</a
            >, Florida Museum of Natural History, University of Florida
          </p>
          <div
            class="mt-4 flex flex-wrap justify-center gap-2 sm:gap-3 lg:justify-start"
          >
            {
              keywordList.map((keyword) => (
                <a
                  href={keyword.href}
                  class={`${keywordClasses} transition hover:bg-forest-200 dark:hover:bg-forest-800`}
                >
                  {keyword.label}
                </a>
              ))
            }
          </div>
          <p
            class="mt-5 text-pretty text-lg text-slate-700 dark:text-slate-200 sm:text-xl/8"
          >
            You can call me Heru or Hez. I'm an evolutionary biologist working
            at the intersection of field biology, genomics, phenomics, on-device
            deep learning, and cross-platform software. I study how geographic
            isolation shapes genomic divergence, ecological interactions, and
            phenotypic evolution in island small mammals, and build open-source
            tools so these questions can be tested at scale.
          </p>
          <div class="lg:[&>div]:justify-start">
            <SocialMediaIcons />
          </div>
          <div
            class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start"
          >
            <a href="#highlights" class={primaryButtonClasses}>
              Research highlights
            </a>
            <a href="/software" class={secondaryButtonClasses}>Software</a>
          </div>
        </div>
        <div class="flex flex-col gap-4">
          <GithubProfileCard />
          <a
            href="/fieldwork"
            class="group block rounded-3xl border border-forest-900/10 bg-white/80 p-5 shadow-xl shadow-forest-900/5 backdrop-blur transition hover:border-moss-400/60 dark:border-forest-100/10 dark:bg-forest-950/60 sm:p-6"
          >
            <dl
              class="grid grid-cols-3 divide-x divide-forest-900/10 dark:divide-forest-100/10"
            >
              {
                heroStats.map((s) => (
                  <div class="flex flex-col px-3 first:pl-0 last:pr-0 sm:px-4">
                    <dt class="text-xs text-forest-700 dark:text-forest-300 sm:text-sm">
                      {s.label}
                    </dt>
                    <dd class="order-first text-xl font-semibold tabular-nums text-moss-800 dark:text-moss-200 sm:text-2xl">
                      {s.value}
                    </dd>
                  </div>
                ))
              }
            </dl>
            {
              upcomingExpeditions.map((e) => (
                <p class="mt-4 text-sm text-slate-700 dark:text-slate-300">
                  <span class="font-semibold text-moss-700 dark:text-moss-300">
                    Next:
                  </span>{" "}
                  {e.title}, {e.region}, {e.country} · {e.season}
                </p>
              ))
            }
            <span
              class="mt-3 block text-sm font-semibold text-forest-700 group-hover:underline dark:text-forest-300"
            >
              Explore my fieldwork →
            </span>
          </a>
        </div>
      </div>
      <a
        href="#highlights"
        class="absolute bottom-4 left-1/2 hidden -translate-x-1/2 animate-bounce text-forest-600 dark:text-forest-300 sm:block"
        aria-label="Scroll to research highlights"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-7 w-7"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
        >
      </a>
    </section>

    <section id="highlights" class="scroll-mt-16 py-16">
      <div class="text-center">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-moss-700 dark:text-moss-300"
        >
          Research highlights
        </p>
        <h2 class={sectionTitleClasses}>
          From Specimens to Scalable Biodiversity Science
        </h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-6">
        {
          highlights.map((h) => (
            <a href={h.href} class={`${cardClasses} ${h.span}`}>
              <div class="h-56 overflow-hidden bg-forest-100 dark:bg-forest-900 sm:h-64">
                <Image
                  src={h.image}
                  alt={h.alt}
                  width={900}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-moss-700 dark:text-moss-300">
                  {h.eyebrow}
                </p>
                <h3 class="mt-1 font-serif text-2xl text-forest-950 dark:text-forest-50">
                  {h.title}
                </h3>
                {/* Text may hold <i> for taxon names. */}
                <p
                  class="mt-2 text-pretty text-slate-700 dark:text-slate-300"
                  set:html={h.text}
                />
                <div class="mt-auto pt-5">
                  <p class="text-forest-950 dark:text-forest-50">
                    <strong class="text-3xl font-semibold tabular-nums">
                      {h.liveStat ? (
                        <LiveStat path={h.liveStat} format="compact" />
                      ) : (
                        h.stat
                      )}
                    </strong>{" "}
                    <span class="text-sm text-forest-700 dark:text-forest-300">
                      {h.statLabel}
                    </span>
                  </p>
                  {h.note && (
                    <p class="mt-1 text-sm text-moss-700 dark:text-moss-300">
                      {h.note}
                    </p>
                  )}
                  <span class="mt-3 inline-block text-sm font-semibold text-forest-700 group-hover:underline dark:text-forest-300">
                    Explore →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section id="leadership" class="scroll-mt-16 pb-24">
      <div
        class="grid items-center gap-8 rounded-3xl border border-forest-900/10 bg-white p-6 shadow-sm dark:border-forest-100/10 dark:bg-forest-950/60 sm:p-8 lg:grid-cols-[1fr_1.4fr]"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-widest text-moss-700 dark:text-moss-300"
          >
            Leadership &amp; mentoring
          </p>
          <h2 class={sectionTitleClasses}>On the trail and at the terminal</h2>
          <p
            class="mt-4 text-pretty text-lg text-slate-700 dark:text-slate-300"
          >
            I have been lucky to work alongside collaborators and local
            communities, and to mentor biology and computer science students.
            Together, we carry 800 kg of supplies on foot up a mountain on
            barely visible trails to reach places that have never been surveyed
            before, and make software work for everyone amid evolving hardware
            and operating systems.
          </p>
        </div>
        <div
          class="grid auto-rows-[7rem] grid-cols-4 gap-2 sm:auto-rows-[9rem]"
        >
          {
            leadershipPhotos.map((photo) => (
              <div
                class={`overflow-hidden rounded-2xl bg-forest-100 dark:bg-forest-900 ${photo.span}`}
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={900}
                  class="h-full w-full object-cover object-[center_25%]"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-moss-700 dark:text-moss-300"
        >
          My approach
        </p>
        <h2 class={sectionTitleClasses}>From the field to the phone</h2>
        <p class="mt-4 text-pretty text-lg text-slate-700 dark:text-slate-300">
          I work across the full spectrum of collection-based evolutionary
          biology, from surveying remote mountains across complex island systems
          and building specimen collections to generating genomic data and
          quantifying
          <a
            href="/projects#ai"
            class="underline decoration-moss-500/50 underline-offset-4 hover:decoration-moss-500"
            >phenotypic variation</a
          >. I also develop software that makes these workflows faster, more
          reproducible, and accessible across computing environments, from
          mobile devices to high-performance clusters.
        </p>
      </div>

      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          approachSteps.map((step, i) => (
            <li class={`relative rounded-3xl p-5 text-white ${step.tone}`}>
              <div class="flex items-center gap-3">
                <PillarIcon
                  name={step.icon}
                  class="h-10 w-10 shrink-0 text-white"
                />
                <span class="font-mono text-sm text-white">0{i + 1}</span>
              </div>
              <h3 class="mt-3 font-semibold">{step.title}</h3>
              <p class="mt-1 text-sm text-white">
                {"link" in step ? (
                  <Fragment>
                    {step.text.split(step.link.text)[0]}
                    <a
                      href={step.link.href}
                      class="underline decoration-white/60 underline-offset-2 hover:decoration-white"
                    >
                      {step.link.text}
                    </a>
                    {step.text.split(step.link.text)[1]}
                  </Fragment>
                ) : (
                  step.text
                )}
              </p>
            </li>
          ))
        }
      </ol>

      <h2
        class="mt-20 text-center text-2xl font-semibold text-forest-950 dark:text-forest-50"
      >
        Research questions
      </h2>
      <ul
        class="mx-auto mt-6 max-w-3xl divide-y divide-forest-900/10 dark:divide-forest-100/10"
      >
        {
          researchQuestions.map((q) => (
            <li>
              <a href={q.href} class="group flex items-start gap-4 py-5">
                <PillarIcon name={q.icon} class={`${iconClasses} mt-1`} />
                <span>
                  <span class="block text-xl text-moss-950 group-hover:underline dark:text-moss-50">
                    {q.question}
                  </span>
                  <span
                    class="mt-1 block text-slate-700 dark:text-slate-300"
                    set:html={q.detail}
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="text-center">
        <a href="/projects" class={`${primaryButtonClasses} mt-10`}>
          Explore my research
        </a>
      </div>
    </section>
  </main>
</Layout>
