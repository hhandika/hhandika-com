---
import Layout from "../layouts/Layout.astro";
import profilePhoto from "../assets/img/profile.webp";
import lenomys from "../assets/img/lenomys-meyeri.jpg";
import lepiverseHome from "../assets/img/biocosmos/lepiverse-home.jpg";
import latimojongValley from "../assets/img/latimojong-valley.webp";
import nahpuDesktop from "../assets/img/nahpu/media-gallery.jpg";
import cntl from "cntl";
import { Image } from "astro:assets";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import PillarIcon from "../components/svg/PillarIcon.astro";
import GithubProfileCard from "../components/github/GithubProfileCard.astro";
import LiveStat from "../components/github/LiveStat.astro";

const keywordClasses = cntl`
  border-2
  border-moss-300
  dark:border-moss-400
  text-moss-700
  dark:text-moss-300
  rounded-full
  py-1
  px-4
  text-sm
  font-semibold
`;

const keywordList = [
  "Island speciation",
  "Natural history collections",
  "AI & biodiversity software",
];

const primaryButtonClasses = cntl`
  inline-flex
  items-center
  gap-2
  rounded-xl
  bg-moss-600
  px-5
  py-3
  font-semibold
  text-moss-50
  shadow-lg
  transition
  hover:scale-105
  hover:bg-moss-800
`;

const secondaryButtonClasses = cntl`
  inline-flex
  items-center
  gap-2
  rounded-xl
  border-2
  border-moss-600
  px-5
  py-2.5
  font-semibold
  text-moss-800
  transition
  hover:bg-moss-50
  dark:border-moss-300
  dark:text-moss-100
  dark:hover:bg-moss-900
`;

const sectionTitleClasses = cntl`
  font-serif
  text-4xl
  text-moss-950
  dark:text-moss-50
`;

const iconClasses = cntl`
  h-10
  w-10
  shrink-0
  text-moss-600
  dark:text-moss-300
`;

const cardClasses = cntl`
  group
  flex
  flex-col
  overflow-hidden
  rounded-3xl
  border
  border-moss-900/10
  bg-white
  shadow-sm
  transition
  duration-300
  hover:-translate-y-1
  hover:shadow-xl
  dark:border-moss-100/10
  dark:bg-moss-950/60
`;

const highlights = [
  {
    eyebrow: "Island speciation",
    title: "An island of islands",
    text: "My main system is the Bunomys rats of Sulawesi, where paleo-islands, colliding tectonic plates, and young mountains drove an in situ radiation. Through collaborations, I also support work on island shrews.",
    stat: "24+",
    statLabel: "mammal species described or revised with collaborators",
    note: "Received the 2023 Murie Family Conservation Award (ASM) for conserving mammals and their habitats",
    image: lenomys,
    alt: "Lenomys meyeri, an endemic rat of Sulawesi",
    href: "/projects#speciation",
    span: "lg:col-span-4",
  },
  {
    eyebrow: "AI phenomics",
    title: "Reading evolution from specimen images",
    text: "With butterflies as a test case, image embeddings from digitized specimens quantify coloration, a complex trait shaped by ancestry, mimicry, and environment. I hope to extend the approach to island rodents.",
    stat: "619,739",
    statLabel: "specimen images across 9,342 species",
    image: lepiverseHome,
    alt: "Lepiverse, an AI-powered butterfly specimen explorer",
    href: "/projects#software",
    span: "lg:col-span-2",
  },
  {
    eyebrow: "Fieldwork & collections",
    title: "13 years in remote mountains",
    text: "Collaborative expeditions across more than 20 mountain systems in Southeast Asia, building the specimen record these questions rest on.",
    stat: "8,000+",
    statLabel: "voucher specimens and 30,000+ specimen parts",
    image: latimojongValley,
    alt: "A valley in the Latimojong Mountains, Sulawesi",
    href: "/fieldwork",
    span: "lg:col-span-2",
  },
  {
    eyebrow: "Open software",
    title: "From phones to HPC clusters",
    text: "SEGUL, NAHPU, ULLAR, and the MDD app bring cutting-edge phylogenomics and collection data to app stores and the command line alike.",
    liveStat: "code_changes.totals.additions",
    statLabel: "lines of code added across public repositories",
    image: nahpuDesktop,
    alt: "NAHPU field catalog media gallery on desktop",
    href: "/software",
    span: "lg:col-span-4",
  },
];
const approachSteps = [
  {
    icon: "island",
    title: "Fieldwork",
    text: "13 years of expeditions to more than 20 remote mountain systems in Southeast Asia, often their first modern biological surveys.",
  },
  {
    icon: "collections",
    title: "Collections",
    text: "More than 8,000 vouchers and 30,000 specimen parts in museums. That decade on complex islands shaped NAHPU, the digital field catalog our teams now use on recent expeditions.",
  },
  {
    icon: "phenomics",
    title: "Genomes & phenomes",
    text: "Phylogenomics and population genomics alongside AI image embeddings that measure complex traits across entire collections.",
  },
  {
    icon: "software",
    title: "Software",
    text: "SEGUL, ULLAR, and apps that install in one click from the app stores or one command in the terminal, from phones to HPC clusters.",
  },
] as const;

const researchQuestions = [
  {
    icon: "island",
    question:
      "How do paleo-islands, colliding plates, and young mountains drive speciation?",
    detail:
      "Testing in situ diversification in the Bunomys rodent clade on Sulawesi, where each summit acts as a sky island, and supporting collaborative work on shrews.",
    href: "/projects#speciation",
  },
  {
    icon: "phenomics",
    question:
      "Can AI measure how complex phenotypes like coloration evolve?",
    detail:
      "Using image embeddings from hundreds of thousands of specimens to separate ancestry, mimicry, and environment, with butterflies as a test case and the hope of extending to island rodents.",
    href: "/projects#software",
  },
  {
    icon: "software",
    question:
      "How can cutting-edge genomic analyses run on any device, for anyone?",
    detail:
      "Building memory-efficient, cross-platform tools so researchers with a laptop, or a phone, can work with phylogenomic-scale data.",
    href: "/software",
  },
] as const;
---

<Layout title="Island speciation and efficient, scalable biodiversity software">
  <main class="mx-auto max-w-6xl">
    <section
      class="relative flex min-h-[calc(100svh-3.5rem)] flex-col justify-center py-10"
    >
      <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-14">
        <div class="text-center lg:text-left">
          <Image
            class="mx-auto block rounded-full lg:mx-0"
            src={profilePhoto}
            height={140}
            width={140}
            loading="eager"
            alt="Handika's profile"
          />
          <h1
            class="mt-4 font-serif text-5xl text-moss-950 dark:text-moss-50 sm:text-6xl"
          >
            Hi, I'm <strong>Heru Handika</strong>
          </h1>
          <p
            class="mt-3 text-lg font-medium text-moss-800 dark:text-moss-200"
          >
            Postdoctoral Researcher · AI Biodiversity Informatics, Florida
            Museum of Natural History, University of Florida
          </p>
          <div
            class="mt-4 flex flex-wrap justify-center gap-2 sm:gap-3 lg:justify-start"
          >
            {keywordList.map((keyword) => <span class={keywordClasses}>{keyword}</span>)}
          </div>
          <p
            class="mt-5 text-pretty text-lg text-slate-700 dark:text-slate-200 sm:text-xl/8"
          >
            You can call me Heru or Hez. I'm an evolutionary biologist working
            at the intersection of field biology, genomics, phenomics,
            on-device deep learning, and software. I study how geographic
            isolation shapes genomic divergence, ecological interactions, and
            phenotypic evolution in island small mammals, and build open-source
            tools so these questions can be tested at scale.
          </p>
          <div class="lg:[&>div]:justify-start">
            <SocialMediaIcons />
          </div>
          <div
            class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start"
          >
            <a href="#highlights" class={primaryButtonClasses}>
              Research highlights
            </a>
            <a href="/software" class={secondaryButtonClasses}>Software</a>
          </div>
        </div>
        <GithubProfileCard />
      </div>
      <a
        href="#highlights"
        class="absolute bottom-4 left-1/2 hidden -translate-x-1/2 animate-bounce text-moss-600 dark:text-moss-300 sm:block"
        aria-label="Scroll to research highlights"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-7 w-7"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
        >
      </a>
    </section>

    <section id="highlights" class="scroll-mt-16 py-16">
      <div class="text-center">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-sunrise-600 dark:text-sunrise-400"
        >
          Research highlights
        </p>
        <h2 class={sectionTitleClasses}>
          From mountain summits to millions of pixels
        </h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-6">
        {
          highlights.map((h) => (
            <a href={h.href} class={`${cardClasses} ${h.span}`}>
              <div class="h-56 overflow-hidden bg-moss-100 dark:bg-moss-900 sm:h-64">
                <Image
                  src={h.image}
                  alt={h.alt}
                  width={900}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-sunrise-600 dark:text-sunrise-400">
                  {h.eyebrow}
                </p>
                <h3 class="mt-1 font-serif text-2xl text-moss-950 dark:text-moss-50">
                  {h.title}
                </h3>
                <p class="mt-2 text-pretty text-slate-700 dark:text-slate-300">
                  {h.text}
                </p>
                <div class="mt-auto pt-5">
                  <p class="text-moss-950 dark:text-moss-50">
                    <strong class="text-3xl font-semibold tabular-nums">
                      {h.liveStat ? (
                        <LiveStat path={h.liveStat} format="compact" />
                      ) : (
                        h.stat
                      )}
                    </strong>{" "}
                    <span class="text-sm text-moss-700 dark:text-moss-300">
                      {h.statLabel}
                    </span>
                  </p>
                  {h.note && (
                    <p class="mt-1 text-sm text-sunrise-700 dark:text-sunrise-300">
                      {h.note}
                    </p>
                  )}
                  <span class="mt-3 inline-block text-sm font-semibold text-moss-700 group-hover:underline dark:text-moss-300">
                    Explore →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-sunrise-600 dark:text-sunrise-400"
        >
          My approach
        </p>
        <h2 class={sectionTitleClasses}>From the field to the phone</h2>
        <p class="mt-4 text-pretty text-lg text-slate-700 dark:text-slate-300">
          I work across the whole pipeline of collection-based evolutionary
          biology: I survey remote island mountains, build the specimen record,
          generate genomes and AI-measured phenotypes from it, and write the
          software that makes those analyses fast, reproducible, and usable
          by anyone, on anything from a phone to a computing cluster.
        </p>
      </div>

      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          approachSteps.map((step, i) => (
            <li class="relative rounded-3xl border border-moss-900/10 bg-white p-5 dark:border-moss-100/10 dark:bg-moss-950/60">
              <div class="flex items-center gap-3">
                <PillarIcon name={step.icon} class={iconClasses} />
                <span class="font-mono text-sm text-sunrise-600 dark:text-sunrise-400">
                  0{i + 1}
                </span>
              </div>
              <h3 class="mt-3 font-semibold text-moss-950 dark:text-moss-50">
                {step.title}
              </h3>
              <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">
                {step.text}
              </p>
            </li>
          ))
        }
      </ol>

      <h2
        class="mt-20 text-center text-2xl font-semibold text-moss-950 dark:text-moss-50"
      >
        Research questions
      </h2>
      <ul class="mx-auto mt-6 max-w-3xl divide-y divide-moss-900/10 dark:divide-moss-100/10">
        {
          researchQuestions.map((q) => (
            <li>
              <a href={q.href} class="group flex items-start gap-4 py-5">
                <PillarIcon name={q.icon} class={`${iconClasses} mt-1`} />
                <span>
                  <span class="block text-xl text-sunrise-950 group-hover:underline dark:text-sunrise-50">
                    {q.question}
                  </span>
                  <span class="mt-1 block text-slate-700 dark:text-slate-300">{q.detail}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="text-center">
        <a href="/projects" class={`${primaryButtonClasses} mt-10`}>
          Explore my research
        </a>
      </div>
    </section>
  </main>
</Layout>
