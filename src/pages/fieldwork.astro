---
import PageTitle from "../components/PageTitle.astro";
import Layout from "../layouts/Layout.astro";
import Timeline from "../layouts/Timeline.astro";
import TimelineItem from "../layouts/TimelineItem.astro";
import Background from "../components/Background.astro";
import fieldworkBg from "../assets/graphics/backgrounds/fieldwork.svg";
import MainPage from "../components/MainPage.astro";
import PageDescription from "../components/PageDescription.astro";
import SectionHead from "../components/SectionHead.astro";
import FieldworkIcon from "../components/svg/FieldworkIcon.astro";
import {
  countries,
  expeditions,
  fieldworkKinds,
  localityCount,
  upcomingExpeditions,
  type FieldworkKind,
} from "../scripts/fieldwork";

const kinds = Object.keys(fieldworkKinds) as FieldworkKind[];
const countByKind = (kind: FieldworkKind) =>
  expeditions.filter((e) => e.kind === kind).length;

const years = [...new Set(expeditions.map((e) => e.start.slice(0, 4)))];
const firstYear = years[years.length - 1];
const lastYear = years[0];

const stats = [
  { value: expeditions.length, label: "expeditions" },
  { value: localityCount, label: "localities" },
  {
    value: new Set(expeditions.map((e) => e.country)).size,
    label: "countries",
  },
  {
    value: Number(lastYear) - Number(firstYear) + 1,
    label: `years in the field (${firstYear}–${lastYear})`,
  },
];

const museums = [
  {
    country: "Indonesia",
    flag: countries.Indonesia,
    names: ["Museum Zoologicum Bogoriense (MZB)"],
  },
  {
    country: "United States",
    flag: countries.USA,
    names: [
      "Museum of Vertebrate Zoology (MVZ)",
      "Field Museum of Natural History (FMNH)",
      "Louisiana State University Museum of Natural Science (LSUMS)",
      "KU Natural History Museum (KUMNH)",
    ],
  },
  {
    country: "Australia",
    flag: countries.Australia,
    names: ["Museums Victoria (NMV)"],
  },
];

const chipClasses =
  "inline-flex items-center gap-2 rounded-full border border-forest-900/15 px-3 py-1.5 text-sm text-forest-900 transition hover:border-moss-400 aria-pressed:border-moss-400 aria-pressed:bg-moss-100 aria-pressed:text-moss-950 dark:border-forest-100/15 dark:text-forest-100 dark:aria-pressed:bg-moss-900/50 dark:aria-pressed:text-moss-50";
---

<Layout title="Fieldwork">
  <MainPage>
    <Background backgroundImage={fieldworkBg} />
    <PageTitle title="Fieldwork">
      <PageDescription>
        Documenting the unknown through collaborative fieldwork and the growth
        of global natural history collections.
      </PageDescription>
    </PageTitle>

    <dl class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="rounded-3xl border border-forest-900/10 bg-white p-5 dark:border-forest-100/10 dark:bg-forest-950/60">
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="block text-3xl font-semibold tabular-nums text-forest-950 dark:text-forest-50">
                {s.value}
              </span>
              <span class="text-sm text-forest-700 dark:text-forest-300">
                {s.label}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>

    <section class="mx-auto mt-12 max-w-3xl">
      <SectionHead text="Field expedition timeline" />
      {
        upcomingExpeditions.length > 0 && (
          <ul class="mb-6 space-y-3">
            {upcomingExpeditions.map((e) => (
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border-2 border-dashed border-moss-400/70 bg-moss-50/60 px-5 py-4 dark:border-moss-300/50 dark:bg-moss-900/20">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-moss-700 dark:text-moss-300">
                    Upcoming
                  </p>
                  <h4 class="font-semibold text-forest-950 dark:text-forest-50">
                    {e.title}
                  </h4>
                  <p class="text-sm text-slate-700 dark:text-slate-300">
                    {e.region}, {e.country}{" "}
                    <span aria-hidden="true">{countries[e.country]}</span>
                  </p>
                </div>
                <p class="font-serif text-moss-800 dark:text-moss-200">
                  {e.season}
                </p>
              </li>
            ))}
          </ul>
        )
      }
      <div
        id="fieldwork-filter"
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Filter expeditions by kind"
      >
        <button type="button" class={chipClasses} data-filter="all" aria-pressed="true">
          All <span class="tabular-nums opacity-70">{expeditions.length}</span>
        </button>
        {
          kinds.map((kind) => (
            <button
              type="button"
              class={chipClasses}
              data-filter={kind}
              aria-pressed="false"
              title={fieldworkKinds[kind].description}
            >
              <FieldworkIcon name={kind} class="h-4 w-4" />
              {fieldworkKinds[kind].label}
              <span class="tabular-nums opacity-70">{countByKind(kind)}</span>
            </button>
          ))
        }
      </div>

      <Timeline>
        {
          years.map((year) => (
            <section data-year={year}>
              <h3 class="relative flex items-center gap-4 font-serif text-2xl text-moss-800 dark:text-moss-200">
                <span class="flex w-10 justify-center" aria-hidden="true">
                  <span class="h-3 w-3 rounded-full bg-moss-500 ring-4 ring-white dark:bg-moss-300 dark:ring-black" />
                </span>
                {year}
              </h3>
              <ol class="mt-3 space-y-3">
                {expeditions
                  .filter((e) => e.start.startsWith(year))
                  .map((e) => (
                    <TimelineItem expedition={e} />
                  ))}
              </ol>
            </section>
          ))
        }
      </Timeline>
    </section>

    <section class="mx-auto mt-16 max-w-3xl">
      <SectionHead text="Museums hosting specimens I collected" />
      <div class="grid gap-4 sm:grid-cols-3">
        {
          museums.map((m) => (
            <div class="rounded-3xl border border-forest-900/10 bg-white p-5 dark:border-forest-100/10 dark:bg-forest-950/60">
              <h3 class="font-semibold text-forest-800 dark:text-forest-100">
                {m.country}{" "}
                <span aria-hidden="true">{m.flag}</span>
              </h3>
              <ul class="mt-2 space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
                {m.names.map((name) => (
                  <li>{name}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <aside class="mx-auto mt-12 max-w-3xl rounded-3xl border border-moss-900/15 bg-moss-50/60 p-5 dark:border-moss-100/15 dark:bg-moss-900/20">
      <p class="text-xs font-semibold uppercase tracking-widest text-moss-700 dark:text-moss-300">
        Acknowledgement
      </p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">
        Exploration narratives too often center on the researchers, but
        fieldwork depends on local communities. In 2023, for example, I led a
        four-month expedition to three mountains on Sumatra that involved
        more than 40 local residents at each mountain. Without them, we could never
        have carried roughly 800 kilograms of field supplies and food up each
        mountain, and some of them collected specimens alongside us.
        Biodiversity research is a collaborative, global effort, and local
        communities are rightful stakeholders in discovery.
      </p>
    </aside>
  </MainPage>
</Layout>

<script>
  const filter = document.getElementById("fieldwork-filter")!;
  const buttons = filter.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-kind]");
  const years = document.querySelectorAll<HTMLElement>("[data-year]");

  filter.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-filter]",
    );
    if (!button) return;
    const kind = button.dataset.filter;
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b === button)),
    );
    items.forEach((item) => {
      item.hidden = kind !== "all" && item.dataset.kind !== kind;
    });
    years.forEach((year) => {
      year.hidden = !year.querySelector("[data-kind]:not([hidden])");
    });
  });
</script>
