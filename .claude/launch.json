{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "dev",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "astro-dev-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx astro dev --port ${PORT:-4330}"
      ],
      "port": 4330,
      "autoPort": true
    }
  ]
}